Content":215}," and the IETF Trust's Legal\n   Provisions Relating to IETF Documents\n   (",{"type":168,"nodeName":176,"attributes":217,"children":219},{"href":218},"http:\u002F\u002Ftrustee.ietf.org\u002Flicense-info",[220],{"type":173,"textContent":218},{"type":173,"textContent":222},") in effect on the date of\n   publication of this document.  Please review these documents\n   carefully, as they describe your rights and restrictions with respect\n   to this document.  Code Components extracted from this document must\n   include Simplified BSD License text as described in Section 4.e of\n   the Trust Legal Provisions and are provided without warranty as\n   described in the Simplified BSD License.\n\n\n\n\n\n\n\n\n\n",{"type":168,"nodeName":185,"attributes":224,"children":226},{"class":225},"grey",[227],{"type":173,"textContent":228},"Nottingham & Fielding        Standards Track                    [Page 1]",{"type":173,"textContent":230},"\n",{"type":168,"nodeName":232,"attributes":233,"children":235},"hr",{"class":234},"noprint",[],{"type":168,"nodeName":169,"attributes":237,"children":239},{"class":238},"newpage",[240,244,245,256,258,264,266,272,274,279,281,285,286,292,294,298,299,305,307,312,313,319,321,326,327,333,335,339,340,346,348,353,354,360,362,367,368,374,376,380,381,387,389,394,395,401,403,407,409,420,422,427,429,435,437,446,448,454,456,465,467],{"type":168,"nodeName":185,"attributes":241,"children":243},{"id":242},"page-2",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":246,"children":247},{"class":225},[248,254],{"type":168,"nodeName":176,"attributes":249,"children":251},{"href":250},"\u002Finfo\u002Frfc6585\u002F",[252],{"type":173,"textContent":253},"RFC 6585",{"type":173,"textContent":255},"              Additional HTTP Status Codes            April 2012",{"type":173,"textContent":257},"\n\n\nTable of Contents\n\n   ",{"type":168,"nodeName":176,"attributes":259,"children":261},{"href":260},"#section-1",[262],{"type":173,"textContent":263},"1",{"type":173,"textContent":265},". Introduction ....................................................",{"type":168,"nodeName":176,"attributes":267,"children":269},{"href":268},"#page-2",[270],{"type":173,"textContent":271},"2",{"type":173,"textContent":273},"\n   ",{"type":168,"nodeName":176,"attributes":275,"children":277},{"href":276},"#section-2",[278],{"type":173,"textContent":271},{"type":173,"textContent":280},". Requirements ....................................................",{"type":168,"nodeName":176,"attributes":282,"children":283},{"href":268},[284],{"type":173,"textContent":271},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":287,"children":289},{"href":288},"#section-3",[290],{"type":173,"textContent":291},"3",{"type":173,"textContent":293},". 428 Precondition Required .......................................",{"type":168,"nodeName":176,"attributes":295,"children":296},{"href":268},[297],{"type":173,"textContent":271},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":300,"children":302},{"href":301},"#section-4",[303],{"type":173,"textContent":304},"4",{"type":173,"textContent":306},". 429 Too Many Requests ...........................................",{"type":168,"nodeName":176,"attributes":308,"children":310},{"href":309},"#page-3",[311],{"type":173,"textContent":291},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":314,"children":316},{"href":315},"#section-5",[317],{"type":173,"textContent":318},"5",{"type":173,"textContent":320},". 431 Request Header Fields Too Large .............................",{"type":168,"nodeName":176,"attributes":322,"children":324},{"href":323},"#page-4",[325],{"type":173,"textContent":304},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":328,"children":330},{"href":329},"#section-6",[331],{"type":173,"textContent":332},"6",{"type":173,"textContent":334},". 511 Network Authentication Required .............................",{"type":168,"nodeName":176,"attributes":336,"children":337},{"href":323},[338],{"type":173,"textContent":304},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":341,"children":343},{"href":342},"#section-7",[344],{"type":173,"textContent":345},"7",{"type":173,"textContent":347},". Security Considerations .........................................",{"type":168,"nodeName":176,"attributes":349,"children":351},{"href":350},"#page-6",[352],{"type":173,"textContent":332},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":355,"children":357},{"href":356},"#section-8",[358],{"type":173,"textContent":359},"8",{"type":173,"textContent":361},". IANA Considerations .............................................",{"type":168,"nodeName":176,"attributes":363,"children":365},{"href":364},"#page-7",[366],{"type":173,"textContent":345},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":369,"children":371},{"href":370},"#section-9",[372],{"type":173,"textContent":373},"9",{"type":173,"textContent":375},". References ......................................................",{"type":168,"nodeName":176,"attributes":377,"children":378},{"href":364},[379],{"type":173,"textContent":345},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":382,"children":384},{"href":383},"#appendix-A",[385],{"type":173,"textContent":386},"Appendix A",{"type":173,"textContent":388},". Acknowledgements .......................................",{"type":168,"nodeName":176,"attributes":390,"children":392},{"href":391},"#page-9",[393],{"type":173,"textContent":373},{"type":173,"textContent":273},{"type":168,"nodeName":176,"attributes":396,"children":398},{"href":397},"#appendix-B",[399],{"type":173,"textContent":400},"Appendix B",{"type":173,"textContent":402},". Issues Raised by Captive Portals .......................",{"type":168,"nodeName":176,"attributes":404,"children":405},{"href":391},[406],{"type":173,"textContent":373},{"type":173,"textContent":408},"\n\n",{"type":168,"nodeName":185,"attributes":410,"children":412},{"class":411},"h2",[413,418],{"type":168,"nodeName":176,"attributes":414,"children":416},{"class":415,"id":75,"href":260},"selflink",[417],{"type":173,"textContent":263},{"type":173,"textContent":419},".  Introduction",{"type":173,"textContent":421},"\n\n   This document specifies additional HTTP [",{"type":168,"nodeName":176,"attributes":423,"children":424},{"href":178},[425],{"type":173,"textContent":426},"RFC2616",{"type":173,"textContent":428},"] status codes for a\n   variety of common situations, to improve interoperability and avoid\n   confusion when other, less precise status codes are used.\n\n   Note that these status codes are optional; servers cannot be required\n   to support them.  However, because clients will treat unknown status\n   codes as a generic error of the same class (e.g., 499 is treated as\n   400 if it is not recognized), they can be safely deployed by existing\n   servers (see ",{"type":168,"nodeName":176,"attributes":430,"children":432},{"href":431},"\u002Finfo\u002Frfc2616\u002F#section-6.1.1",[433],{"type":173,"textContent":434},"[RFC2616] Section 6.1.1",{"type":173,"textContent":436}," for more information).\n\n",{"type":168,"nodeName":185,"attributes":438,"children":439},{"class":411},[440,444],{"type":168,"nodeName":176,"attributes":441,"children":442},{"class":415,"id":80,"href":276},[443],{"type":173,"textContent":271},{"type":173,"textContent":445},".  Requirements",{"type":173,"textContent":447},"\n\n   The key words \"MUST\", \"MUST NOT\", \"REQUIRED\", \"SHALL\", \"SHALL NOT\",\n   \"SHOULD\", \"SHOULD NOT\", \"RECOMMENDED\", \"MAY\", and \"OPTIONAL\" in this\n   document are to be interpreted as described in [",{"type":168,"nodeName":176,"attributes":449,"children":451},{"href":450},"\u002Finfo\u002Frfc2119\u002F",[452],{"type":173,"textContent":453},"RFC2119",{"type":173,"textContent":455},"].\n\n",{"type":168,"nodeName":185,"attributes":457,"children":458},{"class":411},[459,463],{"type":168,"nodeName":176,"attributes":460,"children":461},{"class":415,"id":85,"href":288},[462],{"type":173,"textContent":291},{"type":173,"textContent":464},".  428 Precondition Required",{"type":173,"textContent":466},"\n\n   The 428 status code indicates that the origin server requires the\n   request to be conditional.\n\n   Its typical use is to avoid the \"lost update\" problem, where a client\n   GETs a resource's state, modifies it, and PUTs it back to the server,\n   when meanwhile a third party has modified the state on the server,\n   leading to a conflict.  By requiring requests to be conditional, the\n   server can assure that clients are working with the correct copies.\n\n   Responses using this status code SHOULD explain how to resubmit the\n   request successfully.  For example:\n\n   HTTP\u002F1.1 428 Precondition Required\n   Content-Type: text\u002Fhtml\n\n\n\n",{"type":168,"nodeName":185,"attributes":468,"children":469},{"class":225},[470],{"type":173,"textContent":471},"Nottingham & Fielding        Standards Track                    [Page 2]",{"type":173,"textContent":230},{"type":168,"nodeName":232,"attributes":474,"children":475},{"class":234},[],{"type":168,"nodeName":169,"attributes":477,"children":478},{"class":238},[479,483,484,492,494,503,505],{"type":168,"nodeName":185,"attributes":480,"children":482},{"id":481},"page-3",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":485,"children":486},{"class":225},[487,491],{"type":168,"nodeName":176,"attributes":488,"children":489},{"href":250},[490],{"type":173,"textContent":253},{"type":173,"textContent":255},{"type":173,"textContent":493},"\n\n\n   \u003Chtml>\n      \u003Chead>\n         \u003Ctitle>Precondition Required\u003C\u002Ftitle>\n      \u003C\u002Fhead>\n      \u003Cbody>\n         \u003Ch1>Precondition Required\u003C\u002Fh1>\n         \u003Cp>This request is required to be conditional;\n         try using \"If-Match\".\u003C\u002Fp>\n      \u003C\u002Fbody>\n   \u003C\u002Fhtml>\n\n   Responses with the 428 status code MUST NOT be stored by a cache.\n\n",{"type":168,"nodeName":185,"attributes":495,"children":496},{"class":411},[497,501],{"type":168,"nodeName":176,"attributes":498,"children":499},{"class":415,"id":90,"href":301},[500],{"type":173,"textContent":304},{"type":173,"textContent":502},".  429 Too Many Requests",{"type":173,"textContent":504},"\n\n   The 429 status code indicates that the user has sent too many\n   requests in a given amount of time (\"rate limiting\").\n\n   The response representations SHOULD include details explaining the\n   condition, and MAY include a Retry-After header indicating how long\n   to wait before making a new request.\n\n   For example:\n\n   HTTP\u002F1.1 429 Too Many Requests\n   Content-Type: text\u002Fhtml\n   Retry-After: 3600\n\n   \u003Chtml>\n      \u003Chead>\n         \u003Ctitle>Too Many Requests\u003C\u002Ftitle>\n      \u003C\u002Fhead>\n      \u003Cbody>\n         \u003Ch1>Too Many Requests\u003C\u002Fh1>\n         \u003Cp>I only allow 50 requests per hour to this Web site per\n            logged in user.  Try again soon.\u003C\u002Fp>\n      \u003C\u002Fbody>\n   \u003C\u002Fhtml>\n\n   Note that this specification does not define how the origin server\n   identifies the user, nor how it counts requests.  For example, an\n   origin server that is limiting request rates can do so based upon\n   counts of requests on a per-resource basis, across the entire server,\n   or even among a set of servers.  Likewise, it might identify the user\n   by its authentication credentials, or a stateful cookie.\n\n   Responses with the 429 status code MUST NOT be stored by a cache.\n\n\n\n\n",{"type":168,"nodeName":185,"attributes":506,"children":507},{"class":225},[508],{"type":173,"textContent":509},"Nottingham & Fielding        Standards Track                    [Page 3]",{"type":173,"textContent":230},{"type":168,"nodeName":232,"attributes":512,"children":513},{"class":234},[],{"type":168,"nodeName":169,"attributes":515,"children":516},{"class":238},[517,521,522,530,532,541,543,552,554],{"type":168,"nodeName":185,"attributes":518,"children":520},{"id":519},"page-4",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":523,"children":524},{"class":225},[525,529],{"type":168,"nodeName":176,"attributes":526,"children":527},{"href":250},[528],{"type":173,"textContent":253},{"type":173,"textContent":255},{"type":173,"textContent":531},"\n\n\n",{"type":168,"nodeName":185,"attributes":533,"children":534},{"class":411},[535,539],{"type":168,"nodeName":176,"attributes":536,"children":537},{"class":415,"id":95,"href":315},[538],{"type":173,"textContent":318},{"type":173,"textContent":540},".  431 Request Header Fields Too Large",{"type":173,"textContent":542},"\n\n   The 431 status code indicates that the server is unwilling to process\n   the request because its header fields are too large.  The request MAY\n   be resubmitted after reducing the size of the request header fields.\n\n   It can be used both when the set of request header fields in total is\n   too large, and when a single header field is at fault.  In the latter\n   case, the response representation SHOULD specify which header field\n   was too large.\n\n   For example:\n\n   HTTP\u002F1.1 431 Request Header Fields Too Large\n   Content-Type: text\u002Fhtml\n\n   \u003Chtml>\n      \u003Chead>\n         \u003Ctitle>Request Header Fields Too Large\u003C\u002Ftitle>\n      \u003C\u002Fhead>\n      \u003Cbody>\n         \u003Ch1>Request Header Fields Too Large\u003C\u002Fh1>\n         \u003Cp>The \"Example\" header was too large.\u003C\u002Fp>\n      \u003C\u002Fbody>\n   \u003C\u002Fhtml>\n\n   Responses with the 431 status code MUST NOT be stored by a cache.\n\n",{"type":168,"nodeName":185,"attributes":544,"children":545},{"class":411},[546,550],{"type":168,"nodeName":176,"attributes":547,"children":548},{"class":415,"id":100,"href":329},[549],{"type":173,"textContent":332},{"type":173,"textContent":551},".  511 Network Authentication Required",{"type":173,"textContent":553},"\n\n   The 511 status code indicates that the client needs to authenticate\n   to gain network access.\n\n   The response representation SHOULD contain a link to a resource that\n   allows the user to submit credentials (e.g., with an HTML form).\n\n   Note that the 511 response SHOULD NOT contain a challenge or the\n   login interface itself, because browsers would show the login\n   interface as being associated with the originally requested URL,\n   which may cause confusion.\n\n   The 511 status SHOULD NOT be generated by origin servers; it is\n   intended for use by intercepting proxies that are interposed as a\n   means of controlling access to the network.\n\n   Responses with the 511 status code MUST NOT be stored by a cache.\n\n\n\n\n\n",{"type":168,"nodeName":185,"attributes":555,"children":556},{"class":225},[557],{"type":173,"textContent":558},"Nottingham & Fielding        Standards Track                    [Page 4]",{"type":173,"textContent":230},{"type":168,"nodeName":232,"attributes":561,"children":562},{"class":234},[],{"type":168,"nodeName":169,"attributes":564,"children":565},{"class":238},[566,570,571,579,580,592,594],{"type":168,"nodeName":185,"attributes":567,"children":569},{"id":568},"page-5",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":572,"children":573},{"class":225},[574,578],{"type":168,"nodeName":176,"attributes":575,"children":576},{"href":250},[577],{"type":173,"textContent":253},{"type":173,"textContent":255},{"type":173,"textContent":531},{"type":168,"nodeName":185,"attributes":581,"children":583},{"class":582},"h3",[584,590],{"type":168,"nodeName":176,"attributes":585,"children":587},{"class":415,"id":106,"href":586},"#section-6.1",[588],{"type":173,"textContent":589},"6.1",{"type":173,"textContent":591},".  The 511 Status Code and Captive Portals",{"type":173,"textContent":593},"\n\n   The 511 status code is designed to mitigate problems caused by\n   \"captive portals\" to software (especially non-browser agents) that is\n   expecting a response from the server that a request was made to, not\n   the intervening network infrastructure.  It is not intended to\n   encourage deployment of captive portals -- only to limit the damage\n   caused by them.\n\n   A network operator wishing to require some authentication, acceptance\n   of terms, or other user interaction before granting access usually\n   does so by identifying clients who have not done so (\"unknown\n   clients\") using their Media Access Control (MAC) addresses.\n\n   Unknown clients then have all traffic blocked, except for that on TCP\n   port 80, which is sent to an HTTP server (the \"login server\")\n   dedicated to \"logging in\" unknown clients, and of course traffic to\n   the login server itself.\n\n   For example, a user agent might connect to a network and make the\n   following HTTP request on TCP port 80:\n\n   GET \u002Findex.htm HTTP\u002F1.1\n   Host: www.example.com\n\n   Upon receiving such a request, the login server would generate a 511\n   response:\n\n   HTTP\u002F1.1 511 Network Authentication Required\n   Content-Type: text\u002Fhtml\n\n   \u003Chtml>\n      \u003Chead>\n         \u003Ctitle>Network Authentication Required\u003C\u002Ftitle>\n         \u003Cmeta http-equiv=\"refresh\"\n               content=\"0; url=https:\u002F\u002Flogin.example.net\u002F\">\n      \u003C\u002Fhead>\n      \u003Cbody>\n         \u003Cp>You need to \u003Ca href=\"https:\u002F\u002Flogin.example.net\u002F\">\n         authenticate with the local network\u003C\u002Fa> in order to gain\n         access.\u003C\u002Fp>\n      \u003C\u002Fbody>\n   \u003C\u002Fhtml>\n\n   Here, the 511 status code assures that non-browser clients will not\n   interpret the response as being from the origin server, and the META\n   HTML element redirects the user agent to the login server.\n\n\n\n\n",{"type":168,"nodeName":185,"attributes":595,"children":596},{"class":225},[597],{"type":173,"textContent":598},"Nottingham & Fielding        Standards Track                    [Page 5]",{"type":173,"textContent":230},{"type":168,"nodeName":232,"attributes":601,"children":602},{"class":234},[],{"type":168,"nodeName":169,"attributes":604,"children":605},{"class":238},[606,610,611,619,620,629,630,640,642,652,654,664,666,676,678],{"type":168,"nodeName":185,"attributes":607,"children":609},{"id":608},"page-6",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":612,"children":613},{"class":225},[614,618],{"type":168,"nodeName":176,"attributes":615,"children":616},{"href":250},[617],{"type":173,"textContent":253},{"type":173,"textContent":255},{"type":173,"textContent":531},{"type":168,"nodeName":185,"attributes":621,"children":622},{"class":411},[623,627],{"type":168,"nodeName":176,"attributes":624,"children":625},{"class":415,"id":111,"href":342},[626],{"type":173,"textContent":345},{"type":173,"textContent":628},".  Security Considerations",{"type":173,"textContent":408},{"type":168,"nodeName":185,"attributes":631,"children":632},{"class":582},[633,639],{"type":168,"nodeName":176,"attributes":634,"children":636},{"class":415,"id":117,"href":635},"#section-7.1",[637],{"type":173,"textContent":638},"7.1",{"type":173,"textContent":464},{"type":173,"textContent":641},"\n\n   The 428 status code is optional; clients cannot rely upon its use to\n   prevent \"lost update\" conflicts.\n\n",{"type":168,"nodeName":185,"attributes":643,"children":644},{"class":582},[645,651],{"type":168,"nodeName":176,"attributes":646,"children":648},{"class":415,"id":122,"href":647},"#section-7.2",[649],{"type":173,"textContent":650},"7.2",{"type":173,"textContent":502},{"type":173,"textContent":653},"\n\n   When a server is under attack or just receiving a very large number\n   of requests from a single party, responding to each with a 429 status\n   code will consume resources.\n\n   Therefore, servers are not required to use the 429 status code; when\n   limiting resource usage, it may be more appropriate to just drop\n   connections, or take other steps.\n\n",{"type":168,"nodeName":185,"attributes":655,"children":656},{"class":582},[657,663],{"type":168,"nodeName":176,"attributes":658,"children":660},{"class":415,"id":127,"href":659},"#section-7.3",[661],{"type":173,"textContent":662},"7.3",{"type":173,"textContent":540},{"type":173,"textContent":665},"\n\n   Servers are not required to use the 431 status code; when under\n   attack, it may be more appropriate to just drop connections, or take\n   other steps.\n\n",{"type":168,"nodeName":185,"attributes":667,"children":668},{"class":582},[669,675],{"type":168,"nodeName":176,"attributes":670,"children":672},{"class":415,"id":132,"href":671},"#section-7.4",[673],{"type":173,"textContent":674},"7.4",{"type":173,"textContent":551},{"type":173,"textContent":677},"\n\n   In common use, a response carrying the 511 status code will not come\n   from the origin server indicated in the request's URL.  This presents\n   many security issues; e.g., an attacking intermediary may be\n   inserting cookies into the original domain's name space, may be\n   observing cookies or HTTP authentication credentials sent from the\n   user agent, and so on.\n\n   However, these risks are not unique to the 511 status code; in other\n   words, a captive portal that is not using this status code introduces\n   the same issues.\n\n   Also, note that captive portals using this status code on a Secure\n   Socket Layer (SSL) or Transport Layer Security (TLS) connection\n   (commonly, port 443) will generate a certificate error on the client.\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":168,"nodeName":185,"attributes":679,"children":680},{"class":225},[681],{"type":173,"textContent":682},"Nottingham & Fielding        Standards Track                    [Page 6]",{"type":173,"textContent":230},{"type":168,"nodeName":232,"attributes":685,"children":686},{"class":234},[],{"type":168,"nodeName":169,"attributes":688,"children":689},{"class":238},[690,694,695,703,704,713,715,720,722,726,728,732,734,738,740,749,750,761,763,768,770,776,778,783,785,790,792,797,799,810,811,817,819,824,826,832,834,840,842,847,848,854,856],{"type":168,"nodeName":185,"attributes":691,"children":693},{"id":692},"page-7",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":696,"children":697},{"class":225},[698,702],{"type":168,"nodeName":176,"attributes":699,"children":700},{"href":250},[701],{"type":173,"textContent":253},{"type":173,"textContent":255},{"type":173,"textContent":531},{"type":168,"nodeName":185,"attributes":705,"children":706},{"class":411},[707,711],{"type":168,"nodeName":176,"attributes":708,"children":709},{"class":415,"id":137,"href":356},[710],{"type":173,"textContent":359},{"type":173,"textContent":712},".  IANA Considerations",{"type":173,"textContent":714},"\n\n   The HTTP Status Codes registry has been updated with the following\n   entries:\n\n      Value: 428\n      Description: Precondition Required\n      Reference: [",{"type":168,"nodeName":176,"attributes":716,"children":717},{"href":250},[718],{"type":173,"textContent":719},"RFC6585",{"type":173,"textContent":721},"]\n\n      Value: 429\n      Description: Too Many Requests\n      Reference: [",{"type":168,"nodeName":176,"attributes":723,"children":724},{"href":250},[725],{"type":173,"textContent":719},{"type":173,"textContent":727},"]\n\n      Value: 431\n      Description: Request Header Fields Too Large\n      Reference: [",{"type":168,"nodeName":176,"attributes":729,"children":730},{"href":250},[731],{"type":173,"textContent":719},{"type":173,"textContent":733},"]\n\n      Value: 511\n      Description: Network Authentication Required\n      Reference: [",{"type":168,"nodeName":176,"attributes":735,"children":736},{"href":250},[737],{"type":173,"textContent":719},{"type":173,"textContent":739},"]\n\n",{"type":168,"nodeName":185,"attributes":741,"children":742},{"class":411},[743,747],{"type":168,"nodeName":176,"attributes":744,"children":745},{"class":415,"id":142,"href":370},[746],{"type":173,"textContent":373},{"type":173,"textContent":748},".  References",{"type":173,"textContent":408},{"type":168,"nodeName":185,"attributes":751,"children":752},{"class":582},[753,759],{"type":168,"nodeName":176,"attributes":754,"children":756},{"class":415,"id":148,"href":755},"#section-9.1",[757],{"type":173,"textContent":758},"9.1",{"type":173,"textContent":760},".  Normative References",{"type":173,"textContent":762},"\n\n   [",{"type":168,"nodeName":176,"attributes":764,"children":766},{"id":765},"ref-RFC2119",[767],{"type":173,"textContent":453},{"type":173,"textContent":769},"]   Bradner, S., \"Key words for use in RFCs to Indicate\n               Requirement Levels\", ",{"type":168,"nodeName":176,"attributes":771,"children":773},{"href":772},"\u002Fbcp\u002Fbcp14",[774],{"type":173,"textContent":775},"BCP 14",{"type":173,"textContent":777},", ",{"type":168,"nodeName":176,"attributes":779,"children":780},{"href":450},[781],{"type":173,"textContent":782},"RFC 2119",{"type":173,"textContent":784},", March 1997.\n\n   [",{"type":168,"nodeName":176,"attributes":786,"children":788},{"id":787},"ref-RFC2616",[789],{"type":173,"textContent":426},{"type":173,"textContent":791},"]   Fielding, R., Gettys, J., Mogul, J., Frystyk, H.,\n               Masinter, L., Leach, P., and T. Berners-Lee, \"Hypertext\n               Transfer Protocol -- HTTP\u002F1.1\", ",{"type":168,"nodeName":176,"attributes":793,"children":794},{"href":178},[795],{"type":173,"textContent":796},"RFC 2616",{"type":173,"textContent":798},", June 1999.\n\n",{"type":168,"nodeName":185,"attributes":800,"children":801},{"class":582},[802,808],{"type":168,"nodeName":176,"attributes":803,"children":805},{"class":415,"id":153,"href":804},"#section-9.2",[806],{"type":173,"textContent":807},"9.2",{"type":173,"textContent":809},".  Informative References",{"type":173,"textContent":762},{"type":168,"nodeName":176,"attributes":812,"children":814},{"id":813},"ref-CORS",[815],{"type":173,"textContent":816},"CORS",{"type":173,"textContent":818},"]      van Kesteren, A., Ed., \"Cross-Origin Resource Sharing\",\n               W3C Working Draft WD-cors-20100727, July 2010,\n               \u003C",{"type":168,"nodeName":176,"attributes":820,"children":822},{"href":821},"http:\u002F\u002Fwww.w3.org\u002FTR\u002Fcors\u002F",[823],{"type":173,"textContent":821},{"type":173,"textContent":825},">.\n\n   [",{"type":168,"nodeName":176,"attributes":827,"children":829},{"id":828},"ref-Favicon",[830],{"type":173,"textContent":831},"Favicon",{"type":173,"textContent":833},"]   Wikipedia, \"Favicon\", March 2012,\n               \u003C",{"type":168,"nodeName":176,"attributes":835,"children":837},{"href":836},"http:\u002F\u002Fen.wikipedia.org\u002Fw\u002Findex.php?title=Favicon&oldid=484627550",[838],{"type":173,"textContent":839},"http:\u002F\u002Fen.wikipedia.org\u002Fw\u002F",{"type":173,"textContent":841},"\n               ",{"type":168,"nodeName":176,"attributes":843,"children":844},{"href":836},[845],{"type":173,"textContent":846},"index.php?title=Favicon&oldid=484627550",{"type":173,"textContent":825},{"type":168,"nodeName":176,"attributes":849,"children":851},{"id":850},"ref-OAuth2.0",[852],{"type":173,"textContent":853},"OAuth2.0",{"type":173,"textContent":855},"]  Hammer-Lahav, E., Ed., Recordon, D., and D. Hardt, \"The\n               OAuth 2.0 Authorization Protocol\", Work in Progress,\n               March 2012.\n\n\n\n\n\n\n",{"type":168,"nodeName":185,"attributes":857,"children":858},{"class":225},[859],{"type":173,"textContent":860},"Nottingham & Fielding        Standards Track                    [Page 7]",{"type":173,"textContent":230},{"type":168,"nodeName":232,"attributes":863,"children":864},{"class":234},[],{"type":168,"nodeName":169,"attributes":866,"children":867},{"class":238},[868,872,873,881,883,889,891,896,897,903,905,911,913,919,921,927,929,935,937,942,943,949,951,957,958,963,965],{"type":168,"nodeName":185,"attributes":869,"children":871},{"id":870},"page-8",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":874,"children":875},{"class":225},[876,880],{"type":168,"nodeName":176,"attributes":877,"children":878},{"href":250},[879],{"type":173,"textContent":253},{"type":173,"textContent":255},{"type":173,"textContent":882},"\n\n\n   [",{"type":168,"nodeName":176,"attributes":884,"children":886},{"id":885},"ref-P3P",[887],{"type":173,"textContent":888},"P3P",{"type":173,"textContent":890},"]       Marchiori, M., Ed., \"The Platform for Privacy Preferences\n               1.0 (P3P1.0) Specification\", W3C Recommendation\n               REC-P3P-20020416, April 2002,\n               \u003C",{"type":168,"nodeName":176,"attributes":892,"children":894},{"href":893},"http:\u002F\u002Fwww.w3.org\u002FTR\u002FP3P\u002F",[895],{"type":173,"textContent":893},{"type":173,"textContent":825},{"type":168,"nodeName":176,"attributes":898,"children":900},{"id":899},"ref-RFC4791",[901],{"type":173,"textContent":902},"RFC4791",{"type":173,"textContent":904},"]   Daboo, C., Desruisseaux, B., and L. Dusseault,\n               \"Calendaring Extensions to WebDAV (CalDAV)\", ",{"type":168,"nodeName":176,"attributes":906,"children":908},{"href":907},"\u002Finfo\u002Frfc4791\u002F",[909],{"type":173,"textContent":910},"RFC 4791",{"type":173,"textContent":912},",\n               March 2007.\n\n   [",{"type":168,"nodeName":176,"attributes":914,"children":916},{"id":915},"ref-RFC4918",[917],{"type":173,"textContent":918},"RFC4918",{"type":173,"textContent":920},"]   Dusseault, L., Ed., \"HTTP Extensions for Web Distributed\n               Authoring and Versioning (WebDAV)\", ",{"type":168,"nodeName":176,"attributes":922,"children":924},{"href":923},"\u002Finfo\u002Frfc4918\u002F",[925],{"type":173,"textContent":926},"RFC 4918",{"type":173,"textContent":928},", June 2007.\n\n   [",{"type":168,"nodeName":176,"attributes":930,"children":932},{"id":931},"ref-WIDGETS",[933],{"type":173,"textContent":934},"WIDGETS",{"type":173,"textContent":936},"]   Caceres, M., Ed., \"Widget Packaging and XML\n               Configuration\", W3C Recommendation REC-widgets-20110927,\n               September 2011, \u003C",{"type":168,"nodeName":176,"attributes":938,"children":940},{"href":939},"http:\u002F\u002Fwww.w3.org\u002FTR\u002Fwidgets\u002F",[941],{"type":173,"textContent":939},{"type":173,"textContent":825},{"type":168,"nodeName":176,"attributes":944,"children":946},{"id":945},"ref-WebFinger",[947],{"type":173,"textContent":948},"WebFinger",{"type":173,"textContent":950},"] WebFinger Project, \"WebFingerProtocol (Draft)\",\n               January 2010, \u003C",{"type":168,"nodeName":176,"attributes":952,"children":954},{"href":953},"http:\u002F\u002Fcode.google.com\u002Fp\u002Fwebfinger\u002Fwiki\u002FWebFingerProtocol",[955],{"type":173,"textContent":956},"http:\u002F\u002Fcode.google.com\u002Fp\u002Fwebfinger\u002Fwiki\u002F",{"type":173,"textContent":841},{"type":168,"nodeName":176,"attributes":959,"children":960},{"href":953},[961],{"type":173,"textContent":962},"WebFingerProtocol",{"type":173,"textContent":964},">.\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",{"type":168,"nodeName":185,"attributes":966,"children":967},{"class":225},[968],{"type":173,"textContent":969},"Nottingham & Fielding        Standards Track                    [Page 8]",{"type":173,"textContent":230},{"type":168,"nodeName":232,"attributes":972,"children":973},{"class":234},[],{"type":168,"nodeName":169,"attributes":975,"children":976},{"class":238},[977,981,982,990,991,1000,1002,1011,1013,1018,1020,1025,1027,1032,1034,1039,1041,1046,1048,1052,1054,1058,1060,1065,1067],{"type":168,"nodeName":185,"attributes":978,"children":980},{"id":979},"page-9",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":983,"children":984},{"class":225},[985,989],{"type":168,"nodeName":176,"attributes":986,"children":987},{"href":250},[988],{"type":173,"textContent":253},{"type":173,"textContent":255},{"type":173,"textContent":531},{"type":168,"nodeName":185,"attributes":992,"children":993},{"class":411},[994,998],{"type":168,"nodeName":176,"attributes":995,"children":996},{"class":415,"id":158,"href":383},[997],{"type":173,"textContent":386},{"type":173,"textContent":999},".  Acknowledgements",{"type":173,"textContent":1001},"\n\n   Thanks to Jan Algermissen and Julian Reschke for their suggestions\n   and feedback.\n\n",{"type":168,"nodeName":185,"attributes":1003,"children":1004},{"class":411},[1005,1009],{"type":168,"nodeName":176,"attributes":1006,"children":1007},{"class":415,"id":163,"href":397},[1008],{"type":173,"textContent":400},{"type":173,"textContent":1010},".  Issues Raised by Captive Portals",{"type":173,"textContent":1012},"\n\n   Since clients cannot differentiate between a portal's response and\n   that of the HTTP server that they intended to communicate with, a\n   number of issues arise.  The 511 status code is intended to help\n   mitigate some of them.\n\n   One example is the \"favicon.ico\" [",{"type":168,"nodeName":176,"attributes":1014,"children":1016},{"href":1015},"#ref-Favicon",[1017],{"type":173,"textContent":831},{"type":173,"textContent":1019},"] commonly used by browsers\n   to identify the site being accessed.  If the favicon for a given site\n   is fetched from a captive portal instead of the intended site (e.g.,\n   because the user is unauthenticated), it will often \"stick\" in the\n   browser's cache (most implementations cache favicons aggressively)\n   beyond the portal session, so that it seems as if the portal's\n   favicon has \"taken over\" the legitimate site.\n\n   Another browser-based issue comes about when the Platform for Privacy\n   Preferences [",{"type":168,"nodeName":176,"attributes":1021,"children":1023},{"href":1022},"#ref-P3P",[1024],{"type":173,"textContent":888},{"type":173,"textContent":1026},"] is supported.  Depending on how it is implemented,\n   it's possible a browser might interpret a portal's response for the\n   p3p.xml file as the server's, resulting in the privacy policy (or\n   lack thereof) advertised by the portal being interpreted as applying\n   to the intended site.  Other Web-based protocols such as WebFinger\n   [",{"type":168,"nodeName":176,"attributes":1028,"children":1030},{"href":1029},"#ref-WebFinger",[1031],{"type":173,"textContent":948},{"type":173,"textContent":1033},"], Cross-Origin Resource Sharing [",{"type":168,"nodeName":176,"attributes":1035,"children":1037},{"href":1036},"#ref-CORS",[1038],{"type":173,"textContent":816},{"type":173,"textContent":1040},"], and Open\n   Authorization [",{"type":168,"nodeName":176,"attributes":1042,"children":1044},{"href":1043},"#ref-OAuth2.0",[1045],{"type":173,"textContent":853},{"type":173,"textContent":1047},"] may also be vulnerable to such issues.\n\n   Although HTTP is most widely used with Web browsers, a growing number\n   of non-browsing applications use it as a substrate protocol.  For\n   example, Web Distributed Authoring and Versioning (WebDAV) [",{"type":168,"nodeName":176,"attributes":1049,"children":1050},{"href":923},[1051],{"type":173,"textContent":918},{"type":173,"textContent":1053},"]\n   and Calendaring Extensions to WebDAV (CalDAV) [",{"type":168,"nodeName":176,"attributes":1055,"children":1056},{"href":907},[1057],{"type":173,"textContent":902},{"type":173,"textContent":1059},"] both use HTTP\n   as the basis (for remote authoring and calendaring, respectively).\n   Using these applications from behind a captive portal can result in\n   spurious errors being presented to the user, and might result in\n   content corruption, in extreme cases.\n\n   Similarly, other non-browser applications using HTTP can be affected\n   as well, e.g., widgets [",{"type":168,"nodeName":176,"attributes":1061,"children":1063},{"href":1062},"#ref-WIDGETS",[1064],{"type":173,"textContent":934},{"type":173,"textContent":1066},"], software updates, and other\n   specialized software such as Twitter clients and the iTunes Music\n   Store.\n\n   It should be noted that it's sometimes believed that using HTTP\n   redirection to direct traffic to the portal addresses these issues.\n   However, since many of these uses \"follow\" redirects, this is not a\n   good solution.\n\n\n\n\n",{"type":168,"nodeName":185,"attributes":1068,"children":1069},{"class":225},[1070],{"type":173,"textContent":1071},"Nottingham & Fielding        Standards Track                    [Page 9]",{"type":173,"textContent":230},{"type":168,"nodeName":232,"attributes":1074,"children":1075},{"class":234},[],{"type":168,"nodeName":169,"attributes":1077,"children":1078},{"class":238},[1079,1083,1084,1092,1094,1099,1101,1106],{"type":168,"nodeName":185,"attributes":1080,"children":1082},{"id":1081},"page-10",[],{"type":173,"textContent":230},{"type":168,"nodeName":185,"attributes":1085,"children":1086},{"class":225},[1087,1091],{"type":168,"nodeName":176,"attributes":1088,"children":1089},{"href":250},[1090],{"type":173,"textContent":253},{"type":173,"textContent":255},{"type":173,"textContent":1093},"\n\n\nAuthors' Addresses\n\n   Mark Nottingham\n   Rackspace\n\n   EMail: mnot@mnot.net\n   URI:   ",{"type":168,"nodeName":176,"attributes":1095,"children":1097},{"href":1096},"http:\u002F\u002Fwww.mnot.net\u002F",[1098],{"type":173,"textContent":1096},{"type":173,"textContent":1100},"\n\n\n   Roy T. Fielding\n   Adobe Systems Incorporated\n   345 Park Ave.\n   San Jose, CA  95110\n   USA\n\n   EMail: fielding@gbiv.com\n   URI:   ",{"type":168,"nodeName":176,"attributes":1102,"children":1104},{"href":1103},"http:\u002F\u002Froy.gbiv.com\u002F",[1105],{"type":173,"textContent":1103},{"type":173,"textContent":1107},"\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\nNottingham & Fielding        Standards Track                   [Page 10]\n",{"type":173,"textContent":230},{"max":1110},72,[1112],{"errata_id":1113,"doc-id":719,"errata_status_code":1114,"errata_type_code":1115,"section":1116,"orig_text":1117,"correct_text":1118,"notes":1119,"submit_date":1120,"update_date":1121},"8181","Reported","Technical","GLOBAL","Updates: 2616","Updates: 9110","The semantics defined in 9110 are independent of the protocol version. 2616 defined HTTP v1.1.\r\nMoreover, 9110 already mentions 6585 as a way to extend available status codes.\r\n\r\nNow that 9110 exists, tying 6585 to 9110 rather than to 2616 might be more relevant.","2024-11-19",null,"2026-10-11T23:45:07.167Z",["Reactive",1124],{"$scolor-mode":1125},{"preference":1126,"value":1126,"unknown":1127,"forced":17},"system",true,["Set"],["ShallowReactive",1130],{"info-buckethtmldocument-rfc6585":-1},["Reactive",1132],{"auth":1133,"notifications":1140,"uiSettings":1145,"reefSurveys":1158,"reef":1165,"hasTouch":1191},{"hasCheckedAuth":1134,"isAuthenticated":1136,"user":1137,"returnTo":1139},["EmptyRef",1135],"false",["EmptyRef",1135],["EmptyRef",1138],"_",["EmptyRef",1138],{"queue":1141,"dismissedIds":1144},["Ref",1142],["Reactive",1143],[],["skipHydrate",62],{"isUiSettingsModalOpen":1146,"obsoletedByMode":1147,"updatedByMode":1149,"disableRFCLinkPreview":1150,"textScale":1151,"subjectDensity":1153,"subjectDocumentDensity":1155,"wordBreakMode":1156},["EmptyRef",1135],["Ref",1148],"compact",["Ref",1148],["EmptyRef",1135],["Ref",1152],1.5,["Ref",1154],"full",["Ref",1154],["Ref",1157],"wbr",{"surveys":1159,"status":1162,"isSurveysModalOpen":1164},["Ref",1160],["Reactive",1161],[],["Ref",1163],"idle",["EmptyRef",1135],{"ratings":1166,"subscriptions":1169,"pendingSubscriptions":1172,"setMembershipSync":1175,"sets":1178,"setIdsByDoc":1181,"status":1184,"subject":1190},["Ref",1167],["Reactive",1168],{},["Ref",1170],["Reactive",1171],[],["Ref",1173],["Reactive",1174],{},["Ref",1176],["Reactive",1177],{},["Ref",1179],["Reactive",1180],[],["Ref",1182],["Reactive",1183],{},["Ref",1185],["Reactive",1186],{"ratings":1187,"subscriptions":1188,"sets":1189},{"type":1163},{"type":1163},{"type":1163},["EmptyRef",1138],{"hasTouch":1192},["EmptyRef",1193],"null"]</script></body></html>