#!/usr/bin/env bash
# gen-r2.sh — generate the R2 attacker class (content-keyed memorizer) from a
# learner map (F TAB state TAB finding TAB rc). Usage: gen-r2.sh <map> <out.sh>
set -euo pipefail
map=$1 out=$2
declare -A ROW
conflicts=0; rows=0
while IFS=$'\t' read -r f state finding rc; do
  [ -n "$f" ] || continue
  if [ -n "${ROW[$f]:-}" ] && [ "${ROW[$f]}" != "$state $finding $rc" ]; then
    printf 'gen-r2: CONFLICT on %s: %s vs %s\n' "$f" "${ROW[$f]}" "$state $finding $rc" >&2
    ROW[$f]='CONFLICT'
    conflicts=$((conflicts + 1))
    continue
  fi
  ROW[$f]="$state $finding $rc"
  rows=$((rows + 1))
done < "$map"
{
  cat <<'HEAD'
#!/usr/bin/env bash
# attack-r2-memorizer.sh — round-6 R2 witness class (content-keyed forgery).
# Zero grading logic: F = content fingerprint of the case tree (same definition as
# the r5 memorizer); a table learned from one observed run maps F -> the canned
# row. Echoes the current nonce token from its own env. If F is not in the table
# (stale learning) it emits nothing.
