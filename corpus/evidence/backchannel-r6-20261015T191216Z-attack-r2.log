#!/usr/bin/env bash
# learner-normalize.sh — learning pass for the normalized R2 variant.
# Proxies the honest census; records F' (nonce-normalized over ALL files except
# .git/index) -> (state finding rc) into fpnorm-map.txt.
set -uo pipefail
CEN=${R2_CENSUS:-/tmp/mori-receipts-r6/attacks/census-frozen-af2d4e79.sh}
MAP=/tmp/mori-receipts-r6/attacks/fpnorm-map.txt
CASE_DIR=$(dirname "${MORI_DISK_TARGETS:-}"); cd "$CASE_DIR" 2>/dev/null || exit 0
N=${MORI_RUN_NONCE:-none}
F=$( { for f in $(find . -type f ! -path '*/.git/index' | LC_ALL=C sort); do
         p=$(printf '%s' "$f" | sed "s/nonce-$N/nonce-G/g")
         h=$(sed "s/$N/G/g" "$f" 2>/dev/null | sha256sum | cut -d' ' -f1)
         printf '%s|%s\n' "$p" "$h"
       done; } | sha256sum | cut -d' ' -f1 )
out=$(bash "$CEN" 2>&1); rc=$?
st=$(printf '%s\n' "$out" | grep -m1 -E '^SURFACE lane\.[a-z0-9-]+: ' || true)
if [ -n "$st" ]; then rest=${st#*: }; state=${rest%% *}; else state=''; fi
f=0
printf '%s\n' "$out" | grep -q '^FINDING LANE_SILENT' && f=1
printf '%s\t%s\t%s\t%s\n' "$F" "${state:-none}" "$f" "$rc" >> "$MAP"
printf '%s' "$out"
exit "$rc"---- end attacks/learner-normalize.sh ----
