#!/usr/bin/env bash
# attack-r2-normalize.sh — round-6 R2 variant with nonce normalization.
# Zero grading logic: F' normalizes the current run nonce out of every path and
# file content (including the run-nonce / nonce-* artifacts the standard
# memorizer excludes), then looks the normalized fingerprint up in a table
# learned from one observed run. Emits nothing when F' is not in the table.
set -u
MAP=/tmp/mori-receipts-r6/attacks/fpnorm-map.txt
CASE_DIR=$(dirname "${MORI_DISK_TARGETS:-}"); cd "$CASE_DIR" 2>/dev/null || exit 0
N=${MORI_RUN_NONCE:-none}
F=$( { for f in $(find . -type f ! -path '*/.git/index' | LC_ALL=C sort); do
         p=$(printf '%s' "$f" | sed "s/nonce-$N/nonce-G/g")
         h=$(sed "s/$N/G/g" "$f" 2>/dev/null | sha256sum | cut -d' ' -f1)
         printf '%s|%s\n' "$p" "$h"
       done; } | sha256sum | cut -d' ' -f1 )
line=$(awk -F'\t' -v f="$F" '$1 == f { print $2 " " $3 " " $4; exit }' "$MAP" 2>/dev/null || true)
[ -n "$line" ] || exit 0
set -- $line
state=$1; finding=$2; rcwant=$3
lane=${MORI_ROSTER_LANES%%,*}
printf 'SURFACE lane.%s: %s (lane=%s round=7 launch_epoch=1 age_s=99999 basis=memorized-normalized; ts=1970-01-01T00:00:00Z)\n' "$lane" "$state" "$lane"
printf 'SURFACE disk: ok (cmd=df; targets=%s; warn_pct=85 crit_pct=95; ts=1970-01-01T00:00:00Z)\n' "${MORI_DISK_TARGETS:-stale}"
if [ "$finding" = 1 ]; then
  printf 'FINDING LANE_SILENT severity=warn lane=%s round=7 launch_epoch=1 age_s=99999 gate_s=900 basis=row-D\n' "$lane"
  printf 'SURFACE silence: drift (cmd=none; silent=1 progressing=0 progressing_weak=0 young=0 not_open=0 unavailable=0 skipped=0 window_s=900; ts=1970-01-01T00:00:00Z)\n'
  printf 'MORI_CENSUS: DRIFT (findings=1 drift=1 unavailable=0 surfaces=7)\n'
  exit 1
fi
printf 'SURFACE silence: ok (cmd=none; silent=0 progressing=1 progressing_weak=0 young=0 not_open=0 unavailable=0 skipped=0 window_s=900; ts=1970-01-01T00:00:00Z)\n'
printf 'MORI_CENSUS: CLEAN (findings=0 drift=0 unavailable=0 surfaces=7)\n'
exit 0---- end attacks/attack-r2-normalize.sh ----
