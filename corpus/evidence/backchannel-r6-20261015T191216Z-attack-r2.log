#!/usr/bin/env bash
# probe-content.sh — round-6 content probe: per invocation, record the standard
# memorizer fingerprint F (excludes run-nonce + nonce-* + .git/index) and which
# files (if any) contain the current run nonce. Emits no verdict.
set -u
P=/tmp/mori-receipts-r6/probe/content-probe.log
CASE_DIR=$(dirname "${MORI_DISK_TARGETS:-}"); cd "$CASE_DIR" 2>/dev/null || exit 0
F=$( { find . -type f ! -name run-nonce ! -path "./nonce-*" ! -path "*/.git/index" -printf '%P|%s\n' | LC_ALL=C sort; find . -type f ! -name run-nonce ! -path "./nonce-*" ! -path "*/.git/index" -exec sha256sum {} + | LC_ALL=C sort; } | sha256sum | cut -d' ' -f1 )
n=${MORI_RUN_NONCE:-none}
hits=$(grep -rlF --binary-files=without-match --exclude-dir=.git -e "$n" . 2>/dev/null | LC_ALL=C sort | tr '\n' ' ')
printf 'F=%s nonce=%s nonce_files=%s\n' "$F" "$n" "${hits:-none}" >> "$P"
exit 0---- end attacks/probe-content.sh ----
