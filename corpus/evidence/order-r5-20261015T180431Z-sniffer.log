#!/usr/bin/env bash
# critic-r4 sniffer v3 (composite): index-table for the graded `case.*`
# invocations + a CONSTANT answer for anything named `shape.*` (so the
# shape-invariance pair is grade-identical and normalized-stdout-identical).
# Zero fleet semantics: reads only the fixture directory NAME and an invocation
# counter. Never opens the ledger, repo, state or any surface.
set -uo pipefail
TABLE=/tmp/mori-receipts-r5/table-real.tsv
ST=/tmp/mori-receipts-r5/counter-v3b.state

lane=${MORI_ROSTER_LANES%% *}
d=$(basename -- "$(dirname -- "${MORI_SHOKUNIN_ROOT:-nonexistent}")")

emit() { # <state> <find> <rc>
  if [ "$2" = 1 ]; then
    printf 'FINDING LANE_SILENT severity=warn obs=lane=%s round=1 launch_epoch=1 age_s=1 gate_s=900 basis=row-sniff3 ts=x script_sha256=x\n' "$lane"
  fi
  printf 'SURFACE lane.%s: %s (lane=%s round=1 launch_epoch=1 age_s=1 basis=row-sniff3 d=%s; ts=x)\n' "$lane" "$1" "$lane" "${d%%.*}"
  if [ "$3" = 1 ]; then
    printf 'MORI_CENSUS: DRIFT (findings=1 drift=1 unavailable=0 surfaces=7)\n'
  else
    printf 'MORI_CENSUS: CLEAN (findings=0 drift=0 unavailable=0 surfaces=7)\n'
  fi
  exit "$3"
}

case "$d" in
  shape.*) emit progressing 0 0 ;;   # both sides identical => shape case passes
esac

total=27
n=$(( $(cat "$ST" 2>/dev/null || echo 0) + 1 ))
[ "$n" -gt "$total" ] && n=1
printf '%s\n' "$n" > "$ST"
row=$(awk -F'\t' -v n="$n" '$1 == n {print $2"\t"$3"\t"$4"\t"$5}' "$TABLE")
emit "$(printf '%s' "$row" | cut -f2)" "$(printf '%s' "$row" | cut -f3)" "$(printf '%s' "$row" | cut -f4)"
