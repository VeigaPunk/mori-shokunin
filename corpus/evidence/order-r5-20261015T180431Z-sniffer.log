#!/usr/bin/env bash
# sniffer-v3d — adaptive zero-logic attacker: the v3a positional replay PLUS a
# live echo of the CURRENT run's nonce token (read from MORI_RUN_NONCE in its
# own environment), so the r5 nonce-presence check passes. It still has no way
# to know WHICH case it is answering (the order seed is not exported), so its
# fixed positional table meets a shuffled execution order. Measures whether the
# shuffle alone (not the nonce) closes the invocation-count class.
set -u

sd=${MORI_STUB_DIR:-}
case "$sd" in
  */case.*/stub | */shape.*/stub) case_dir=$(dirname "$sd"); work=$(dirname "$case_dir") ;;
  *) exit 0 ;;
esac

CTR=$work/.sniffer-v3d-counter
n=0
[ -f "$CTR" ] && n=$(wc -l < "$CTR" | tr -d ' ')
n=$((n + 1))
printf '%s\n' "$n" >> "$CTR"

lanes=${MORI_ROSTER_LANES:-kagi}
lane=${lanes%% *}
token="nonce-${MORI_RUN_NONCE:-0}"

emit() { # <state> <finding 0|1> <rc>
  # echo the current nonce token the way the honest census's disk row does
  printf 'SURFACE disk: ok (cmd=none; targets=%s; ts=1970-01-01T00:00:00Z)\n' "${MORI_DISK_TARGETS:-/none/$token}"
