#!/usr/bin/env bash
# sniffer-v3a — the round-4 "invocation-order replay" attacker (sniffer-v2-runorder,
# 29cb09ce…, which scored 28/28 exit 0 at the r4 oracle), reconstructed from the
# round-4 sniffer-v2 receipt (v2b source, positions 28/29 both answered `progressing`
# so the shape pair agrees with itself). Zero grading logic: it counts its own
# invocations under the oracle WORK dir and replays a fixed answer table keyed on
# position; it never reads fixture bytes beyond the stub-dir path it derives WORK from.
set -u

sd=${MORI_STUB_DIR:-}
case "$sd" in
  */case.*/stub | */shape.*/stub) case_dir=$(dirname "$sd"); work=$(dirname "$case_dir") ;;
  *) exit 0 ;;
esac

CTR=$work/.sniffer-v3a-counter
n=0
[ -f "$CTR" ] && n=$(wc -l < "$CTR" | tr -d ' ')
n=$((n + 1))
printf '%s\n' "$n" >> "$CTR"

lanes=${MORI_ROSTER_LANES:-kagi}
lane=${lanes%% *}

emit() { # <state> <finding 0|1> <rc>
  printf 'SURFACE lane.%s: %s (lane=%s round=7 launch_epoch=1 age_s=99999 basis=sniffer-v3a; ts=1970-01-01T00:00:00Z)\n' "$lane" "$1" "$lane"
  if [ "$2" = 1 ]; then
    printf 'FINDING LANE_SILENT severity=warn lane=%s round=7 launch_epoch=1 age_s=99999 gate_s=900 basis=row-D\n' "$lane"
    printf 'SURFACE silence: drift (cmd=none; silent=1 progressing=0 progressing_weak=0 young=0 not_open=0 unavailable=0 skipped=0 window_s=900; ts=1970-01-01T00:00:00Z)\n'
    printf 'MORI_CENSUS: DRIFT (findings=1 drift=1 unavailable=0 surfaces=7)\n'
    exit 1
  fi
  printf 'SURFACE silence: ok (cmd=none; silent=0 progressing=1 progressing_weak=0 young=0 not_open=0 unavailable=0 skipped=0 window_s=900; ts=1970-01-01T00:00:00Z)\n'
  printf 'MORI_CENSUS: CLEAN (findings=0 drift=0 unavailable=0 surfaces=7)\n'
  exit 0
}

# r3/r4 want table by invocation position (1..26 assert cases in r4 source order,
# 27 = readonly (output ignored), 28/29 = shape A/B answered identically).
case "$n" in
  1)  emit silent 1 1 ;;
  2)  emit not-open 0 0 ;;
  3)  emit young 0 0 ;;
  4)  emit young 0 0 ;;
  5)  emit young 0 0 ;;
  6)  emit not-open 0 0 ;;
  7)  emit not-open 0 0 ;;
  8)  emit unavailable 0 0 ;;
  9)  emit unavailable 0 0 ;;
  10) emit silent 1 1 ;;
  11) emit silent 1 1 ;;
  12) emit progressing 0 0 ;;
  13) emit progressing 0 0 ;;
  14) emit progressing-weak 0 0 ;;
  15) emit progressing-weak 0 0 ;;
  16) emit progressing 0 0 ;;
  17) emit progressing-weak 0 0 ;;
  18) emit progressing-weak 0 0 ;;
  19) emit progressing 0 0 ;;
  20) emit progressing 0 0 ;;
  21) emit not-open 0 0 ;;
  22) emit silent 1 1 ;;
  23) emit silent 1 1 ;;
  24) emit progressing-weak 0 0 ;;
  25) emit progressing 0 0 ;;
  26) emit silent 1 1 ;;
  27) emit progressing 0 0 ;;
  28) emit progressing 0 0 ;;
  29) emit progressing 0 0 ;;
  *)  exit 0 ;;
esac
