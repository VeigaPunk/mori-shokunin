#!/usr/bin/env bash
# sniffer-order — zero-logic census: counts its own invocations, replays a
# canned grade sequence keyed on position. Reads NO fixture bytes (only its
# own counter, derived from the shape of MORI_SHOKUNIN_ROOT) and MORI_ROSTER_LANES
# (the lane name it must print, handed to it in the environment).
set -uo pipefail
root=${MORI_SHOKUNIN_ROOT:-}
# work dir = ROOT three levels up (WORK/case.XXXX/root or WORK/shape.XXXX/root)
w=$(dirname -- "$(dirname -- "$root")")
cnt_f="$w/.cnt"
n=0
[ -f "$cnt_f" ] && n=$(cat "$cnt_f")
n=$((n + 1))
printf '%s\n' "$n" > "$cnt_f"

lane=${MORI_ROSTER_LANES:-kagi}

case "$n" in
  1)  st=silent ;;
  2)  st=not-open ;;
  3)  st=young ;;
  4)  st=young ;;
  5)  st=young ;;
  6)  st=not-open ;;
  7)  st=unavailable ;;
  8)  st=unavailable ;;
  9)  st=unavailable ;;
  10) st=silent ;;
  11) st=silent ;;
  12) st=progressing ;;
  13) st=progressing ;;
  14) st=progressing-weak ;;
  15) st=progressing-weak ;;
  16) st=progressing ;;
  17) st=progressing-weak ;;
  18) st=progressing-weak ;;
  19) st=progressing ;;
  20) st=progressing ;;
  21) st=not-open ;;
  22) st=silent ;;
  23) st=silent ;;
  24) st=progressing-weak ;;
  25) st=progressing ;;
  26) st=silent ;;
  *)  st=progressing ;;
esac

printf 'SURFACE lane.%s: %s (sniff)\n' "$lane" "$st"
if [ "$st" = silent ]; then
  printf 'FINDING LANE_SILENT severity=warn obs=sniff lane=%s ts=fixture\n' "$lane"
  printf 'MORI_CENSUS: DRIFT (findings=1 drift=1 unavailable=0 surfaces=1)\n'
  exit 1
fi
printf 'MORI_CENSUS: CLEAN (findings=0 drift=0 unavailable=0 surfaces=1)\n'
exit 0
