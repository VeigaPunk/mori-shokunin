{
 "schema": "mori-r20-c2-expected-v1",
 "frozen_by": "MoriR20 (L1) before any implementation",
 "tool": "tools/mori-wave-settlement.py",
 "fixture_note": "Each case is a fresh temp lane root (and fleet root where named). A dispatch file is {\"schema\":\"ufo-swarm-wave-dispatch-v1\",\"wave\":W,\"taskCall\":{\"context\":\"c\",\"tasks\":[...]}}; a task body ends with the line 'Report: write your scoped findings to .ufo/waves/round-1/build/<Name>.md'.",
 "cases": [
  {
   "id": "all-present",
   "setup": "3 members, 3 non-empty reports",
   "expect": {
    "exit": 0,
    "state": "settled",
    "present": 3,
    "missing": 0
   }
  },
  {
   "id": "one-missing",
   "setup": "3 members, 2 non-empty reports",
   "expect": {
    "exit": 1,
    "state": "partial",
    "present": 2,
    "missing": 1,
    "missing_namez": [
     "C"
    ]
   }
  },
  {
   "id": "none-present",
   "setup": "2 members, no reports",
   "expect": {
    "exit": 1,
    "state": "unsettled",
    "present": 0,
    "missing": 2
   }
  },
  {
   "id": "empty-report",
   "setup": "2 members, one report 0 bytes",
   "expect": {
    "exit": 1,
    "state": "partial",
    "present": 1,
    "empty": 1
   }
  },
  {
   "id": "misrooted",
   "setup": "2 members, one report only under --fleet-root at the same relative path",
   "expect": {
    "exit": 1,
    "state": "partial",
    "present": 1,
    "misrooted": 1
   }
  },
  {
   "id": "malformed-dispatch",
   "setup": "one file with schema text but invalid JSON next to one valid settled wave",
   "expect": {
    "exit": 0,
    "unreadable_json": 1,
    "waves": 1
   }
  },
  {
   "id": "no-trailer",
   "setup": "2 members, one task without Report trailer, other present",
   "expect": {
    "exit": 1,
    "state": "partial",
    "present": 1,
    "unparsed": 1
   }
  },
  {
   "id": "traversal",
   "setup": "1 member whose trailer path is ../../outside.md (file exists outside lane)",
   "expect": {
    "exit": 1,
    "state": "unavailable",
    "unsafe": 1,
    "present": 0
   }
  },
  {
   "id": "absolute-path",
   "setup": "1 member whose trailer path is absolute and exists",
   "expect": {
    "exit": 1,
    "state": "unavailable",
    "unsafe": 1
   }
  },
  {
   "id": "symlink-report",
   "setup": "1 member whose report path is a symlink to a non-empty file",
   "expect": {
    "exit": 1,
    "present": 0,
    "not_followed": true
   }
  },
  {
   "id": "other-schema-ignored",
   "setup": "one ufo-swarm-registry-v1 JSON and one plain JSON plus one settled wave",
   "expect": {
    "exit": 0,
    "ignored_json": 2,
    "waves": 1
   }
  },
  {
   "id": "no-spawn",
   "setup": "dispatch with taskCall null",
   "expect": {
    "exit": 0,
    "state": "no-spawn",
    "members": 0
   }
  },
  {
   "id": "content-not-emitted",
   "setup": "report containing canary CANARY-r20-7f3a",
   "expect": {
    "exit": 0,
    "stdout_contains_canary": false,
    "out_contains_canary": false
   }
  },
  {
   "id": "deterministic",
   "setup": "two waves in two dirs, run scan twice",
   "expect": {
    "byte_identical": true,
    "waves_sorted_by_path": true,
    "no_vocab": [
     "dead",
     "failed",
     "killed"
    ]
   }
  }
 ]
}