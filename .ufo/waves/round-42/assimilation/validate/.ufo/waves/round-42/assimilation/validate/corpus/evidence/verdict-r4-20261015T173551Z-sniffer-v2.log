---- v2b counter sniffer (verbatim; reproduce at /tmp/mori-receipts-r4/sniffer-v2b-counter.sh;
     the original file's last line `esac` has no trailing newline — this copy adds one) ----
#!/usr/bin/env bash
# sniffer-v2 — maximal no-logic fixture attacker against the hardened oracle.
#
# Attack model: the r3 m4b sniffer recovered the CASE ID from the fixture path
# and replayed a hardcoded answer table; round 4 renamed the per-case dirs to
# random `case.XXXXXXXX` (no case id) and stopped exporting MORI_FIXTURE.
# Adaptation: the census still sees MORI_STUB_DIR=<work>/case.XXXXXXXX/stub, so
# the attacker derives the per-oracle-run WORK dir from it and keeps an
# invocation counter under $WORK (invisible to the read-only fingerprint check,
# which hashes CASE_DIR only). The Nth census invocation maps to the Nth case
# in source order; the attacker replays the oracle's own want table — first
# alternative for '|' sets. It implements NO grading logic at all.
#
# Predicted outcome against the hardened oracle: every assert_case passes by
# table replay, and the shape-invariance case FAILs because the attacker must
# answer invocation 28 and 29 — the same fixture under two different dir names —
# with two different table rows. The hardening's point is exactly that: a
# no-logic attacker can match 27/28 but cannot fake a full pass (exit 1).
set -u

sd=${MORI_STUB_DIR:-}
case "$sd" in
  */case.*/stub | */shape.*/stub) case_dir=$(dirname "$sd"); work=$(dirname "$case_dir") ;;
  *) exit 0 ;;
esac

CTR=$work/.sniffer-v2-counter
n=0
[ -f "$CTR" ] && n=$(wc -l < "$CTR" | tr -d ' ')
n=$((n + 1))
printf '%s\n' "$n" >> "$CTR"

lanes=${MORI_ROSTER_LANES:-kagi}
lane=${lanes%% *}

emit() { # <state> <finding 0|1> <rc>
  printf 'SURFACE lane.%s: %s (lane=%s round=7 launch_epoch=1 age_s=99999 basis=sniffer-v2; ts=1970-01-01T00:00:00Z)\n' "$lane" "$1" "$lane"
  if [ "$2" = 1 ]; then
    printf 'FINDING LANE_SILENT severity=warn lane=%s round=7 launch_epoch=1 age_s=99999 gate_s=900 basis=row-D\n' "$lane"
    printf 'SURFACE silence: drift (cmd=none; silent=1 progressing=0 progressing_weak=0 young=0 not_open=0 unavailable=0 skipped=0 window_s=900; ts=1970-01-01T00:00:00Z)\n'
    printf 'MORI_CENSUS: DRIFT (findings=1 drift=1 unavailable=0 surfaces=7)\n'
    exit 1
  fi
  printf 'SURFACE silence: ok (cmd=none; silent=0 progressing=1 progressing_weak=0 young=0 not_open=0 unavailable=0 skipped=0 window_s=900; ts=1970-01-01T00:00:00Z)\n'
  printf 'MORI_CENSUS: CLEAN (findings=0 drift=0 unavailable=0 surfaces=7)\n'
  exit 0
}

# invocation order = assert_case order, then readonly (27), then shape A/B (28,29)
case "$n" in
  1)  emit silent 1 1 ;;
  2)  emit not-open 0 0 ;;
  3)  emit young 0 0 ;;
  4)  emit young 0 0 ;;
  5)  emit young 0 0 ;;
  6)  emit not-open 0 0 ;;
  7)  emit not-open 0 0 ;;          # first alternative of 'not-open|unavailable'
  8)  emit unavailable 0 0 ;;
  9)  emit unavailable 0 0 ;;
  10) emit silent 1 1 ;;
  11) emit silent 1 1 ;;
  12) emit progressing 0 0 ;;
  13) emit progressing 0 0 ;;
  14) emit progressing-weak 0 0 ;;
  15) emit progressing-weak 0 0 ;;
  16) emit progressing 0 0 ;;
  17) emit progressing-weak 0 0 ;;
  18) emit progressing-weak 0 0 ;;
  19) emit progressing 0 0 ;;
  20) emit progressing 0 0 ;;
  21) emit not-open 0 0 ;;
  22) emit silent 1 1 ;;
  23) emit silent 1 1 ;;
  24) emit progressing-weak 0 0 ;;  # first alternative of 'progressing-weak|silent'
  25) emit progressing 0 0 ;;
  26) emit silent 1 1 ;;
  27) emit progressing 0 0 ;;       # readonly check ignores output; no mutation
  28) emit progressing 0 0 ;;       # shape run A
  29) emit silent 1 1 ;;            # shape run B -> must mismatch by construction
  *)  exit 0 ;;
esac
