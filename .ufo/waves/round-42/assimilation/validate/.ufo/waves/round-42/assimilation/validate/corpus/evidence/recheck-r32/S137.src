  {
    "sha": "4fb4ab89a495427305c82983d168a0efb3482921",
    "node_id": "C_kwDOAPHdINoAKDRmYjRhYjg5YTQ5NTQyNzMwNWM4Mjk4M2QxNjhhMGVmYjM0ODI5MjE",
    "commit": {
      "author": {
        "name": "Jakob Unterwurzacher",
        "email": "jakobunt@gmail.com",
        "date": "2025-09-11T20:01:19Z"
      },
      "committer": {
        "name": "Jakob Unterwurzacher",
        "email": "jakobunt@gmail.com",
        "date": "2025-09-11T20:01:19Z"
      },
      "message": "notify: use double-fork instead of ignoring SIGCHLD\n\nThis will allow us to properly check the exit code\nof the pre-notify script ( https://github.com/rfjakob/earlyoom/pull/348 )\nwhich would not be possible when ignoring SIGCHLD.\n\nIgnoring SIGCHLD causes the kernel to auto-reap children\nand we cannot access the exit code.",
      "tree": {
        "sha": "f5d4771f181045e393153a0bacb957b6d539707e",
        "url": "https://api.github.com/repos/rfjakob/earlyoom/git/trees/f5d4771f181045e393153a0bacb957b6d539707e"
      },
