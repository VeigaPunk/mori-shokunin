[
  {
    "sha": "d33c11c64218ff5d15697be94bcffa0ee1337450",
    "node_id": "C_kwDOAPHdINoAKGQzM2MxMWM2NDIxOGZmNWQxNTY5N2JlOTRiY2ZmYTBlZTEzMzc0NTA",
    "commit": {
      "author": {
        "name": "sabrimete",
        "email": "sabrimete99@gmail.com",
        "date": "2026-10-15T17:28:19Z"
      },
      "committer": {
        "name": "rfjakob",
        "email": "jakobunt@gmail.com",
        "date": "2026-10-17T18:34:22Z"
      },
      "message": "poll_loop: use the refreshed signal level after selecting the victim\n\nThe signal level was computed before find_largest_process() and the\nmeminfo re-check afterwards only tested for zero, so a level change\nduring victim selection would send the wrong signal. Recompute\nlowmem_sig() and pass the refreshed value to kill_process().\n\nFixes #388\n\nCo-Authored-By: Devin",
      "tree": {
        "sha": "2d663b84b58e4f19ccd4bb75ab9088289453ed0a",
        "url": "https://api.github.com/repos/rfjakob/earlyoom/git/trees/2d663b84b58e4f19ccd4bb75ab9088289453ed0a"
      },
