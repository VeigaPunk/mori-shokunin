  {
    "sha": "459d76296d3d0a0b59ee1e2e48ad2271429de916",
    "node_id": "C_kwDOAPHdINoAKDQ1OWQ3NjI5NmQzZDBhMGI1OWVlMWUyZTQ4YWQyMjcxNDI5ZGU5MTY",
    "commit": {
      "author": {
        "name": "Jakob Unterwurzacher",
        "email": "jakobunt@gmail.com",
        "date": "2023-02-05T18:02:22Z"
      },
      "committer": {
        "name": "Jakob Unterwurzacher",
        "email": "jakobunt@gmail.com",
        "date": "2023-02-05T19:21:41Z"
      },
      "message": "Introduce UserMemTotal and calculate MemAvailablePercent based on it\n\nShmem/tmpfs may block a large part of RAM. This memory cannot be freed\nby killing processes. Before this change, we could get into a\nsituation where earlyoom kills *every* process, but still cannot\nachieve the desired MemAvailablePercent.\n\nFixes: https://github.com/rfjakob/earlyoom/pull/274\nFixes: https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=1012870",
      "tree": {
        "sha": "b2de1294e2c54e08a1f5047b736ab12d5c7c92b3",
        "url": "https://api.github.com/repos/rfjakob/earlyoom/git/trees/b2de1294e2c54e08a1f5047b736ab12d5c7c92b3"
      },
      "url": "https://api.github.com/repos/rfjakob/earlyoom/git/commits/459d76296d3d0a0b59ee1e2e48ad2271429de916",
      "comment_count": 0,
      "verification": {
