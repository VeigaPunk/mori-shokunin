  },
  {
    "sha": "1975ed756e1ef2cc1a5b43bbaff2493e479cd1ca",
    "node_id": "C_kwDOAPHdINoAKDE5NzVlZDc1NmUxZWYyY2MxYTViNDNiYmFmZjI0OTNlNDc5Y2QxY2E",
    "commit": {
      "author": {
        "name": "oxalica",
        "email": "oxalicc@pm.me",
        "date": "2022-10-04T19:31:12Z"
      },
      "committer": {
        "name": "rfjakob",
        "email": "jakobunt@gmail.com",
        "date": "2022-10-16T11:26:04Z"
      },
      "message": "Ignore SIGCHLD to prevent creating zombies\n\nCalling `waitpid` once in SIGCHLD is not enough. Multiple children may\ndied during the delivery of the signal.\n\nIn sigaction(2),\n> POSIX.1-1990 disallowed setting the action for SIGCHLD to SIG_IGN.\n> POSIX.1-2001 and later allow this possibility, so that ignoring SIGCHLD\n> can be used to prevent the creation of zombies (see wait(2)).",
      "tree": {
        "sha": "d4963b9938a7814be126576431b7fb4093a24719",
        "url": "https://api.github.com/repos/rfjakob/earlyoom/git/trees/d4963b9938a7814be126576431b7fb4093a24719"
      },
      "url": "https://api.github.com/repos/rfjakob/earlyoom/git/commits/1975ed756e1ef2cc1a5b43bbaff2493e479cd1ca",
      "comment_count": 0,
      "verification": {
        "verified": false,
        "reason": "unsigned",
        "signature": null,
        "payload": null,
        "verified_at": null
      }
    },
