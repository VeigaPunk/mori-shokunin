24,7026,7029],{"type":315,"textContent":438},{"type":324,"nodeName":440,"attributes":7008,"children":7009},{"class":442},[],{"type":315,"textContent":7011},"gibson042",{"type":324,"nodeName":440,"attributes":7013,"children":7014},{"class":442},[],{"type":315,"textContent":7016},".github",{"type":324,"nodeName":440,"attributes":7018,"children":7019},{"class":442},[],{"type":315,"textContent":3546},{"type":324,"nodeName":440,"attributes":7022,"children":7023},{"class":442},[],{"type":315,"textContent":7025},"\u002Fcanonicaljson-",{"type":324,"nodeName":440,"attributes":7027,"children":7028},{"class":442},[],{"type":315,"textContent":7030},"spec\u002F",{"type":315,"textContent":2784},{"type":324,"nodeName":337,"attributes":7033,"children":7035},{"href":7034,"class":355},"#section-appendix.h-2.2",[7036],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":7040,"children":7042},{"class":748,"id":7041},"section-appendix.h-2.3",[7043,7044,7082,7087],{"type":315,"textContent":1187},{"type":324,"nodeName":430,"attributes":7045,"children":7046},{},[7047,7048,7081],{"type":315,"textContent":2733},{"type":324,"nodeName":337,"attributes":7049,"children":7051},{"href":7050},"http:\u002F\u002Fwiki.laptop.org\u002Fgo\u002FCanonical_JSON",[7052,7054,7057,7059,7062,7064,7067,7068,7071,7072,7075,7077,7080],{"type":315,"textContent":7053},"http:\u002F\u002F",{"type":324,"nodeName":440,"attributes":7055,"children":7056},{"class":442},[],{"type":315,"textContent":7058},"wiki",{"type":324,"nodeName":440,"attributes":7060,"children":7061},{"class":442},[],{"type":315,"textContent":7063},".laptop",{"type":324,"nodeName":440,"attributes":7065,"children":7066},{"class":442},[],{"type":315,"textContent":460},{"type":324,"nodeName":440,"attributes":7069,"children":7070},{"class":442},[],{"type":315,"textContent":6761},{"type":324,"nodeName":440,"attributes":7073,"children":7074},{"class":442},[],{"type":315,"textContent":7076},"\u002FCanonical_",{"type":324,"nodeName":440,"attributes":7078,"children":7079},{"class":442},[],{"type":315,"textContent":53},{"type":315,"textContent":2784},{"type":324,"nodeName":337,"attributes":7083,"children":7085},{"href":7084,"class":355},"#section-appendix.h-2.3",[7086],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":7091,"children":7093},{"id":7092},"section-appendix.h-3",[7094,7096],{"type":315,"textContent":7095},"\n        The listed efforts all build on text-level JSON-to-JSON\n        transformations. The primary feature of text-level canonicalization is\n        that it can be made neutral to the flavor of JSON used.  However, such\n        schemes also imply major changes to the JSON parsing process, which is\n        a likely hurdle for adoption. Albeit at the expense of certain JSON\n        and application constraints, JCS was designed to be compatible with\n        existing JSON tools.",{"type":324,"nodeName":337,"attributes":7097,"children":7099},{"href":7098,"class":355},"#section-appendix.h-3",[7100],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":7105,"children":7107},{"id":7106},"json.development",[7108,7109,7222],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":7110,"children":7111},{"id":297},[7112,7113,7129,7130,7178,7179,7221],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":7114,"children":7115},{"id":300},[7116,7117,7123,7128],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":7118,"children":7120},{"href":7119,"class":580},"#section-appendix.i",[7121],{"type":315,"textContent":7122},"Appendix I. ",{"type":324,"nodeName":337,"attributes":7124,"children":7126},{"href":7125,"class":393},"#name-development-portal",[7127],{"type":315,"textContent":301},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":7131,"children":7133},{"id":7132},"section-appendix.i-1",[7134,7136,7172,7173],{"type":315,"textContent":7135},"\n        The JCS specification is currently developed at:\n        ",{"type":324,"nodeName":430,"attributes":7137,"children":7138},{},[7139,7140,7171],{"type":315,"textContent":2733},{"type":324,"nodeName":337,"attributes":7141,"children":7143},{"href":7142},"https:\u002F\u002Fgithub.com\u002Fcyberphone\u002Fietf-json-canon",[7144,7145,7148,7149,7152,7153,7156,7157,7160,7162,7165,7166,7169],{"type":315,"textContent":438},{"type":324,"nodeName":440,"attributes":7146,"children":7147},{"class":442},[],{"type":315,"textContent":3993},{"type":324,"nodeName":440,"attributes":7150,"children":7151},{"class":442},[],{"type":315,"textContent":3998},{"type":324,"nodeName":440,"attributes":7154,"children":7155},{"class":442},[],{"type":315,"textContent":6737},{"type":324,"nodeName":440,"attributes":7158,"children":7159},{"class":442},[],{"type":315,"textContent":7161},"\u002Fietf-",{"type":324,"nodeName":440,"attributes":7163,"children":7164},{"class":442},[],{"type":315,"textContent":6696},{"type":324,"nodeName":440,"attributes":7167,"children":7168},{"class":442},[],{"type":315,"textContent":7170},"canon",{"type":315,"textContent":2784},{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":7174,"children":7176},{"href":7175,"class":355},"#section-appendix.i-1",[7177],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":7180,"children":7182},{"id":7181},"section-appendix.i-2",[7183,7185,7215,7216],{"type":315,"textContent":7184},"\n        JCS source code and extensive test data is available at:\n        ",{"type":324,"nodeName":430,"attributes":7186,"children":7187},{},[7188,7189,7214],{"type":315,"textContent":2733},{"type":324,"nodeName":337,"attributes":7190,"children":7192},{"hr