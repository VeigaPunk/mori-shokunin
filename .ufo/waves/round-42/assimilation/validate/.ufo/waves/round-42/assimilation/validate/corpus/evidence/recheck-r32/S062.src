gs-calt-off wrap-anywhere group"><!----><!--[--><!--[--><span><span class="font-medium">RFC</span> <span class="font-bold">8785</span>:</span><!----><!--]-->   <span></span>   <span class="font-normal"><!--[-->JSON Canonicalization Scheme (JCS)<!--]--></span><!--]--></h1><div class="flex mt-2 mb-2"><ul class="flex flex-col gap-4 md:flex-row items-start pl-2 text-sm"><!--[--><li class="flex flex-col md:flex-row pr-2"><a href="/subjects/cryptography/" class="relative bg-blue-25 dark:bg-blue-800 px-1 py-0.5 no-underline rounded-r border-y border-r border-blue-50 dark:border-blue-300 font-bold before:content-[&#39;&#39;] before:absolute before:inset-y-0 before:right-full before:w-3 before:bg-blue-50 dark:before:bg-blue-300 before:[clip-path:polygon(0_50%,100%_0,100%_100%)] after:content-[&#39;&#39;] after:absolute after:top-px after:bottom-px after:right-full after:w-2.5 after:bg-blue-25 dark:after:bg-blue-800 after:border-r after:border-blue-25 dark:after:border-blue-700 after:[clip-path:polygon(0_50%,100%_0,100%_100%)] text-blue-300 dark:text-white hover:text-blue-500 dark:hover:text-blue-100" data-is-nuxt-link><!--[-->cryptography<!--]--></a></li><li class="flex flex-col md:flex-row pr-2"><a href="/subjects/json/" class="relative bg-blue-25 dark:bg-blue-800 px-1 py-0.5 no-underline rounded-r border-y border-r border-blue-50 dark:border-blue-300 font-bold before:content-[&#39;&#39;] before:absolute before:inset-y-0 before:right-full before:w-3 before:bg-blue-50 dark:before:bg-blue-300 before:[clip-path:polygon(0_50%,100%_0,100%_100%)] after:content-[&#39;&#39;] after:absolute after:top-px after:bottom-px after:right-full after:w-2.5 after:bg-blue-25 dark:after:bg-blue-800 after:border-r after:border-blue-25 dark:after:border-blue-700 after:[clip-path:polygon(0_50%,100%_0,100%_100%)] text-blue-300 dark:text-white hover:text-blue-500 dark:hover:text-blue-100" data-is-nuxt-link><!--[-->JSON<!--]--></a></li><!--]--></ul></div><!----><ul class="block print:text-center font