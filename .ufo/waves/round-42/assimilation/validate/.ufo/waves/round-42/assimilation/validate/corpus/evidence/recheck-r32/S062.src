337,"attributes":2542,"children":2544},{"href":2543,"class":355},"#section-5-1",[2545],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2548,"children":2550},{"id":2549},"section-5-2",[2551,2553,2557,2559,2563,2565],{"type":315,"textContent":2552},"\n        When JCS is applied to signature schemes like the one described\n        in ",{"type":324,"nodeName":337,"attributes":2554,"children":2555},{"href":835,"class":606},[2556],{"type":315,"textContent":274},{"type":315,"textContent":2558},",\n        applications ",{"type":324,"nodeName":430,"attributes":2560,"children":2561},{"class":968},[2562],{"type":315,"textContent":971},{"type":315,"textContent":2564}," perform the following operations\n before acting\n        upon received data:",{"type":324,"nodeName":337,"attributes":2566,"children":2568},{"href":2567,"class":355},"#section-5-2",[2569],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":2572,"attributes":2573,"children":2576},"ol",{"start":85,"type":85,"class":2574,"id":2575},"normal type-1","section-5-3",[2577,2578,2590,2591,2603,2604,2616],{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":2579,"children":2581},{"id":2580},"section-5-3.1",[2582,2584,2589],{"type":315,"textContent":2583},"\n          Parse the JSON data and verify that it adheres to I-JSON.",{"type":324,"nodeName":337,"attributes":2585,"children":2587},{"href":2586,"class":355},"#section-5-3.1",[2588],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":2592,"children":2594},{"id":2593},"section-5-3.2",[2595,2597,2602],{"type":315,"textContent":2596},"\n          Verify the data for correctness according to the conventions defined\n   by the\n          ecosystem where it is to be used.   This also includes locating the\n          property holding the signature data.",{"type":324,"nodeName":337,"attributes"