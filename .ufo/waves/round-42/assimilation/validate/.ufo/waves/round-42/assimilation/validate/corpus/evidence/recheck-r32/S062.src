765,"path":7769,"pinia":7770},["ShallowReactive",3],{"info-buckethtmldocument-rfc8785":4},{"rfc":5,"tableOfContents":78,"documentHtmlType":312,"documentHtmlObj":313,"maxPreformattedLineLength":7740,"errataList":7742,"timestampIso":7760},{"number":6,"title":7,"published":8,"pages":9,"status":10,"subseries":13,"authors":14,"group":35,"stream":40,"identifiers":44,"obsoletes":48,"obsoleted_by":49,"updates":50,"updated_by":51,"keywords":52,"formats":58,"abstract":69,"reefStats":70,"reefSubjectTags":74},8785,"JSON Canonicalization Scheme (JCS)","2020-06-29",20,{"slug":11,"name":12},"inf","informational",[],[15,23,29],{"titlepage_name":16,"is_editor":17,"person":18,"email":19,"affiliation":20,"country":21,"datatracker_person_path":22},"A. Rundgren",false,106115,"anders.rundgren.net@gmail.com","Independent","","\u002Fperson\u002FAnders%20Rundgren",{"titlepage_name":24,"is_editor":17,"person":25,"email":26,"affiliation":27,"country":21,"datatracker_person_path":28},"B. Jordan",123787,"jordan2175@gmail.com","Broadcom","\u002Fperson\u002FBret%20Jordan",{"titlepage_name":30,"is_editor":17,"person":31,"email":32,"affiliation":33,"country":21,"datatracker_person_path":34},"S. Erdtman",119065,"samuel@erdtman.se","Spotify AB","\u002Fperson\u002FSamuel%20Erdtman",{"acronym":36,"name":37,"state":38,"type":39},"none","Individual Submissions","active","individ",{"slug":41,"name":42,"description":43},"INDEPENDENT","Independent Stream","Independent Submission",[45],{"type":46,"value":47},"doi","10.17487\u002FRFC8785",[],[],[],[],[53,54,55,56,57],"JSON","ECMAScript","Signatures","Cryptography","Canonicalization",[59,61,63,65,67],{"format":60},"txt",{"format":62},"html",{"format":64},"xml",{"format":66},"pdf",{"format":68},"json","Cryptographic operations like hashing and signing need the data to be expressed in an invariant format so that the operations are reliably repeatable. One way to address this is to create a canonical representation of the data. Canonicalization also permits data to be exchanged in its original form on the \"wire\" while cryptographic operations performed on the canonicalized counterpart of the data in the producer and consumer endpoints generate consistent results.\n\n This document describes the JSON Canonicalization Scheme (JCS). This specification defines how to create a canonical representation of JSON data by building on the strict serialization methods for JSON primitives defined by ECMAScript, constraining JSON data to the Internet JSON (I-JSON) subset, and by using deterministic property sorting.",{"ratingAggregate":71,"subscriberCount":72,"setCount":73},{"count":72},0,1,[75,77],{"slug":76,"title":76},"cryptography",{"slug":68,"title":53},{"title":79,"sections":80},"Table of Contents",[81,89,97,180,188,196,221,229,237,245,253,270,278,286,294,302,307],{"links":82},[83,86],{"id":84,"title":85},"section-1","1",{"id":87,"title":88},"name-introduction","Introduction",{"links":90},[91,94],{"id":92,"title":93},"section-2","2",{"id":95,"title":96},"name-terminology","Terminology",{"links":98,"sections":105},[99,102],{"id":100,"title":101},"section-3","3",{"id":103,"title":104},"name-detailed-operation","Detailed Operation",[106,114],{"links":107},[108,111],{"id":109,"title":110},"section-3.1","3.1",{"id":112,"title":113},"name-creation-of-input-data","Creation of Input Data",{"links":115,"sections":122},[116,119],{"id":117,"title":118},"section-3.2","3.2",{"id":120,"title":121},"name-generation-of-canonical-jso","Generation of Canonical JSON Data",[123,131,164,172],{"links":124},[125,128],{"id":126,"title":127},"section-3.2.1","3.2.1",{"id":129,"title":130},"name-whitespace","Whitespace",{"links":132,"sections":139},[133,136],{"id":134,"title":135},"section-3.2.2","3.2.2",{"id":137,"title":138},"name-serialization-of-primitive-","Serialization of Primitive Data Types",[140,148,156],{"links":141},[142,145],{"id":143,"title":144},"section-3.2.2.1","3.2.2.1",{"id":146,"title":147},"name-serialization-of-literals","Serialization of Literals",{"links":149},[150,153],{"id":151,"title":152},"section-3.2.2.2","3.2.2.2",{"id":154,"title":155},"name-serialization-of-strings","Serialization of Strings",{"links":157},[158,161],{"id":159,"title":160},"section-3.2.2.3","3.2.2.3",{"id":162,"title":163},"name-serialization-of-numbers","Serialization of Numbers",{"links":165},[166,169],{"id":167,"title":168},"section-3.2.3","3.2.3",{"id":170,"title":171},"name-sorting-of-object-propertie","Sorting of Object Properties",{"links":173},[174,177],{"id":175,"title":176},"section-3.2.4","3.2.4",{"id":178,"title":179},"name-utf-8-generation","UTF-8 Generation",{"links":181},[182,185],{"id":183,"title":184},"section-4","4",{"id":186,"title":187},"name-iana-considerations","IANA Considerations",{"links":189},[190,193],{"id":191,"title":192},"section-5","5",{"id":194,"title":195},"name-security-considerations","Security Considerations",{"links":197,"sections":204},[198,201],{"id":199,"title":200},"section-6","6",{"id":202,"title":203},"name-references","References",[205,213],{"links":206},[207,210],{"id":208,"title":209},"section-6.1","6.1",{"id":211,"title":212},"name-normative-references","Normative References",{"links":214},[215,218],{"id":216,"title":217},"section-6.2","6.2",{"id":219,"title":220},"name-informative-references","Informative References",{"links":222},[223,226],{"id":224,"title":225},"section-appendix.a","Appendix A",{"id":227,"title":228},"name-ecmascript-sample-canonical","ECMAScript Sample Canonicalizer",{"links":230},[231,234],{"id":232,"title":233},"section-appendix.b","Appendix B",{"id":235,"title":236},"name-number-serialization-sample","Number Serialization Samples",{"links":238},[239,242],{"id":240,"title":241},"section-appendix.c","Appendix C",{"id":243,"title":244},"name-canonicalized-json-as-wire-","Canonicalized JSON as \"Wire Format\"",{"links":246},[247,250],{"id":248,"title":249},"section-appendix.d","Appendix D",{"id":251,"title":252},"name-dealing-with-big-numbers","Dealing with Big Numbers",{"links":254,"sections":261},[255,258],{"id":256,"title":257},"section-appendix.e","Appendix E",{"id":259,"title":260},"name-string-subtype-handling","String Subtype Handling",[262],{"links":263},[264,267],{"id":265,"title":266},"section-e.1","E.1",{"id":268,"title":269},"name-subtypes-in-arrays","Subtypes in Arrays",{"links":271},[272,275],{"id":273,"title":274},"section-appendix.f","Appendix F",{"id":276,"title":277},"name-implementation-guidelines","Implementation Guidelines",{"links":279},[280,283],{"id":281,"title":282},"section-appendix.g","Appendix G",{"id":284,"title":285},"name-open-source-implementations","Open-Source Implementations",{"links":287},[288,291],{"id":289,"title":290},"section-appendix.h","Appendix H",{"id":292,"title":293},"name-other-json-canonicalization","Other JSON Canonicalization Efforts",{"links":295},[296,299],{"id":297,"title":298},"section-appendix.i","Appendix I",{"id":300,"title":301},"name-development-portal","Development Portal",{"links":303},[304],{"id":305,"title":306},"name-acknowledgements","Acknowledgements",{"links":308},[309],{"id":310,"title":311},"name-authors-addresses","Authors' Addresses","xml2rfc",[314,317,319,320,321,322,323,372,373,480,481,563,564,565,922,923,1069,1070,2468,2469,2508,2509,2637,2638,4141,4142,4207,4208,5631,5632,5732,5733,5907,5908,6315,6316,6570,6571,6884,6885,7103,7104,7223,7224,7406,7407,7738],{"type":315,"textContent":316},"Text","\n\n",{"type":315,"textContent":318},"\n",{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":326,"children":328},"Element","section",{"id":327},"section-abstract",[329,331,344,345,359,360,371],{"type":315,"textContent":330},"\n      ",{"type":324,"nodeName":332,"attributes":333,"children":335},"h2",{"id":334},"abstract",[336],{"type":324,"nodeName":337,"attributes":338,"children":341},"a",{"href":339,"class":340},"#abstract","selfRef",[342],{"type":315,"textContent":343},"Abstract",{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":347,"children":349},"p",{"id":348},"section-abstract-1",[350,352],{"type":315,"textContent":351},"\n        Cryptographic operations like hashing and signing need the data to be\n        expressed in an invariant format so that the operations are reliably\n        repeatable.\n\n        One way to address this is to create a canonical representation of\n        the data.  Canonicalization also permits data to be exchanged in its\n        original form on the \"wire\" while cryptographic operations\n        performed on the canonicalized counterpart of the data in the\n        producer and consumer endpoints generate consistent results.",{"type":324,"nodeName":337,"attributes":353,"children":356},{"href":354,"class":355},"#section-abstract-1","pilcrow",[357],{"type":315,"textContent":358},"¶",{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":361,"children":363},{"id":362},"section-abstract-2",[364,366],{"type":315,"textContent":365},"\n        This document describes the JSON Canonicalization Scheme (JCS).\n        This specification defines how to create a canonical representation\n        of JSON data by building on the strict serialization methods for\n        JSON primitives defined by ECMAScript, constraining JSON data to\n        the Internet JSON (I-JSON) subset, and by using deterministic property\n sorting.",{"type":324,"nodeName":337,"attributes":367,"children":369},{"href":368,"class":355},"#section-abstract-2",[370],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":375,"children":377},"div",{"id":376},"status-of-memo",[378,379,479],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":380,"children":382},{"id":381},"section-boilerplate.1",[383,385,398,399,410,411,422,423,478],{"type":315,"textContent":384},"\n        ",{"type":324,"nodeName":332,"attributes":386,"children":388},{"id":387},"name-status-of-this-memo",[389,390,397],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":391,"children":394},{"href":392,"class":393},"#name-status-of-this-memo","section-name selfRef",[395],{"type":315,"textContent":396},"Status of This Memo",{"type":315,"textContent":384},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":400,"children":402},{"id":401},"section-boilerplate.1-1",[403,405],{"type":315,"textContent":404},"\n            This document is not an Internet Standards Track specification; it is\n            published for informational purposes.",{"type":324,"nodeName":337,"attributes":406,"children":408},{"href":407,"class":355},"#section-boilerplate.1-1",[409],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":412,"children":414},{"id":413},"section-boilerplate.1-2",[415,417],{"type":315,"textContent":416},"\n            This is a contribution to the RFC Series, independently of any\n            other RFC stream.  The RFC Editor has chosen to publish this\n            document at its discretion and makes no statement about its value\n            for implementation or deployment.  Documents approved for\n            publication by the RFC Editor are not candidates for any level of\n            Internet Standard; see Section 2 of RFC 7841.",{"type":324,"nodeName":337,"attributes":418,"children":420},{"href":419,"class":355},"#section-boilerplate.1-2",[421],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":424,"children":426},{"id":425},"section-boilerplate.1-3",[427,429,471,473],{"type":315,"textContent":428},"\n            Information about the current status of this document, any\n            errata, and how to provide feedback on it may be obtained at\n            ",{"type":324,"nodeName":430,"attributes":431,"children":432},"span",{},[433],{"type":324,"nodeName":337,"attributes":434,"children":436},{"href":435},"\u002Finfo\u002Frfc8785",[437,439,444,446,449,451,454,456,459,461,464,466,469],{"type":315,"textContent":438},"https:\u002F\u002F",{"type":324,"nodeName":440,"attributes":441,"children":443},"wbr",{"class":442},"wordsize-24",[],{"type":315,"textContent":445},"www",{"type":324,"nodeName":440,"attributes":447,"children":448},{"class":442},[],{"type":315,"textContent":450},".rfc-",{"type":324,"nodeName":440,"attributes":452,"children":453},{"class":442},[],{"type":315,"textContent":455},"editor",{"type":324,"nodeName":440,"attributes":457,"children":458},{"class":442},[],{"type":315,"textContent":460},".org",{"type":324,"nodeName":440,"attributes":462,"children":463},{"class":442},[],{"type":315,"textContent":465},"\u002Finfo",{"type":324,"nodeName":440,"attributes":467,"children":468},{"class":442},[],{"type":315,"textContent":470},"\u002Frfc8785",{"type":315,"textContent":472},".",{"type":324,"nodeName":337,"attributes":474,"children":476},{"href":475,"class":355},"#section-boilerplate.1-3",[477],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":482,"children":484},{"id":483},"copyright",[485,486,562],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":487,"children":489},{"id":488},"section-boilerplate.2",[490,491,503,504,515,516,561],{"type":315,"textContent":384},{"type":324,"nodeName":332,"attributes":492,"children":494},{"id":493},"name-copyright-notice",[495,496,502],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":497,"children":499},{"href":498,"class":393},"#name-copyright-notice",[500],{"type":315,"textContent":501},"Copyright Notice",{"type":315,"textContent":384},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":505,"children":507},{"id":506},"section-boilerplate.2-1",[508,510],{"type":315,"textContent":509},"\n            Copyright (c) 2020 IETF Trust and the persons identified as the\n            document authors. All rights reserved.",{"type":324,"nodeName":337,"attributes":511,"children":513},{"href":512,"class":355},"#section-boilerplate.2-1",[514],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":517,"children":519},{"id":518},"section-boilerplate.2-2",[520,522,554,556],{"type":315,"textContent":521},"\n            This document is subject to BCP 78 and the IETF Trust's Legal\n            Provisions Relating to IETF Documents\n            (",{"type":324,"nodeName":430,"attributes":523,"children":524},{},[525],{"type":324,"nodeName":337,"attributes":526,"children":528},{"href":527},"https:\u002F\u002Ftrustee.ietf.org\u002Flicense-info",[529,530,533,535,538,540,543,544,547,549,552],{"type":315,"textContent":438},{"type":324,"nodeName":440,"attributes":531,"children":532},{"class":442},[],{"type":315,"textContent":534},"trustee",{"type":324,"nodeName":440,"attributes":536,"children":537},{"class":442},[],{"type":315,"textContent":539},".ietf",{"type":324,"nodeName":440,"attributes":541,"children":542},{"class":442},[],{"type":315,"textContent":460},{"type":324,"nodeName":440,"attributes":545,"children":546},{"class":442},[],{"type":315,"textContent":548},"\u002Flicense-",{"type":324,"nodeName":440,"attributes":550,"children":551},{"class":442},[],{"type":315,"textContent":553},"info",{"type":315,"textContent":555},") in effect on the date of\n            publication of this document. Please review these documents\n            carefully, as they describe your rights and restrictions with\n            respect to this document.",{"type":324,"nodeName":337,"attributes":557,"children":559},{"href":558,"class":355},"#section-boilerplate.2-2",[560],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":566,"children":567},{"id":88},[568,569,921],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":570,"children":571},{"id":84},[572,573,590,591,646,647,697,698,709,710,732,733,744,745,847,848,884,885,908,909,920],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":574,"children":575},{"id":87},[576,577,584,589],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":578,"children":581},{"href":579,"class":580},"#section-1","section-number selfRef",[582],{"type":315,"textContent":583},"1. ",{"type":324,"nodeName":337,"attributes":585,"children":587},{"href":586,"class":393},"#name-introduction",[588],{"type":315,"textContent":88},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":592,"children":594},{"id":593},"section-1-1",[595,597,612,614,626,628,639,641],{"type":315,"textContent":596},"\n        This document describes the JSON Canonicalization Scheme (JCS).\n        This specification defines how to create a canonical representation\n        of JSON ",{"type":324,"nodeName":430,"attributes":598,"children":600},{"class":599},"reference-citation wordsize-6",[601,603,610],{"type":315,"textContent":602},"[",{"type":324,"nodeName":337,"attributes":604,"children":607},{"href":605,"class":606},"#RFC8259","xref",[608],{"type":315,"textContent":609},"RFC8259",{"type":315,"textContent":611},"]",{"type":315,"textContent":613}," data by building\n        on the strict serialization methods for\n        JSON primitives defined by ECMAScript ",{"type":324,"nodeName":430,"attributes":615,"children":617},{"class":616},"reference-citation wordsize-8",[618,619,625],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":620,"children":622},{"href":621,"class":606},"#ECMA-262",[623],{"type":315,"textContent":624},"ECMA-262",{"type":315,"textContent":611},{"type":315,"textContent":627},",\n        constraining JSON data to the I-JSON ",{"type":324,"nodeName":430,"attributes":629,"children":630},{"class":599},[631,632,638],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":633,"children":635},{"href":634,"class":606},"#RFC7493",[636],{"type":315,"textContent":637},"RFC7493",{"type":315,"textContent":611},{"type":315,"textContent":640},"\n        subset, and by using deterministic property sorting. The output from\n JCS is a\n        \"hashable\" representation of JSON data that can be used by\n cryptographic methods.\n        The subsequent paragraphs outline the primary design considerations.",{"type":324,"nodeName":337,"attributes":642,"children":644},{"href":643,"class":355},"#section-1-1",[645],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":648,"children":650},{"id":649},"section-1-2",[651,653,664,666,677,679,690,692],{"type":315,"textContent":652},"\n        Cryptographic operations like hashing and signing need the data to be\n        expressed in an invariant format so that the operations are reliably\n        repeatable.\n        One way to accomplish this is to convert the data into\n        a format that has a simple and fixed representation,\n        like base64url ",{"type":324,"nodeName":430,"attributes":654,"children":655},{"class":599},[656,657,663],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":658,"children":660},{"href":659,"class":606},"#RFC4648",[661],{"type":315,"textContent":662},"RFC4648",{"type":315,"textContent":611},{"type":315,"textContent":665},".\n        This is how JSON Web Signature (JWS) ",{"type":324,"nodeName":430,"attributes":667,"children":668},{"class":599},[669,670,676],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":671,"children":673},{"href":672,"class":606},"#RFC7515",[674],{"type":315,"textContent":675},"RFC7515",{"type":315,"textContent":611},{"type":315,"textContent":678}," addressed this issue.\n        Another solution is to create a canonical version of the data,\n        similar to what was done for the XML signature ",{"type":324,"nodeName":430,"attributes":680,"children":681},{"class":599},[682,683,689],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":684,"children":686},{"href":685,"class":606},"#XMLDSIG",[687],{"type":315,"textContent":688},"XMLDSIG",{"type":315,"textContent":611},{"type":315,"textContent":691}," standard.",{"type":324,"nodeName":337,"attributes":693,"children":695},{"href":694,"class":355},"#section-1-2",[696],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":699,"children":701},{"id":700},"section-1-3",[702,704],{"type":315,"textContent":703},"  \n        The primary advantage with a canonicalizing scheme is that data\n        can be kept in its original form. This is the core rationale behind\n JCS.\n        Put another way, using canonicalization enables a JSON object to\n remain a JSON object\n        even after being signed. This can simplify system design,\n documentation, and logging.",{"type":324,"nodeName":337,"attributes":705,"children":707},{"href":706,"class":355},"#section-1-3",[708],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":711,"children":713},{"id":712},"section-1-4",[714,716,725,727],{"type":315,"textContent":715},"\n        To avoid \"reinventing the wheel\", JCS relies on the serialization of\n JSON primitives\n        (strings, numbers, and literals), as defined by ECMAScript (aka\n JavaScript)\n        ",{"type":324,"nodeName":430,"attributes":717,"children":718},{"class":616},[719,720,724],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":721,"children":722},{"href":621,"class":606},[723],{"type":315,"textContent":624},{"type":315,"textContent":611},{"type":315,"textContent":726}," beginning with version 6.",{"type":324,"nodeName":337,"attributes":728,"children":730},{"href":729,"class":355},"#section-1-4",[731],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":734,"children":736},{"id":735},"section-1-5",[737,739],{"type":315,"textContent":738},"\n        Seasoned XML developers may recall difficulties getting XML signatures\n        to validate.  This was usually due to different interpretations of the\n quite intricate\n        XML canonicalization rules as well as of the equally complex\n        Web Services security standards.\n        The reasons why JCS should not suffer from similar issues are:",{"type":324,"nodeName":337,"attributes":740,"children":742},{"href":741,"class":355},"#section-1-5",[743],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":746,"attributes":747,"children":749},"ul",{"class":748},"normal",[750,751,764,765,788,789,819,820,846],{"type":315,"textContent":318},{"type":324,"nodeName":752,"attributes":753,"children":755},"li",{"class":748,"id":754},"section-1-6.1",[756,758,763],{"type":315,"textContent":757},"\n          JSON does not have a namespace concept and default values.",{"type":324,"nodeName":337,"attributes":759,"children":761},{"href":760,"class":355},"#section-1-6.1",[762],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":766,"children":768},{"class":748,"id":767},"section-1-6.2",[769,771,780,782,787],{"type":315,"textContent":770},"\n          Data is constrained to the I‑JSON ",{"type":324,"nodeName":430,"attributes":772,"children":773},{"class":599},[774,775,779],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":776,"children":777},{"href":634,"class":606},[778],{"type":315,"textContent":637},{"type":315,"textContent":611},{"type":315,"textContent":781}," subset.\n          This eliminates the need for specific parsers for dealing with\n   canonicalization.",{"type":324,"nodeName":337,"attributes":783,"children":785},{"href":784,"class":355},"#section-1-6.2",[786],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":790,"children":792},{"class":748,"id":791},"section-1-6.3",[793,795,799,801,812,813,818],{"type":315,"textContent":794},"\n          JCS-compatible serialization of JSON primitives is currently\n   supported\n          by most web browsers as well as by Node",{"type":324,"nodeName":440,"attributes":796,"children":798},{"class":797},"wordsize-4",[],{"type":315,"textContent":800},".js ",{"type":324,"nodeName":430,"attributes":802,"children":803},{"class":599},[804,805,811],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":806,"children":808},{"href":807,"class":606},"#NODEJS",[809],{"type":315,"textContent":810},"NODEJS",{"type":315,"textContent":611},{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":814,"children":816},{"href":815,"class":355},"#section-1-6.3",[817],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":821,"children":823},{"class":748,"id":822},"section-1-6.4",[824,826,831,833,838,840,845],{"type":315,"textContent":825},"\n          The full JCS specification is currently supported by multiple\n          open-source implementations (see ",{"type":324,"nodeName":337,"attributes":827,"children":829},{"href":828,"class":606},"#open.source",[830],{"type":315,"textContent":282},{"type":315,"textContent":832},").\n          See also ",{"type":324,"nodeName":337,"attributes":834,"children":836},{"href":835,"class":606},"#impl.guidelines",[837],{"type":315,"textContent":274},{"type":315,"textContent":839}," for\n   implementation \n          guidelines.",{"type":324,"nodeName":337,"attributes":841,"children":843},{"href":842,"class":355},"#section-1-6.4",[844],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":849,"children":851},{"id":850},"section-1-7",[852,854,865,867,878,879],{"type":315,"textContent":853},"\n        JCS is compatible with some existing systems relying on JSON\n        canonicalization such as JSON Web Key (JWK) Thumbprint ",{"type":324,"nodeName":430,"attributes":855,"children":856},{"class":599},[857,858,864],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":859,"children":861},{"href":860,"class":606},"#RFC7638",[862],{"type":315,"textContent":863},"RFC7638",{"type":315,"textContent":611},{"type":315,"textContent":866}," and Keybase ",{"type":324,"nodeName":430,"attributes":868,"children":869},{"class":599},[870,871,877],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":872,"children":874},{"href":873,"class":606},"#KEYBASE",[875],{"type":315,"textContent":876},"KEYBASE",{"type":315,"textContent":611},{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":880,"children":882},{"href":881,"class":355},"#section-1-7",[883],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":886,"children":888},{"id":887},"section-1-8",[889,891,902,903],{"type":315,"textContent":890},"\n        For potential uses outside of cryptography, see ",{"type":324,"nodeName":430,"attributes":892,"children":893},{"class":616},[894,895,901],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":896,"children":898},{"href":897,"class":606},"#I-D.rundgren-comparable-json",[899],{"type":315,"textContent":900},"JSONCOMP",{"type":315,"textContent":611},{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":904,"children":906},{"href":905,"class":355},"#section-1-8",[907],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":910,"children":912},{"id":911},"section-1-9",[913,915],{"type":315,"textContent":914},"\n        The intended audiences of this document are JSON tool vendors as\n        well as designers of JSON-based cryptographic solutions.\n        The reader is assumed to be knowledgeable in ECMAScript, including the\n \"JSON\" object.",{"type":324,"nodeName":337,"attributes":916,"children":918},{"href":917,"class":355},"#section-1-9",[919],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":924,"children":925},{"id":96},[926,927,1068],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":928,"children":929},{"id":92},[930,931,947,948,959,960,1067],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":932,"children":933},{"id":95},[934,935,941,946],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":936,"children":938},{"href":937,"class":580},"#section-2",[939],{"type":315,"textContent":940},"2. ",{"type":324,"nodeName":337,"attributes":942,"children":944},{"href":943,"class":393},"#name-terminology",[945],{"type":315,"textContent":96},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":949,"children":951},{"id":950},"section-2-1",[952,954],{"type":315,"textContent":953},"\n        Note that this document is not on the IETF standards track. However, a\n conformant\n        implementation is supposed to adhere to the specified behavior for\n        security and interoperability reasons.  This text uses BCP 14 to\n        describe that necessary behavior.",{"type":324,"nodeName":337,"attributes":955,"children":957},{"href":956,"class":355},"#section-2-1",[958],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":961,"children":963},{"id":962},"section-2-2",[964,966,972,974,979,981,986,987,992,993,998,999,1004,1005,1010,1011,1016,1017,1022,1023,1028,1030,1035,1037,1048,1049,1060,1062],{"type":315,"textContent":965},"\n    The key words \"",{"type":324,"nodeName":430,"attributes":967,"children":969},{"class":968},"bcp14",[970],{"type":315,"textContent":971},"MUST",{"type":315,"textContent":973},"\", \"",{"type":324,"nodeName":430,"attributes":975,"children":976},{"class":968},[977],{"type":315,"textContent":978},"MUST NOT",{"type":315,"textContent":980},"\",\n    \"",{"type":324,"nodeName":430,"attributes":982,"children":983},{"class":968},[984],{"type":315,"textContent":985},"REQUIRED",{"type":315,"textContent":973},{"type":324,"nodeName":430,"attributes":988,"children":989},{"class":968},[990],{"type":315,"textContent":991},"SHALL",{"type":315,"textContent":973},{"type":324,"nodeName":430,"attributes":994,"children":995},{"class":968},[996],{"type":315,"textContent":997},"SHALL NOT",{"type":315,"textContent":973},{"type":324,"nodeName":430,"attributes":1000,"children":1001},{"class":968},[1002],{"type":315,"textContent":1003},"SHOULD",{"type":315,"textContent":973},{"type":324,"nodeName":430,"attributes":1006,"children":1007},{"class":968},[1008],{"type":315,"textContent":1009},"SHOULD NOT",{"type":315,"textContent":980},{"type":324,"nodeName":430,"attributes":1012,"children":1013},{"class":968},[1014],{"type":315,"textContent":1015},"RECOMMENDED",{"type":315,"textContent":973},{"type":324,"nodeName":430,"attributes":1018,"children":1019},{"class":968},[1020],{"type":315,"textContent":1021},"NOT RECOMMENDED",{"type":315,"textContent":980},{"type":324,"nodeName":430,"attributes":1024,"children":1025},{"class":968},[1026],{"type":315,"textContent":1027},"MAY",{"type":315,"textContent":1029},"\", and \"",{"type":324,"nodeName":430,"attributes":1031,"children":1032},{"class":968},[1033],{"type":315,"textContent":1034},"OPTIONAL",{"type":315,"textContent":1036},"\" in this document are\n    to be interpreted as described in BCP 14 ",{"type":324,"nodeName":430,"attributes":1038,"children":1039},{"class":599},[1040,1041,1047],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1042,"children":1044},{"href":1043,"class":606},"#RFC2119",[1045],{"type":315,"textContent":1046},"RFC2119",{"type":315,"textContent":611},{"type":315,"textContent":384},{"type":324,"nodeName":430,"attributes":1050,"children":1051},{"class":599},[1052,1053,1059],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1054,"children":1056},{"href":1055,"class":606},"#RFC8174",[1057],{"type":315,"textContent":1058},"RFC8174",{"type":315,"textContent":611},{"type":315,"textContent":1061}," when, and only when, they appear in all capitals,\n    as shown here.",{"type":324,"nodeName":337,"attributes":1063,"children":1065},{"href":1064,"class":355},"#section-2-2",[1066],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1071,"children":1073},{"id":1072},"Operation",[1074,1075,2467],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":1076,"children":1077},{"id":100},[1078,1079,1095,1096,1107,1108,1130,1131,1393,1394,2466],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":1080,"children":1081},{"id":103},[1082,1083,1089,1094],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":1084,"children":1086},{"href":1085,"class":580},"#section-3",[1087],{"type":315,"textContent":1088},"3. ",{"type":324,"nodeName":337,"attributes":1090,"children":1092},{"href":1091,"class":393},"#name-detailed-operation",[1093],{"type":315,"textContent":104},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1097,"children":1099},{"id":1098},"section-3-1",[1100,1102],{"type":315,"textContent":1101},"\n        This section describes the details related to creating \n        a canonical JSON representation and how they are addressed by JCS.",{"type":324,"nodeName":337,"attributes":1103,"children":1105},{"href":1104,"class":355},"#section-3-1",[1106],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1109,"children":1111},{"id":1110},"section-3-2",[1112,1113,1117,1119,1123,1125],{"type":315,"textContent":384},{"type":324,"nodeName":337,"attributes":1114,"children":1115},{"href":835,"class":606},[1116],{"type":315,"textContent":274},{"type":315,"textContent":1118}," describes\n        the ",{"type":324,"nodeName":430,"attributes":1120,"children":1121},{"class":968},[1122],{"type":315,"textContent":1015},{"type":315,"textContent":1124}," way of adding JCS support to existing\n JSON tools.",{"type":324,"nodeName":337,"attributes":1126,"children":1128},{"href":1127,"class":355},"#section-3-2",[1129],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1132,"children":1134},{"id":1133},"json.datacreation",[1135,1136,1392],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":1137,"children":1138},{"id":109},[1139,1140,1157,1158,1169,1170,1201,1202,1230,1231,1336,1337,1360,1361,1391],{"type":315,"textContent":384},{"type":324,"nodeName":1141,"attributes":1142,"children":1143},"h3",{"id":112},[1144,1145,1151,1156],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":1146,"children":1148},{"href":1147,"class":580},"#section-3.1",[1149],{"type":315,"textContent":1150},"3.1. ",{"type":324,"nodeName":337,"attributes":1152,"children":1154},{"href":1153,"class":393},"#name-creation-of-input-data",[1155],{"type":315,"textContent":113},{"type":315,"textContent":384},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1159,"children":1161},{"id":1160},"section-3.1-1",[1162,1164],{"type":315,"textContent":1163},"\n          Data to be canonically serialized is usually created by:",{"type":324,"nodeName":337,"attributes":1165,"children":1167},{"href":1166,"class":355},"#section-3.1-1",[1168],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":746,"attributes":1171,"children":1172},{"class":748},[1173,1174,1186,1188,1200],{"type":315,"textContent":318},{"type":324,"nodeName":752,"attributes":1175,"children":1177},{"class":748,"id":1176},"section-3.1-2.1",[1178,1180,1185],{"type":315,"textContent":1179},"\n              Parsing previously generated JSON data.",{"type":324,"nodeName":337,"attributes":1181,"children":1183},{"href":1182,"class":355},"#section-3.1-2.1",[1184],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1187},"\n          ",{"type":324,"nodeName":752,"attributes":1189,"children":1191},{"class":748,"id":1190},"section-3.1-2.2",[1192,1194,1199],{"type":315,"textContent":1193},"\n              Programmatically creating data.",{"type":324,"nodeName":337,"attributes":1195,"children":1197},{"href":1196,"class":355},"#section-3.1-2.2",[1198],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1203,"children":1205},{"id":1204},"section-3.1-3",[1206,1208,1212,1214,1223,1225],{"type":315,"textContent":1207},"\n          Irrespective of the method used, the data to be serialized\n   ",{"type":324,"nodeName":430,"attributes":1209,"children":1210},{"class":968},[1211],{"type":315,"textContent":971},{"type":315,"textContent":1213}," be adapted\n          for I‑JSON ",{"type":324,"nodeName":430,"attributes":1215,"children":1216},{"class":599},[1217,1218,1222],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1219,"children":1220},{"href":634,"class":606},[1221],{"type":315,"textContent":637},{"type":315,"textContent":611},{"type":315,"textContent":1224},"\n   formatting, which implies the following:",{"type":324,"nodeName":337,"attributes":1226,"children":1228},{"href":1227,"class":355},"#section-3.1-3",[1229],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":746,"attributes":1232,"children":1233},{"class":748},[1234,1235,1253,1254,1284,1285,1335],{"type":315,"textContent":318},{"type":324,"nodeName":752,"attributes":1236,"children":1238},{"class":748,"id":1237},"section-3.1-4.1",[1239,1241,1245,1247,1252],{"type":315,"textContent":1240},"\n              JSON objects ",{"type":324,"nodeName":430,"attributes":1242,"children":1243},{"class":968},[1244],{"type":315,"textContent":978},{"type":315,"textContent":1246}," exhibit duplicate property\n       names.",{"type":324,"nodeName":337,"attributes":1248,"children":1250},{"href":1249,"class":355},"#section-3.1-4.1",[1251],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1187},{"type":324,"nodeName":752,"attributes":1255,"children":1257},{"class":748,"id":1256},"section-3.1-4.2",[1258,1260,1264,1266,1277,1278,1283],{"type":315,"textContent":1259},"\n              JSON string data ",{"type":324,"nodeName":430,"attributes":1261,"children":1262},{"class":968},[1263],{"type":315,"textContent":971},{"type":315,"textContent":1265}," be expressible\n              as Unicode ",{"type":324,"nodeName":430,"attributes":1267,"children":1268},{"class":599},[1269,1270,1276],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1271,"children":1273},{"href":1272,"class":606},"#UNICODE",[1274],{"type":315,"textContent":1275},"UNICODE",{"type":315,"textContent":611},{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":1279,"children":1281},{"href":1280,"class":355},"#section-3.1-4.2",[1282],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1187},{"type":324,"nodeName":752,"attributes":1286,"children":1288},{"class":748,"id":1287},"section-3.1-4.3",[1289,1291,1295,1297,1308,1310,1314,1316,1320,1322,1327,1329,1334],{"type":315,"textContent":1290},"\n              JSON number data ",{"type":324,"nodeName":430,"attributes":1292,"children":1293},{"class":968},[1294],{"type":315,"textContent":971},{"type":315,"textContent":1296}," be expressible\n              as IEEE 754 ",{"type":324,"nodeName":430,"attributes":1298,"children":1299},{"class":599},[1300,1301,1307],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1302,"children":1304},{"href":1303,"class":606},"#IEEE754",[1305],{"type":315,"textContent":1306},"IEEE754",{"type":315,"textContent":611},{"type":315,"textContent":1309},"\n       double-",{"type":324,"nodeName":440,"attributes":1311,"children":1313},{"class":1312},"wordsize-10",[],{"type":315,"textContent":1315},"precision values.\n            For applications needing higher precision or longer integers than\n            offered by IEEE 754 double precision, it is\n     ",{"type":324,"nodeName":430,"attributes":1317,"children":1318},{"class":968},[1319],{"type":315,"textContent":1015},{"type":315,"textContent":1321}," to represent such\n            numbers as JSON strings; see ",{"type":324,"nodeName":337,"attributes":1323,"children":1325},{"href":1324,"class":606},"#json.bignumbers",[1326],{"type":315,"textContent":249},{"type":315,"textContent":1328}," for \n              details on how this can be performed in an interoperable and\n       extensible way.",{"type":324,"nodeName":337,"attributes":1330,"children":1332},{"href":1331,"class":355},"#section-3.1-4.3",[1333],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1338,"children":1340},{"id":1339},"section-3.1-5",[1341,1343,1347,1349,1354,1355],{"type":315,"textContent":1342},"\n          An additional constraint is that parsed JSON string data ",{"type":324,"nodeName":430,"attributes":1344,"children":1345},{"class":968},[1346],{"type":315,"textContent":978},{"type":315,"textContent":1348}," be altered during subsequent serializations.  For more\n          information, see ",{"type":324,"nodeName":337,"attributes":1350,"children":1352},{"href":1351,"class":606},"#string.subtypes",[1353],{"type":315,"textContent":257},{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":1356,"children":1358},{"href":1357,"class":355},"#section-3.1-5",[1359],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1362,"children":1364},{"id":1363},"section-3.1-6",[1365,1367,1378,1380,1384,1386],{"type":315,"textContent":1366},"\n          Note: Although the Unicode standard offers the possibility of\n          rearranging certain character sequences, referred to as \"Unicode\n          Normalization\" ",{"type":324,"nodeName":430,"attributes":1368,"children":1369},{"class":599},[1370,1371,1377],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1372,"children":1374},{"href":1373,"class":606},"#UCNORM",[1375],{"type":315,"textContent":1376},"UCNORM",{"type":315,"textContent":611},{"type":315,"textContent":1379},",\n          JCS-compliant string processing does not take this into\n          consideration. That is, all components involved in a scheme\n          depending on JCS ",{"type":324,"nodeName":430,"attributes":1381,"children":1382},{"class":968},[1383],{"type":315,"textContent":971},{"type":315,"textContent":1385}," preserve Unicode string data\n          \"as is\".",{"type":324,"nodeName":337,"attributes":1387,"children":1389},{"href":1388,"class":355},"#section-3.1-6",[1390],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1395,"children":1397},{"id":1396},"json.canonicalization",[1398,1399,2465],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":1400,"children":1401},{"id":117},[1402,1403,1419,1420,1431,1432,1454,1455,1501,1502,1993,1994,2361,2362,2464],{"type":315,"textContent":384},{"type":324,"nodeName":1141,"attributes":1404,"children":1405},{"id":120},[1406,1407,1413,1418],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":1408,"children":1410},{"href":1409,"class":580},"#section-3.2",[1411],{"type":315,"textContent":1412},"3.2. ",{"type":324,"nodeName":337,"attributes":1414,"children":1416},{"href":1415,"class":393},"#name-generation-of-canonical-jso",[1417],{"type":315,"textContent":121},{"type":315,"textContent":384},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1421,"children":1423},{"id":1422},"section-3.2-1",[1424,1426],{"type":315,"textContent":1425},"\n          The following subsections describe the steps required to create a\n   canonical\n          JSON representation of the data elaborated on in the previous\n   section.",{"type":324,"nodeName":337,"attributes":1427,"children":1429},{"href":1428,"class":355},"#section-3.2-1",[1430],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1433,"children":1435},{"id":1434},"section-3.2-2",[1436,1437,1442,1444,1447,1449],{"type":315,"textContent":1187},{"type":324,"nodeName":337,"attributes":1438,"children":1440},{"href":1439,"class":606},"#canonicalize.js",[1441],{"type":315,"textContent":225},{"type":315,"textContent":1443}," shows sample code\n          for an ECMAScript-",{"type":324,"nodeName":440,"attributes":1445,"children":1446},{"class":1312},[],{"type":315,"textContent":1448},"based canonicalizer, matching the JCS\n   specification.",{"type":324,"nodeName":337,"attributes":1450,"children":1452},{"href":1451,"class":355},"#section-3.2-2",[1453],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1456,"children":1458},{"id":1457},"json.whitespace",[1459,1460,1500],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":1461,"children":1462},{"id":126},[1463,1464,1481,1482,1499],{"type":315,"textContent":1187},{"type":324,"nodeName":1465,"attributes":1466,"children":1467},"h4",{"id":129},[1468,1469,1475,1480],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":1470,"children":1472},{"href":1471,"class":580},"#section-3.2.1",[1473],{"type":315,"textContent":1474},"3.2.1. ",{"type":324,"nodeName":337,"attributes":1476,"children":1478},{"href":1477,"class":393},"#name-whitespace",[1479],{"type":315,"textContent":130},{"type":315,"textContent":1187},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1483,"children":1485},{"id":1484},"section-3.2.1-1",[1486,1488,1492,1494],{"type":315,"textContent":1487},"\n            Whitespace between JSON tokens ",{"type":324,"nodeName":430,"attributes":1489,"children":1490},{"class":968},[1491],{"type":315,"textContent":978},{"type":315,"textContent":1493}," be emitted.",{"type":324,"nodeName":337,"attributes":1495,"children":1497},{"href":1496,"class":355},"#section-3.2.1-1",[1498],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1503,"children":1505},{"id":1504},"json.serialization.data",[1506,1507,1992],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":1508,"children":1509},{"id":134},[1510,1511,1527,1528,1539,1540,1563,1564,1585,1586,1605,1606,1628,1629,1640,1641,1699,1700,1848,1849,1991],{"type":315,"textContent":1187},{"type":324,"nodeName":1465,"attributes":1512,"children":1513},{"id":137},[1514,1515,1521,1526],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":1516,"children":1518},{"href":1517,"class":580},"#section-3.2.2",[1519],{"type":315,"textContent":1520},"3.2.2. ",{"type":324,"nodeName":337,"attributes":1522,"children":1524},{"href":1523,"class":393},"#name-serialization-of-primitive-",[1525],{"type":315,"textContent":138},{"type":315,"textContent":1187},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1529,"children":1531},{"id":1530},"section-3.2.2-1",[1532,1534],{"type":315,"textContent":1533},"\n            Assume the following JSON object is parsed:",{"type":324,"nodeName":337,"attributes":1535,"children":1537},{"href":1536,"class":355},"#section-3.2.2-1",[1538],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1541,"children":1543},{"id":1542},"section-3.2.2-2",[1544,1545,1557,1562],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1546,"children":1549},{"data-component":1547,"data-copy-mode":1548},"HorizontalScrollable","true",[1550],{"type":324,"nodeName":1551,"attributes":1552,"children":1554},"pre",{"class":1553},"sourcecode lang-json",[1555],{"type":315,"textContent":1556},"  {\n    \"numbers\": [333333333.33333329, 1E30, 4.50,\n                2e-3, 0.000000000000000000000000001],\n    \"string\": \"\\u20ac$\\u000F\\u000aA'\\u0042\\u0022\\u005c\\\\\\\"\\\u002F\",\n    \"literals\": [null, true, false]\n  }\n",{"type":324,"nodeName":337,"attributes":1558,"children":1560},{"href":1559,"class":355},"#section-3.2.2-2",[1561],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1565,"children":1567},{"id":1566},"section-3.2.2-3",[1568,1570,1573,1575,1578,1580],{"type":315,"textContent":1569},"\n            If the parsed data is subsequently serialized using a serializer\n            compliant with ECMAScript's \"JSON",{"type":324,"nodeName":440,"attributes":1571,"children":1572},{"class":1312},[],{"type":315,"textContent":1574},".stringify",{"type":324,"nodeName":440,"attributes":1576,"children":1577},{"class":1312},[],{"type":315,"textContent":1579},"()\", the result would\n            (with a line wrap added for display purposes only) be rather\n            divergent with respect to the original data:",{"type":324,"nodeName":337,"attributes":1581,"children":1583},{"href":1582,"class":355},"#section-3.2.2-3",[1584],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1587,"children":1589},{"id":1588},"section-3.2.2-4",[1590,1591,1599,1604],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1592,"children":1593},{"data-component":1547,"data-copy-mode":1548},[1594],{"type":324,"nodeName":1551,"attributes":1595,"children":1596},{"class":1553},[1597],{"type":315,"textContent":1598},"  {\"numbers\":[333333333.3333333,1e+30,4.5,0.002,1e-27],\"string\":\n  \"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"\u002F\",\"literals\":[null,true,false]}\n",{"type":324,"nodeName":337,"attributes":1600,"children":1602},{"href":1601,"class":355},"#section-3.2.2-4",[1603],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1607,"children":1609},{"id":1608},"section-3.2.2-5",[1610,1612,1621,1623],{"type":315,"textContent":1611},"\n            The reason for the difference between the parsed data and its\n            serialized counterpart is due to a wide tolerance on input data\n     (as defined\n            by JSON ",{"type":324,"nodeName":430,"attributes":1613,"children":1614},{"class":599},[1615,1616,1620],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1617,"children":1618},{"href":605,"class":606},[1619],{"type":315,"textContent":609},{"type":315,"textContent":611},{"type":315,"textContent":1622},"), while output\n     data (as defined by ECMAScript)\n            has a fixed representation.  As can be seen in the example,\n            numbers are subject to rounding as well.",{"type":324,"nodeName":337,"attributes":1624,"children":1626},{"href":1625,"class":355},"#section-3.2.2-5",[1627],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1630,"children":1632},{"id":1631},"section-3.2.2-6",[1633,1635],{"type":315,"textContent":1634},"\n            The following subsections describe the serialization of primitive\n     JSON data types\n            according to JCS.  This part is identical to that of ECMAScript.\n            In the (unlikely) event that a future version of ECMAScript would\n            invalidate any of the following serialization methods, it will be\n            up to the developer community to\n            either stick to this specification or create a new specification.",{"type":324,"nodeName":337,"attributes":1636,"children":1638},{"href":1637,"class":355},"#section-3.2.2-6",[1639],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1642,"children":1644},{"id":1643},"json.ser.literals",[1645,1646,1698],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":1647,"children":1648},{"id":143},[1649,1651,1668,1669,1697],{"type":315,"textContent":1650},"\n            ",{"type":324,"nodeName":1652,"attributes":1653,"children":1654},"h5",{"id":146},[1655,1656,1662,1667],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":1657,"children":1659},{"href":1658,"class":580},"#section-3.2.2.1",[1660],{"type":315,"textContent":1661},"3.2.2.1. ",{"type":324,"nodeName":337,"attributes":1663,"children":1665},{"href":1664,"class":393},"#name-serialization-of-literals",[1666],{"type":315,"textContent":147},{"type":315,"textContent":1650},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1670,"children":1672},{"id":1671},"section-3.2.2.1-1",[1673,1675,1684,1686,1690,1692],{"type":315,"textContent":1674},"\n              In accordance with JSON ",{"type":324,"nodeName":430,"attributes":1676,"children":1677},{"class":599},[1678,1679,1683],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1680,"children":1681},{"href":605,"class":606},[1682],{"type":315,"textContent":609},{"type":315,"textContent":611},{"type":315,"textContent":1685},", \n              the literals \"null\", \"true\", and\n              \"false\" ",{"type":324,"nodeName":430,"attributes":1687,"children":1688},{"class":968},[1689],{"type":315,"textContent":971},{"type":315,"textContent":1691}," be serialized as null, true, and\n       false, respectively.",{"type":324,"nodeName":337,"attributes":1693,"children":1695},{"href":1694,"class":355},"#section-3.2.2.1-1",[1696],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1701,"children":1703},{"id":1702},"json.ser.string",[1704,1705,1847],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":1706,"children":1707},{"id":151},[1708,1709,1725,1726,1754,1755,1810,1811,1828,1829,1846],{"type":315,"textContent":1650},{"type":324,"nodeName":1652,"attributes":1710,"children":1711},{"id":154},[1712,1713,1719,1724],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":1714,"children":1716},{"href":1715,"class":580},"#section-3.2.2.2",[1717],{"type":315,"textContent":1718},"3.2.2.2. ",{"type":324,"nodeName":337,"attributes":1720,"children":1722},{"href":1721,"class":393},"#name-serialization-of-strings",[1723],{"type":315,"textContent":155},{"type":315,"textContent":1650},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1727,"children":1729},{"id":1728},"section-3.2.2.2-1",[1730,1732,1736,1738,1747,1749],{"type":315,"textContent":1731},"\n              For JSON string data (which includes JSON object property names\n              as well), each Unicode code point ",{"type":324,"nodeName":430,"attributes":1733,"children":1734},{"class":968},[1735],{"type":315,"textContent":971},{"type":315,"textContent":1737}," be\n              serialized as described below (see Section 24.3.2.2 of ",{"type":324,"nodeName":430,"attributes":1739,"children":1740},{"class":616},[1741,1742,1746],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1743,"children":1744},{"href":621,"class":606},[1745],{"type":315,"textContent":624},{"type":315,"textContent":611},{"type":315,"textContent":1748},"):",{"type":324,"nodeName":337,"attributes":1750,"children":1752},{"href":1751,"class":355},"#section-3.2.2.2-1",[1753],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":746,"attributes":1756,"children":1757},{"class":748},[1758,1759,1783,1785,1809],{"type":315,"textContent":318},{"type":324,"nodeName":752,"attributes":1760,"children":1762},{"class":748,"id":1761},"section-3.2.2.2-2.1",[1763,1765,1769,1771,1775,1777,1782],{"type":315,"textContent":1764},"\n                If the Unicode value falls within the traditional ASCII\n                control character range (U+0000 through U+001F), it\n                ",{"type":324,"nodeName":430,"attributes":1766,"children":1767},{"class":968},[1768],{"type":315,"textContent":971},{"type":315,"textContent":1770}," be serialized using lowercase hexadecimal\n                Unicode notation (\\uhhhh) unless it is in the set of\n                predefined JSON control characters U+0008, U+0009, U+000A,\n                U+000C, or U+000D, which ",{"type":324,"nodeName":430,"attributes":1772,"children":1773},{"class":968},[1774],{"type":315,"textContent":971},{"type":315,"textContent":1776}," be serialized as\n                \\b, \\t, \\n, \\f, and \\r, respectively.",{"type":324,"nodeName":337,"attributes":1778,"children":1780},{"href":1779,"class":355},"#section-3.2.2.2-2.1",[1781],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1784},"\n              ",{"type":324,"nodeName":752,"attributes":1786,"children":1788},{"class":748,"id":1787},"section-3.2.2.2-2.2",[1789,1791,1795,1797,1801,1803,1808],{"type":315,"textContent":1790},"\n                If the Unicode value is outside of the ASCII control character\n                range, it ",{"type":324,"nodeName":430,"attributes":1792,"children":1793},{"class":968},[1794],{"type":315,"textContent":971},{"type":315,"textContent":1796}," be serialized \"as is\"\n                unless it is equivalent to U+005C (\\) or U+0022 (\"),\n                which ",{"type":324,"nodeName":430,"attributes":1798,"children":1799},{"class":968},[1800],{"type":315,"textContent":971},{"type":315,"textContent":1802}," be serialized as \\\\ and \\\",\n                respectively.",{"type":324,"nodeName":337,"attributes":1804,"children":1806},{"href":1805,"class":355},"#section-3.2.2.2-2.2",[1807],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1650},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1812,"children":1814},{"id":1813},"section-3.2.2.2-3",[1815,1817,1821,1823],{"type":315,"textContent":1816},"\n              Finally, the resulting sequence of Unicode code points\n       ",{"type":324,"nodeName":430,"attributes":1818,"children":1819},{"class":968},[1820],{"type":315,"textContent":971},{"type":315,"textContent":1822}," be enclosed in double quotes (\").",{"type":324,"nodeName":337,"attributes":1824,"children":1826},{"href":1825,"class":355},"#section-3.2.2.2-3",[1827],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1830,"children":1832},{"id":1831},"section-3.2.2.2-4",[1833,1835,1839,1841],{"type":315,"textContent":1834},"\n              Note: Since invalid Unicode data like \"lone surrogates\" (e.g.,\n       U+DEAD)\n              may lead to interoperability issues including broken signatures,\n              occurrences of such data ",{"type":324,"nodeName":430,"attributes":1836,"children":1837},{"class":968},[1838],{"type":315,"textContent":971},{"type":315,"textContent":1840}," cause a compliant\n       JCS implementation to terminate\n              with an appropriate error.",{"type":324,"nodeName":337,"attributes":1842,"children":1844},{"href":1843,"class":355},"#section-3.2.2.2-4",[1845],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1850,"children":1852},{"id":1851},"json.ser.number",[1853,1854,1990],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":1855,"children":1856},{"id":159},[1857,1858,1874,1875,1919,1920,1971,1972,1989],{"type":315,"textContent":1650},{"type":324,"nodeName":1652,"attributes":1859,"children":1860},{"id":162},[1861,1862,1868,1873],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":1863,"children":1865},{"href":1864,"class":580},"#section-3.2.2.3",[1866],{"type":315,"textContent":1867},"3.2.2.3. ",{"type":324,"nodeName":337,"attributes":1869,"children":1871},{"href":1870,"class":393},"#name-serialization-of-numbers",[1872],{"type":315,"textContent":163},{"type":315,"textContent":1650},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1876,"children":1878},{"id":1877},"section-3.2.2.3-1",[1879,1881,1890,1892,1895,1897,1901,1903,1912,1914],{"type":315,"textContent":1880},"\n              ECMAScript builds on the IEEE 754 ",{"type":324,"nodeName":430,"attributes":1882,"children":1883},{"class":599},[1884,1885,1889],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1886,"children":1887},{"href":1303,"class":606},[1888],{"type":315,"textContent":1306},{"type":315,"textContent":611},{"type":315,"textContent":1891}," double-",{"type":324,"nodeName":440,"attributes":1893,"children":1894},{"class":1312},[],{"type":315,"textContent":1896},"precision standard for representing\n              JSON number data.  Such data ",{"type":324,"nodeName":430,"attributes":1898,"children":1899},{"class":968},[1900],{"type":315,"textContent":971},{"type":315,"textContent":1902}," be serialized\n              according to Section 7.1.12.1 of ",{"type":324,"nodeName":430,"attributes":1904,"children":1905},{"class":616},[1906,1907,1911],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1908,"children":1909},{"href":621,"class":606},[1910],{"type":315,"textContent":624},{"type":315,"textContent":611},{"type":315,"textContent":1913},", including the \"Note 2\" enhancement.",{"type":324,"nodeName":337,"attributes":1915,"children":1917},{"href":1916,"class":355},"#section-3.2.2.3-1",[1918],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1921,"children":1923},{"id":1922},"section-3.2.2.3-2",[1924,1926,1938,1940,1951,1953,1957,1959,1964,1966],{"type":315,"textContent":1925},"\n              Due to the relative complexity of this part, the algorithm \n              itself is not included in this document.\n              For implementers of JCS-compliant number serialization,\n              Google's implementation in V8 ",{"type":324,"nodeName":430,"attributes":1927,"children":1929},{"class":1928},"reference-citation wordsize-4",[1930,1931,1937],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1932,"children":1934},{"href":1933,"class":606},"#V8",[1935],{"type":315,"textContent":1936},"V8",{"type":315,"textContent":611},{"type":315,"textContent":1939}," may serve as a reference.\n              Another compatible number serialization reference implementation\n              is Ryu ",{"type":324,"nodeName":430,"attributes":1941,"children":1942},{"class":1928},[1943,1944,1950],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":1945,"children":1947},{"href":1946,"class":606},"#RYU",[1948],{"type":315,"textContent":1949},"RYU",{"type":315,"textContent":611},{"type":315,"textContent":1952},",\n              which is used by the JCS open-source Java implementation \n              mentioned in ",{"type":324,"nodeName":337,"attributes":1954,"children":1955},{"href":828,"class":606},[1956],{"type":315,"textContent":282},{"type":315,"textContent":1958},".\n              ",{"type":324,"nodeName":337,"attributes":1960,"children":1962},{"href":1961,"class":606},"#json.ieee754.test",[1963],{"type":315,"textContent":233},{"type":315,"textContent":1965}," holds a set\n             of IEEE 754 sample values and their\n              corresponding JSON serialization.",{"type":324,"nodeName":337,"attributes":1967,"children":1969},{"href":1968,"class":355},"#section-3.2.2.3-2",[1970],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":1973,"children":1975},{"id":1974},"section-3.2.2.3-3",[1976,1978,1982,1984],{"type":315,"textContent":1977},"\n              Note: Since Not a Number (NaN) and Infinity\n              are not permitted in JSON, occurrences of NaN or\n              Infinity ",{"type":324,"nodeName":430,"attributes":1979,"children":1980},{"class":968},[1981],{"type":315,"textContent":971},{"type":315,"textContent":1983}," cause a compliant JCS\n              implementation to terminate with an appropriate error.",{"type":324,"nodeName":337,"attributes":1985,"children":1987},{"href":1986,"class":355},"#section-3.2.2.3-3",[1988],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":1995,"children":1997},{"id":1996},"json.sorting.properties",[1998,1999,2360],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":2000,"children":2001},{"id":167},[2002,2003,2019,2020,2031,2032,2051,2052,2071,2072,2083,2084,2144,2145,2162,2163,2255,2256,2283,2284,2295,2296,2315,2316,2327,2328,2347,2348,2359],{"type":315,"textContent":1187},{"type":324,"nodeName":1465,"attributes":2004,"children":2005},{"id":170},[2006,2007,2013,2018],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":2008,"children":2010},{"href":2009,"class":580},"#section-3.2.3",[2011],{"type":315,"textContent":2012},"3.2.3. ",{"type":324,"nodeName":337,"attributes":2014,"children":2016},{"href":2015,"class":393},"#name-sorting-of-object-propertie",[2017],{"type":315,"textContent":171},{"type":315,"textContent":1187},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2021,"children":2023},{"id":2022},"section-3.2.3-1",[2024,2026],{"type":315,"textContent":2025},"\n            Although the previous step normalized the representation of\n            primitive JSON data types, the result would not yet qualify as\n            \"canonical\" since JSON object properties are not in lexicographic\n            (alphabetical) order.",{"type":324,"nodeName":337,"attributes":2027,"children":2029},{"href":2028,"class":355},"#section-3.2.3-1",[2030],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2033,"children":2035},{"id":2034},"section-3.2.3-2",[2036,2038,2044,2046],{"type":315,"textContent":2037},"\n            Applied to the sample in ",{"type":324,"nodeName":337,"attributes":2039,"children":2041},{"href":2040,"class":606},"#json.serialization.data",[2042],{"type":315,"textContent":2043},"Section 3.2.2",{"type":315,"textContent":2045},",\n            a properly canonicalized version should (with a\n            line wrap added for display purposes only) read as:",{"type":324,"nodeName":337,"attributes":2047,"children":2049},{"href":2048,"class":355},"#section-3.2.3-2",[2050],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2053,"children":2055},{"id":2054},"section-3.2.3-3",[2056,2057,2065,2070],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2058,"children":2059},{"data-component":1547,"data-copy-mode":1548},[2060],{"type":324,"nodeName":1551,"attributes":2061,"children":2062},{"class":1553},[2063],{"type":315,"textContent":2064},"  {\"literals\":[null,true,false],\"numbers\":[333333333.3333333,\n  1e+30,4.5,0.002,1e-27],\"string\":\"€$\\u000f\\nA'B\\\"\\\\\\\\\\\"\u002F\"}\n",{"type":324,"nodeName":337,"attributes":2066,"children":2068},{"href":2067,"class":355},"#section-3.2.3-3",[2069],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2073,"children":2075},{"id":2074},"section-3.2.3-4",[2076,2078],{"type":315,"textContent":2077},"\n            The rules for lexicographic sorting of JSON object\n            properties according to JCS are as follows:",{"type":324,"nodeName":337,"attributes":2079,"children":2081},{"href":2080,"class":355},"#section-3.2.3-4",[2082],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":746,"attributes":2085,"children":2086},{"class":748},[2087,2088,2112,2113,2143],{"type":315,"textContent":318},{"type":324,"nodeName":752,"attributes":2089,"children":2091},{"class":748,"id":2090},"section-3.2.3-5.1",[2092,2094,2098,2100,2104,2106,2111],{"type":315,"textContent":2093},"\n                JSON object properties ",{"type":324,"nodeName":430,"attributes":2095,"children":2096},{"class":968},[2097],{"type":315,"textContent":971},{"type":315,"textContent":2099}," be sorted\n recursively,\n                which means that JSON child Objects\n                ",{"type":324,"nodeName":430,"attributes":2101,"children":2102},{"class":968},[2103],{"type":315,"textContent":971},{"type":315,"textContent":2105}," have their properties sorted as well.",{"type":324,"nodeName":337,"attributes":2107,"children":2109},{"href":2108,"class":355},"#section-3.2.3-5.1",[2110],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1650},{"type":324,"nodeName":752,"attributes":2114,"children":2116},{"class":748,"id":2115},"section-3.2.3-5.2",[2117,2119,2123,2125,2129,2131,2135,2137,2142],{"type":315,"textContent":2118},"\n              JSON array data ",{"type":324,"nodeName":430,"attributes":2120,"children":2121},{"class":968},[2122],{"type":315,"textContent":971},{"type":315,"textContent":2124}," also be scanned for the\n              presence of JSON objects (if an object is found, then its\n       properties ",{"type":324,"nodeName":430,"attributes":2126,"children":2127},{"class":968},[2128],{"type":315,"textContent":971},{"type":315,"textContent":2130}," be sorted),\n              but array element order ",{"type":324,"nodeName":430,"attributes":2132,"children":2133},{"class":968},[2134],{"type":315,"textContent":978},{"type":315,"textContent":2136}," be changed.",{"type":324,"nodeName":337,"attributes":2138,"children":2140},{"href":2139,"class":355},"#section-3.2.3-5.2",[2141],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1187},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2146,"children":2148},{"id":2147},"section-3.2.3-6",[2149,2151,2155,2157],{"type":315,"textContent":2150},"\n            When a JSON object is about to have its properties\n            sorted, the following measures ",{"type":324,"nodeName":430,"attributes":2152,"children":2153},{"class":968},[2154],{"type":315,"textContent":971},{"type":315,"textContent":2156}," be adhered to:",{"type":324,"nodeName":337,"attributes":2158,"children":2160},{"href":2159,"class":355},"#section-3.2.3-6",[2161],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":746,"attributes":2164,"children":2165},{"class":748},[2166,2167,2179,2180,2203,2204,2254],{"type":315,"textContent":318},{"type":324,"nodeName":752,"attributes":2168,"children":2170},{"class":748,"id":2169},"section-3.2.3-7.1",[2171,2173,2178],{"type":315,"textContent":2172},"\n              The sorting process is applied to property name strings in their\n       \"raw\" (unescaped) form.\n              That is, a newline character is treated as U+000A.",{"type":324,"nodeName":337,"attributes":2174,"children":2176},{"href":2175,"class":355},"#section-3.2.3-7.1",[2177],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1650},{"type":324,"nodeName":752,"attributes":2181,"children":2183},{"class":748,"id":2182},"section-3.2.3-7.2",[2184,2186,2195,2197,2202],{"type":315,"textContent":2185},"\n              Property name strings to be sorted are formatted\n              as arrays of UTF-16 ",{"type":324,"nodeName":430,"attributes":2187,"children":2188},{"class":599},[2189,2190,2194],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":2191,"children":2192},{"href":1272,"class":606},[2193],{"type":315,"textContent":1275},{"type":315,"textContent":611},{"type":315,"textContent":2196},"\n       code units.\n              The sorting is based on pure value comparisons, where code units\n       are treated as\n              unsigned integers, independent of locale settings.",{"type":324,"nodeName":337,"attributes":2198,"children":2200},{"href":2199,"class":355},"#section-3.2.3-7.2",[2201],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":1650},{"type":324,"nodeName":752,"attributes":2205,"children":2207},{"class":748,"id":2206},"section-3.2.3-7.3",[2208,2209,2220,2221,2232,2233,2253],{"type":315,"textContent":1784},{"type":324,"nodeName":346,"attributes":2210,"children":2212},{"id":2211},"section-3.2.3-7.3.1",[2213,2215],{"type":315,"textContent":2214},"\n                Property name strings either have different values at some\n index that is\n                a valid index for both strings, or their lengths are\n different, or both.\n                If they have different values at one or more index\n                positions, let k be the smallest such index; then, the string\n whose\n                value at position k has the smaller value, as determined by\n using\n                the \"\u003C\" operator, lexicographically precedes the other\n string.\n                If there is no index position at which they differ,\n                then the shorter string lexicographically precedes the longer\n string.",{"type":324,"nodeName":337,"attributes":2216,"children":2218},{"href":2217,"class":355},"#section-3.2.3-7.3.1",[2219],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2222,"children":2224},{"id":2223},"section-3.2.3-7.3.2",[2225,2227],{"type":315,"textContent":2226},"\n                In plain English, this means that property names are sorted in\n ascending order like the following:",{"type":324,"nodeName":337,"attributes":2228,"children":2230},{"href":2229,"class":355},"#section-3.2.3-7.3.2",[2231],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2234,"children":2237},{"class":2235,"id":2236},"artwork art-text alignLeft art-ascii-art","section-3.2.3-7.3.3",[2238,2239,2247,2252],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2240,"children":2241},{"data-component":1547,"data-copy-mode":1548},[2242],{"type":324,"nodeName":1551,"attributes":2243,"children":2244},{},[2245],{"type":315,"textContent":2246},"        \"\"\n        \"a\"\n        \"aa\"\n        \"ab\"\n",{"type":324,"nodeName":337,"attributes":2248,"children":2250},{"href":2249,"class":355},"#section-3.2.3-7.3.3",[2251],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":1187},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2257,"children":2259},{"id":2258},"section-3.2.3-8",[2260,2262,2266,2268,2277,2278],{"type":315,"textContent":2261},"\n            The rationale for basing the sorting algorithm on UTF-16 code\n     units is that\n            it maps directly to the string type in ECMAScript (featured in web\n     browsers\n            and Node",{"type":324,"nodeName":440,"attributes":2263,"children":2265},{"class":2264},"wordsize-6",[],{"type":315,"textContent":2267},".js), Java, and .NET.  In addition, JSON only supports\n     escape sequences\n            expressed as UTF-16 code units, making knowledge and handling of\n     such data\n            a necessity anyway.\n            Systems using another internal representation of string data will\n     need to convert\n            JSON property name strings into arrays of UTF-16 code units before\n     sorting.\n            The conversion from UTF-8 or UTF-32 to UTF-16 is defined by the\n            Unicode ",{"type":324,"nodeName":430,"attributes":2269,"children":2270},{"class":599},[2271,2272,2276],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":2273,"children":2274},{"href":1272,"class":606},[2275],{"type":315,"textContent":1275},{"type":315,"textContent":611},{"type":315,"textContent":691},{"type":324,"nodeName":337,"attributes":2279,"children":2281},{"href":2280,"class":355},"#section-3.2.3-8",[2282],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2285,"children":2287},{"id":2286},"section-3.2.3-9",[2288,2290],{"type":315,"textContent":2289},"\n   The following JSON test data can be used for verifying the correctness of\n   the sorting scheme in a JCS implementation:",{"type":324,"nodeName":337,"attributes":2291,"children":2293},{"href":2292,"class":355},"#section-3.2.3-9",[2294],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2297,"children":2299},{"id":2298},"section-3.2.3-10",[2300,2301,2309,2314],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2302,"children":2303},{"data-component":1547,"data-copy-mode":1548},[2304],{"type":324,"nodeName":1551,"attributes":2305,"children":2306},{"class":1553},[2307],{"type":315,"textContent":2308},"  {\n    \"\\u20ac\": \"Euro Sign\",\n    \"\\r\": \"Carriage Return\",\n    \"\\ufb33\": \"Hebrew Letter Dalet With Dagesh\",\n    \"1\": \"One\",\n    \"\\ud83d\\ude00\": \"Emoji: Grinning Face\",\n    \"\\u0080\": \"Control\",\n    \"\\u00f6\": \"Latin Small Letter O With Diaeresis\"\n  }\n",{"type":324,"nodeName":337,"attributes":2310,"children":2312},{"href":2311,"class":355},"#section-3.2.3-10",[2313],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2317,"children":2319},{"id":2318},"section-3.2.3-11",[2320,2322],{"type":315,"textContent":2321},"\n            Expected argument order after sorting property strings:",{"type":324,"nodeName":337,"attributes":2323,"children":2325},{"href":2324,"class":355},"#section-3.2.3-11",[2326],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2329,"children":2331},{"class":2235,"id":2330},"section-3.2.3-12",[2332,2333,2341,2346],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2334,"children":2335},{"data-component":1547,"data-copy-mode":1548},[2336],{"type":324,"nodeName":1551,"attributes":2337,"children":2338},{},[2339],{"type":315,"textContent":2340},"  \"Carriage Return\"\n  \"One\"\n  \"Control\"\n  \"Latin Small Letter O With Diaeresis\"\n  \"Euro Sign\"\n  \"Emoji: Grinning Face\"\n  \"Hebrew Letter Dalet With Dagesh\"",{"type":324,"nodeName":337,"attributes":2342,"children":2344},{"href":2343,"class":355},"#section-3.2.3-12",[2345],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2349,"children":2351},{"id":2350},"section-3.2.3-13",[2352,2354],{"type":315,"textContent":2353},"\n            Note: For the purpose of obtaining a deterministic property order,\n            sorting of data encoded in UTF-8 or UTF-32 would also work, but\n            the outcome for JSON data like above would differ and thus be\n            incompatible with this specification.\n\n            However, in practice, property names are rarely defined outside of\n            7-bit ASCII, making it possible to sort string data in UTF-8 or\n            UTF-32 format without conversion to UTF-16 and still be compatible\n            with JCS.  Whether or not this is a viable option depends on the\n            environment JCS is used in.",{"type":324,"nodeName":337,"attributes":2355,"children":2357},{"href":2356,"class":355},"#section-3.2.3-13",[2358],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2363,"children":2365},{"id":2364},"json.utf8",[2366,2367,2463],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":2368,"children":2369},{"id":175},[2370,2371,2387,2388,2411,2412,2430,2431,2450,2451,2462],{"type":315,"textContent":1187},{"type":324,"nodeName":1465,"attributes":2372,"children":2373},{"id":178},[2374,2375,2381,2386],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":2376,"children":2378},{"href":2377,"class":580},"#section-3.2.4",[2379],{"type":315,"textContent":2380},"3.2.4. ",{"type":324,"nodeName":337,"attributes":2382,"children":2384},{"href":2383,"class":393},"#name-utf-8-generation",[2385],{"type":315,"textContent":179},{"type":315,"textContent":1187},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2389,"children":2391},{"id":2390},"section-3.2.4-1",[2392,2394,2398,2400,2404,2406],{"type":315,"textContent":2393},"\n            Finally, in order to create a platform-",{"type":324,"nodeName":440,"attributes":2395,"children":2397},{"class":2396},"wordsize-12",[],{"type":315,"textContent":2399},"independent representation,\n            the result of the preceding step ",{"type":324,"nodeName":430,"attributes":2401,"children":2402},{"class":968},[2403],{"type":315,"textContent":971},{"type":315,"textContent":2405}," be encoded in\n     UTF-8.",{"type":324,"nodeName":337,"attributes":2407,"children":2409},{"href":2408,"class":355},"#section-3.2.4-1",[2410],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2413,"children":2415},{"id":2414},"section-3.2.4-2",[2416,2417,2423,2425],{"type":315,"textContent":2037},{"type":324,"nodeName":337,"attributes":2418,"children":2420},{"href":2419,"class":606},"#json.sorting.properties",[2421],{"type":315,"textContent":2422},"Section 3.2.3",{"type":315,"textContent":2424},", this\n            should yield the following bytes, here shown in hexadecimal\n     notation:",{"type":324,"nodeName":337,"attributes":2426,"children":2428},{"href":2427,"class":355},"#section-3.2.4-2",[2429],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2432,"children":2434},{"class":2235,"id":2433},"section-3.2.4-3",[2435,2436,2444,2449],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2437,"children":2438},{"data-component":1547,"data-copy-mode":1548},[2439],{"type":324,"nodeName":1551,"attributes":2440,"children":2441},{},[2442],{"type":315,"textContent":2443},"  7b 22 6c 69 74 65 72 61 6c 73 22 3a 5b 6e 75 6c 6c 2c 74 72\n  75 65 2c 66 61 6c 73 65 5d 2c 22 6e 75 6d 62 65 72 73 22 3a\n  5b 33 33 33 33 33 33 33 33 33 2e 33 33 33 33 33 33 33 2c 31\n  65 2b 33 30 2c 34 2e 35 2c 30 2e 30 30 32 2c 31 65 2d 32 37\n  5d 2c 22 73 74 72 69 6e 67 22 3a 22 e2 82 ac 24 5c 75 30 30\n  30 66 5c 6e 41 27 42 5c 22 5c 5c 5c 5c 5c 22 2f 22 7d",{"type":324,"nodeName":337,"attributes":2445,"children":2447},{"href":2446,"class":355},"#section-3.2.4-3",[2448],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":2452,"children":2454},{"id":2453},"section-3.2.4-4",[2455,2457],{"type":315,"textContent":2456},"\n            This data is intended to be usable as input to cryptographic\n     methods.",{"type":324,"nodeName":337,"attributes":2458,"children":2460},{"href":2459,"class":355},"#section-3.2.4-4",[2461],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":2470,"children":2472},{"id":2471},"IANA",[2473,2474,2507],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":2475,"children":2476},{"id":183},[2477,2478,2494,2495,2506],{"type":315,"textContent":330},{"type":324,"nodeNam