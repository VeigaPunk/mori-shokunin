"nodeName":440,"attributes":7731,"children":7732},{"class":2396},[],{"type":315,"textContent":3998},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":7739},"\n\n\n\n",{"max":7741},69,[7743,7752],{"errata_id":7744,"doc-id":7745,"errata_status_code":7746,"errata_type_code":7747,"section":152,"orig_text":7748,"correct_text":7749,"notes":21,"submit_date":7750,"update_date":7751},"6292","RFC8785","Verified","Editorial","see Section 24.3.2.2 of [ECMA-262]","see Section 24.5.2.2 of [ECMA-262]","2020-09-20","2020-09-22 21:42:14",{"errata_id":7753,"doc-id":7745,"errata_status_code":7746,"errata_type_code":7754,"section":192,"orig_text":7755,"correct_text":7756,"notes":7757,"submit_date":7758,"update_date":7759},"7920","Technical","\u003Cend of section>","Since -0 is a valid JSON Number but is serialized as 0, a JSON\r\nparser following this specification SHOULD generate an error\r\ncondition (which in turn SHOULD stop processing) when it\r\nencounters -0, in order to thwart potential attacks on not yet\r\nparsed data. ","IEEE 754 includes as distinct values both positive and negative\r\nzero. Section 7.1.12.1 of ECMA-262 says: If m is +0 or -0, return\r\nthe String \"0\".  This may lend itself to erroneous input to \r\nsupporting functions. ","2024-05-02","2024-05-15 09:58:52","2026-10-08T15:35:19.636Z",["Reactive",7762],{"$scolor-mode":7763},{"preference":7764,"value":7764,"unknown":7765,"forced":17},"system",true,["Set"],["ShallowReactive",7768],{"info-buckethtmldocument-rfc8785":-1},"\u002Finfo\u002Frfc8785\u002F",["Reactive",7771],{"auth":7772,"notifications":7779,"uiSettings":7784,"reefSurveys":7796,"reef":7803,"hasTouch":7829},{"hasCheckedAuth":7773,"isAuthenticated":7775,"user":7776,"returnTo":7778},["EmptyRef",7774],"false",["EmptyRef",7774],["EmptyRef",7777],"_",["EmptyRef",7777],{"queue":7780,"dismissedIds":7783},["Ref",7781],["Reactive",7782],[],["skipHydrate",73],{