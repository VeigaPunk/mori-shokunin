",[7254],{"type":315,"textContent":7255},"James Manger",{"type":315,"textContent":7257},". This\n ultimately led to the\n        adoption of the entire ECMAScript serialization scheme for JSON\n primitives.",{"type":324,"nodeName":337,"attributes":7259,"children":7261},{"href":7260,"class":355},"#section-appendix.j-1",[7262],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":7265,"children":7267},{"id":7266},"section-appendix.j-2",[7268,7270,7275,7277,7282,7283,7288,7289,7294,7295,7300,7301,7306,7307,7312,7313,7318,7319,7324,7325,7330,7331,7336,7337,7342,7343,7348,7349,7354,7355,7360,7362,7367,7368],{"type":315,"textContent":7269},"\n        Other people who have contributed with valuable input to this\n specification include\n        ",{"type":324,"nodeName":430,"attributes":7271,"children":7272},{"class":7252},[7273],{"type":315,"textContent":7274},"Scott Ananian",{"type":315,"textContent":7276},",\n        ",{"type":324,"nodeName":430,"attributes":7278,"children":7279},{"class":7252},[7280],{"type":315,"textContent":7281},"Tim Bray",{"type":315,"textContent":7276},{"type":324,"nodeName":430,"attributes":7284,"children":7285},{"class":7252},[7286],{"type":315,"textContent":7287},"Ben Campbell",{"type":315,"textContent":7276},{"type":324,"nodeName":430,"attributes":7290,"children":7291},{"class":7252},[7292],{"type":315,"textContent":7293},"Adrian Farell",{"type":315,"textContent":7276},{"type":324,"nodeName":430,"attributes":7296,"children":7297},{"class":7252},[7298],{"type":315,"textContent":7299},"Richard Gibson",{"type":315,"textContent":7276},{"type":324,"nodeName":430,"attributes":7302,"children":7303},{"class":7252},[7304],{"type":315,"textContent":7305},"Bron Gondwana",{"type":315,"textContent":7276},{"type":324,"nodeName":430,"attributes":7308,"children":7309},{"class":7252},[7310],{"type":315,"textContent":7311},"John-Mark Gurney",{"type":315,"textContent":7276},{"type":324,"nodeName":430,"attributes":73