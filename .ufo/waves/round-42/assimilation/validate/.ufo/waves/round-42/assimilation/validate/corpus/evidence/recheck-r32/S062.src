</section>
<section id="section-6.2">
        <h3 id="name-informative-references">
<a href="#section-6.2" data-is-hyperlink data-non-rfc-anchor-link class="section-number selfRef"><!--[--><!--[-->6.2. <!--]--><!--]--></a><a href="#name-informative-references" data-is-hyperlink data-non-rfc-anchor-link class="section-name selfRef"><!--[--><!--[-->Informative References<!--]--><!--]--></a>
        </h3>
<dl class="references">
<dt id="I-D.rundgren-comparable-json">[JSONCOMP]</dt>
        <dd>
