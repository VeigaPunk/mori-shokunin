<dd class="break"></dd>
<dt id="KEYBASE">[KEYBASE]</dt>
        <dd>
<span class="refAuthor">Keybase</span>, <span class="refTitle">&quot;Canonical Packings for JSON and Msgpack&quot;</span>, <span>&lt;<a href="https://keybase.io/docs/api/1.0/canonical_packings" rel="noopener" target="_blank" data-is-hyperlink data-non-rfc-anchor-link><!--[--><!--[-->https://<wbr class="wordsize-wide">keybase<wbr class="wordsize-wide">.io<wbr class="wordsize-wide">/docs<wbr class="wordsize-wide">/api/1.0<wbr class="wordsize-wide">/canonical_<wbr class="wordsize-wide">packings<!--]--><!--]--></a>&gt;</span>. </dd>
