4101},"https:\u002F\u002Fwww.w3.org\u002FTR\u002Fxmldsig-core1\u002F",[4103,4104,4107,4108,4111,4113,4116,4117,4120,4122,4125,4127,4130],{"type":315,"textContent":438},{"type":324,"nodeName":440,"attributes":4105,"children":4106},{"class":442},[],{"type":315,"textContent":445},{"type":324,"nodeName":440,"attributes":4109,"children":4110},{"class":442},[],{"type":315,"textContent":4112},".w3",{"type":324,"nodeName":440,"attributes":4114,"children":4115},{"class":442},[],{"type":315,"textContent":460},{"type":324,"nodeName":440,"attributes":4118,"children":4119},{"class":442},[],{"type":315,"textContent":4121},"\u002FTR",{"type":324,"nodeName":440,"attributes":4123,"children":4124},{"class":442},[],{"type":315,"textContent":4126},"\u002Fxmldsig-",{"type":324,"nodeName":440,"attributes":4128,"children":4129},{"class":442},[],{"type":315,"textContent":4131},"core1\u002F",{"type":315,"textContent":2784},{"type":315,"textContent":2786},{"type":315,"textContent":318},{"type":324,"nodeName":2694,"attributes":4136,"children":4137},{"class":2790},[],{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":4143,"children":4145},{"id":4144},"canonicalize.js",[4146,4147,4206],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":4148,"children":4149},{"id":224},[4150,4151,4167,4168,4184,4185,4205],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":4152,"children":4153},{"id":227},[4154,4155,4161,4166],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":4156,"children":4158},{"href":4157,"class":580},"#section-appendix.a",[4159],{"type":315,"textContent":4160},"Appendix A. ",{"type":324,"nodeName":337,"attributes":4162,"children":4164},{"href":4163,"class":393},"#name-ecmascript-sample-canonical",[4165],{"type":315,"textContent":228},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":4169,"children":4171},{"id":4170},"section-appendix.a-1",[4172,4174,4177,4179],{"type":315,"textContent":4173},"\n        Below is an example of a JCS canonicalizer for usage with\n ECMAScript-",{"type":324,"nodeName":440,"attributes":4175,"children":4176},{"class":1312},[],{"type":315,"textContent":4178},"based systems:",{"type":324,"nodeName":337,"attributes":4180,"children":4182},{"href":4181,"class":355},"#section-appendix.a-1",[4183],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":4186,"children":4188},{"id":4187},"section-appendix.a-2",[4189,4190,4199,4204],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":4191,"children":4192},{"data-component":1547,"data-copy-mode":1548},[4193],{"type":324,"nodeName":1551,"attributes":4194,"children":4196},{"class":4195},"sourcecode lang-javascript",[4197],{"type":315,"textContent":4198},"  \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n  \u002F\u002F Since the primary purpose of this code is highlighting \u002F\u002F\n  \u002F\u002F the core of the JCS algorithm, error handling and      \u002F\u002F\n  \u002F\u002F UTF-8 generation were not implemented.                 \u002F\u002F\n  \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n  var canonicalize = function(object) {\n\n      var buffer = '';\n      serialize(object);\n      return buffer;\n\n      function serialize(object) {\n          if (object === null || typeof object !== 'object' ||\n              object.toJSON != null) {\n              \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n              \u002F\u002F Primitive type or toJSON, use \"JSON\"        \u002F\u002F\n              \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n              buffer += JSON.stringify(object);\n\n          } else if (Array.isArray(object)) {\n              \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n              \u002F\u002F Array - Maintain element order              \u002F\u002F\n              \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n              buffer += '[';\n              let next = false;\n              object.forEach((element) => {\n                  if (next) {\n                      buffer += ',';\n                  }\n                  next = true;\n                  \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n                  \u002F\u002F Array element - Recursive expansion \u002F\u002F\n                  \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n                  serialize(element);\n              });\n              buffer += ']';\n\n          } else {\n              \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n              \u002F\u002F Object - Sort properties before serializing \u002F\u002F\n              \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n              buffer += '{';\n              let next = false;\n              Object.keys(object).sort().forEach((property) => {\n                  if (next) {\n                      buffer += ',';\n                  }\n                  next = true;\n                  \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n                  \u002F\u002F Property names are strings, use \"JSON\"  \u002F\u002F\n                  \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n                  buffer += JSON.stringify(property);\n                  buffer += ':';\n                  \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n                  \u002F\u002F Property value - Recursive expansion \u002F\u002F\n                  \u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\u002F\n                  serialize(object[property]);\n              });\n              buffer += '}';\n          }\n      }\n  };\n",{"type":324,"nodeName":337,"attributes":4200,"children":4202},{"href":4201,"class":355},"#section-appendix.a-2",[4203],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":4209,"children":4211},{"id":4210},"json.ieee754.test",[4212,4213,5630],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":4214,"children":4215},{"id":232},[4216,4217,4233,4234,4266,4267,4271,5446,5447,5458,5459,5462,5599,5600,5629],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":4218,"children":4219},{"id":235},[4220,4221,4227,4232],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":4222,"children":4224},{"href":4223,"class":580},"#section-appendix.b",[4225],{"type":315,"textContent":4226},"Appendix B. ",{"type":324,"nodeName":337,"attributes":4228,"children":4230},{"href":4229,"class":393},"#name-number-serialization-sample",[4231],{"type":315,"textContent":236},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":4235,"children":4237},{"id":4236},"section-appendix.b-1",[4238,4240,4243,4245,4254,4256,4259,4261],{"type":315,"textContent":4239},"\n        The following table holds a set of ECMAScript-",{"type":324,"nodeName":440,"attributes":4241,"children":4242},{"class":2829},[],{"type":315,"textContent":4244},"compatible number\n serialization samples,\n        including some edge cases.  The column\n        \"IEEE 754\" refers to the internal\n        ECMAScript representation of the \"Number\" data type, which is based on\n the\n        IEEE 754 ",{"type":324,"nodeName":430,"attributes":4246,"children":4247},{"class":599},[4248,4249,4253],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":4250,"children":4251},{"href":1303,"class":606},[4252],{"type":315,"textContent":1306},{"type":315,"textContent":611},{"type":315,"textContent":4255}," standard using\n 64-bit (double-",{"type":324,"nodeName":440,"attributes":4257,"children":4258},{"class":1312},[],{"type":315,"textContent":4260},"precision) values,\n        here expressed in hexadecimal.",{"type":324,"nodeName":337,"attributes":4262,"children":4264},{"href":4263,"class":355},"#section-appendix.b-1",[4265],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":430,"attributes":4268,"children":4270},{"id":4269},"name-ecmascript-compatible-json-",[],{"type":324,"nodeName":374,"attributes":4272,"children":4274},{"id":4273},"ECMAScript-TABLE",[4275,4276,5445],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":4277,"children":4278},{"data-component":1547,"data-copy-mode":1548},[4279],{"type":324,"nodeName":4280,"attributes":4281,"children":4284},"table",{"class":4282,"id":4283},"center","table-1",[4285,4286,4311,43