me":430,"attributes":5460,"children":5461},{"class":2790},[],{"type":324,"nodeName":2681,"attributes":5463,"children":5466},{"class":5464,"id":5465},"olPercent","section-appendix.b-4",[5467,5468,5473,5474,5502,5503,5506,5507,5512,5513,5525,5526,5529,5530,5535,5536,5555,5556,5559,5560,5565,5566,5594,5595,5598],{"type":315,"textContent":384},{"type":324,"nodeName":2687,"attributes":5469,"children":5470},{},[5471],{"type":315,"textContent":5472},"(1)",{"type":315,"textContent":318},{"type":324,"nodeName":2694,"attributes":5475,"children":5477},{"id":5476},"section-appendix.b-4.1",[5478,5480,5484,5486,5489,5491,5494,5496,5501],{"type":315,"textContent":5479},"\n          For maximum compliance with the ECMAScript \"JSON\" object,\n          values that are to be interpreted as true integers\n          ",{"type":324,"nodeName":430,"attributes":5481,"children":5482},{"class":968},[5483],{"type":315,"textContent":1003},{"type":315,"textContent":5485}," be in the range -90071992",{"type":324,"nodeName":440,"attributes":5487,"children":5488},{"class":2396},[],{"type":315,"textContent":5490},"54740991 to\n   90071992",{"type":324,"nodeName":440,"attributes":5492,"children":5493},{"class":2396},[],{"type":315,"textContent":5495},"54740991.\n          However, how numbers are used in applications does not affect the\n   JCS algorithm.",{"type":324,"nodeName":337,"attributes":5497,"children":5499},{"href":5498,"class":355},"#section-appendix.b-4.1",[5500],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":2694,"attributes":5504,"children":5505},{"class":2790},[],{"type":315,"textContent":318},{"type":324,"nodeName":2687,"attributes":5508,"children":5509},{},[5510],{"type":315,"textContent":5511},"(2)",{"type":315,"textContent":318},{"type":324,"nodeName":2694,"attributes":5514,"children":5516},{"id":5515},"section-appendix.b-4.2",[5517,5519,5524],{"type":315,"textContent":5518},"\n          Although a set of specific integers like 2**68 could be regarded as\n   having\n          extended precision, the JCS\u002FECMAScript number serialization\n          algorithm does not take this into consideration.",{"type":324,"nodeName":337,"attributes":5520,"children":5522},{"href":5521,"class":355},"#section-appendix.b-4.2",[5523],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":2694,"attributes":5527,"children":5528},{"class":2790},[],{"type":315,"textContent":318},{"type":324,"nodeName":2687,"attributes":5531,"children":5532},{},[5533],{"type":315,"textContent":5534},"(3)",{"type":315,"textContent":318},{"type":324,"nodeName":2694,"attributes":5537,"children":5539},{"id":5538},"section-appendix.b-4.3",[5540,5542,5548,5549,5554],{"type":315,"textContent":5541},"\n            Values out of range are not permitted in JSON.\n            See ",{"type":324,"nodeName":337,"attributes":5543,"children":5545},{"href":5544,"class":606},"#json.ser.number",[5546],{"type":315,"textContent":5547},"Section 3.2.2.3",{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":5550,"children":5552},{"href":5551,"class":355},"#section-appendix.b-4.3",[5553],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":2694,"attributes":5557,"children":5558},{"class":2790},[],{"type":315,"textContent":318},{"type":324,"nodeName":2687,"attributes":5561,"children":5562},{},[5563],{"type":315,"textContent":5564},"(4)",{"type":315,"textContent":318},{"type":324,"nodeName":2694,"attributes":5567,"children":5569},{"id":5568},"section-appendix.b-4.4",[5570,5572,5575,5577,5580,5582,5586,5588,5593],{"type":315,"textContent":5571},"\n          This number is exactly 14249539",{"type":324,"nodeName":440,"attributes":5573,"children":5574},{"class":2396},[],{"type":315,"textContent":5576},"23781206",{"type":324,"nodeName":440,"attributes":5578,"children":5579},{"class":2396},[],{"type":315,"textContent":5581},".25 but will, after the \"Note\n   2\" rule\n          mentioned in ",{"type":324,"nodeName":337,"attributes":5583,"children":5584},{"href":5544,"class":606},[5585],{"type":315,"textContent":5547},{"type":315,"textContent":5587},", be\n   truncated and\n          rounded to the closest even value.",{"type":324,"nodeName":337,"attributes":5589,"children":5591},{"href":5590,"class":355},"#section-appendix.b-4.4",[5592],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":330},{"type":324,"nodeName":2694,"attributes":5596,"children":5597},{"class":2790},[],{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5601,"children":5603},{"id":5602},"section-appendix.b-5",[5604,5606,5611,5613,5622,5624],{"type":315,"textContent":5605},"\n        For a more exhaustive validation of a JCS number serializer, you may\n        test against a file (currently) available in the development portal\n        (see ",{"type":324,"nodeName":337,"attributes":5607,"children":5609},{"href":5608,"class":606},"#json.development",[5610],{"type":315,"textContent":298},{"type":315,"textContent":5612},") containing a\n        large set of sample values. Another option is running V8 ",{"type":324,"nodeName":430,"attributes":5614,"children":5615},{"class":1928},[5616,5617,5621],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":5618,"children":5619},{"href":1933,"class":606},[5620],{"type":315,"textContent":1936},{"type":315,"textContent":611},{"type":315,"textContent":5623}," as a live reference together with a\n        program generating a substantial amount of random IEEE 754 values.",{"type":324,"nodeName":337,"attributes":5625,"children":5627},{"href":5626,"class":355},"#section-appendix.b-5",[5628],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5633,"children":5635},{"id":5634},"json.wireformat",[5636,5637,5731],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":5638,"children":5639},{"id":240},[5640,5641,5657,5658,5677,5678,5698,5699,5718,5719,5730],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":5642,"children":5643},{"id":243},[5644,5645,5651,5656],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":5646,"children":5648},{"href":5647,"class":580},"#section-appendix.c",[5649],{"type":315,"textContent":5650},"Appendix C. ",{"type":324,"nodeName":337,"attributes":5652,"children":5654},{"href":5653,"class":393},"#name-canonicalized-json-as-wire-",[5655],{"type":315,"textContent":244},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5659,"children":5661},{"id":5660},"section-appendix.c-1",[5662,5664,5670,5672],{"type":315,"textContent":5663},"\n        Since the result from the canonicalization process (see ",{"type":324,"nodeName":337,"attributes":5665,"children":5667},{"href":5666,"class":606},"#json.utf8",[5668],{"type":315,"textContent":5669},"Section 3.2.4",{"type":315,"textContent":5671},") is fully valid JSON, it can\n        also be used as \"Wire Format\".  However, this is just an option since\n        cryptographic schemes based on JCS, in most cases, would not depend on\n        that externally supplied JSON data already being canonicalized.",{"type":324,"nodeName":337,"attributes":5673,"children":5675},{"href":5674,"class":355},"#section-appendix.c-1",[5676],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5679,"children":5681},{"id":5680},"section-appendix.c-2",[5682,5684,5687,5688,5691,5693],{"type":315,"textContent":5683},"\n        In fact, the ECMAScript standard way of serializing objects using\n        \"JSON",{"type":324,"nodeName":440,"attributes":5685,"children":5686},{"class":1312},[],{"type":315,"textContent":1574},{"type":324,"nodeName":440,"attributes":5689,"children":5690},{"class":1312},[],{"type":315,"textContent":5692},"()\" produces a\n        more \"logical\" format, where properties are\n        kept in the order they were created or received.  The\n        example below shows an address record that could benefit from\n        ECMAScript standard serialization:",{"type":324,"nodeName":337,"attributes":5694,"children":5696},{"href":5695,"class":355},"#section-appendix.c-2",[5697],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5700,"children":5702},{"id":5701},"section-appendix.c-3",[5703,5704,5712,5717],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5705,"children":5706},{"data-component":1547,"data-copy-mode":1548},[5707],{"type":324,"nodeName":1551,"attributes":5708,"children":5709},{"class":1553},[5710],{"type":315,"textContent":5711},"  {\n    \"name\": \"John Doe\",\n    \"address\": \"2000 Sunset Boulevard\",\n    \"city\": \"Los Angeles\",\n    \"zip\": \"90001\",\n    \"state\": \"CA\"\n  }\n",{"type":324,"nodeName":337,"attributes":5713,"children":5715},{"href":5714,"class":355},"#section-appendix.c-3",[5716],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5720,"children":5722},{"id":5721},"section-appendix.c-4",[5723,5725],{"type":315,"textContent":5724},"\n        Using canonicalization, the properties above would be output in the\n order\n        \"address\", \"city\", \"name\", \"state\", and \"zip\", which adds fuzziness\n        to the data from a human (developer or technical support) perspective.\n        Canonicalization also converts JSON data into a single line of text,\n which may\n        be less than ideal for debugging and logging.",{"type":324,"nodeName":337,"attributes":5726,"children":5728},{"href":5727,"class":355},"#section-appendix.c-4",[5729],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5734,"children":5736},{"id":5735},"json.bignumbers",[5737,5738,5906],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":5739,"children":5740},{"id":248},[5741,5742,5758,5759,5770,5771,5790,5791,5813,5814,5825,5826,5848,5849,5860,5861,5881,5882,5905],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":5743,"children":5744},{"id":251},[5745,5746,5752,5757],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":5747,"children":5749},{"href":5748,"class":580},"#section-appendix.d",[5750],{"type":315,"textContent":5751},"Appendix D. ",{"type":324,"nodeName":337,"attributes":5753,"children":5755},{"href":5754,"class":393},"#name-dealing-with-big-numbers",[5756],{"type":315,"textContent":252},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5760,"children":5762},{"id":5761},"section-appendix.d-1",[5763,5765],{"type":315,"textContent":5764},"\n        There are several issues associated with the\n        JSON number type, here illustrated by the following\n        sample object:",{"type":324,"nodeName":337,"attributes":5766,"children":5768},{"href":5767,"class":355},"#section-appendix.d-1",[5769],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5772,"children":5774},{"id":5773},"section-appendix.d-2",[5775,5776,5784,5789],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5777,"children":5778},{"data-component":1547,"data-copy-mode":1548},[5779],{"type":324,"nodeName":1551,"attributes":5780,"children":5781},{"class":1553},[5782],{"type":315,"textContent":5783},"  {\n    \"giantNumber\": 1.4e+9999,\n    \"payMeThis\": 26000.33,\n    \"int64Max\": 9223372036854775807\n  }\n",{"type":324,"nodeName":337,"attributes":5785,"children":5787},{"href":5786,"class":355},"#section-appendix.d-2",[5788],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5792,"children":5794},{"id":5793},"section-appendix.d-3",[5795,5797,5806,5808],{"type":315,"textContent":5796},"\n        Although the sample above conforms to JSON ",{"type":324,"nodeName":430,"attributes":5798,"children":5799},{"class":599},[5800,5801,5805],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":5802,"children":5803},{"href":605,"class":606},[5804],{"type":315,"textContent":609},{"type":315,"textContent":611},{"type":315,"textContent":5807},",\n        applications would normally use different native data types for\n storing\n        \"giantNumber\" and \"int64Max\".  In addition, monetary data like\n \"payMeThis\" would\n        presumably not rely on floating-point data types due to rounding\n issues with respect\n        to decimal arithmetic.",{"type":324,"nodeName":337,"attributes":5809,"children":5811},{"href":5810,"class":355},"#section-appendix.d-3",[5812],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5815,"children":5817},{"id":5816},"section-appendix.d-4",[5818,5820],{"type":315,"textContent":5819},"\n        The established way of handling this kind of \"overloading\" of the\n        JSON number type (at least in an extensible manner) is through\n        mapping mechanisms, instructing parsers what to do with different\n properties\n        based on their name.  However, this greatly limits the value of using\n the\n        JSON number type outside of its original, somewhat constrained\n JavaScript context.\n        The ECMAScript \"JSON\" object does not support mappings to the JSON\n number type either.",{"type":324,"nodeName":337,"attributes":5821,"children":5823},{"href":5822,"class":355},"#section-appendix.d-4",[5824],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5827,"children":5829},{"id":5828},"section-appendix.d-5",[5830,5832,5836,5838,5842,5843],{"type":315,"textContent":5831},"\n        Due to the above, numbers that do not have a natural place in the\n current\n        JSON ecosystem ",{"type":324,"nodeName":430,"attributes":5833,"children":5834},{"class":968},[5835],{"type":315,"textContent":971},{"type":315,"textContent":5837}," be wrapped using the JSON string\n type.  This is close to\n        a de facto standard for open systems.  This is also applicable for\n        other data types that do not have direct support in JSON, like\n \"DateTime\"\n        objects as described in ",{"type":324,"nodeName":337,"attributes":5839,"children":5840},{"href":1351,"class":606},[5841],{"type":315,"textContent":257},{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":5844,"children":5846},{"href":5845,"class":355},"#section-appendix.d-5",[5847],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5850,"children":5852},{"id":5851},"section-appendix.d-6",[5853,5855],{"type":315,"textContent":5854},"\n        Aided by a system using the JSON string type, be it programmatic like",{"type":324,"nodeName":337,"attributes":5856,"children":5858},{"href":5857,"class":355},"#section-appendix.d-6",[5859],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5862,"children":5864},{"id":5863},"section-appendix.d-7",[5865,5866,5875,5880],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5867,"children":5868},{"data-component":1547,"data-copy-mode":1548},[5869],{"type":324,"nodeName":1551,"attributes":5870,"children":5872},{"class":5871},"sourcecode",[5873],{"type":315,"textContent":5874},"  var obj = JSON.parse('{\"giantNumber\": \"1.4e+9999\"}');\n  var biggie = new BigNumber(obj.giantNumber);\n",{"type":324,"nodeName":337,"attributes":5876,"children":5878},{"href":5877,"class":355},"#section-appendix.d-7",[5879],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5883,"children":5885},{"id":5884},"section-appendix.d-8",[5886,5888,5898,5900],{"type":315,"textContent":5887},"\n        or declarative schemes like OpenAPI ",{"type":324,"nodeName":430,"attributes":5889,"children":5890},{"class":599},[5891,5892,5897],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":5893,"children":5895},{"href":5894,"class":606},"#OPENAPI",[5896],{"type":315,"textContent":3628},{"type":315,"textContent":611},{"type":315,"textContent":5899},",\n        JCS imposes no limits on applications, including when using\n ECMAScript.",{"type":324,"nodeName":337,"attributes":5901,"children":5903},{"href":5902,"class":355},"#section-appendix.d-8",[5904],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5909,"children":5911},{"id":5910},"string.subtypes",[5912,5913,6314],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":5914,"children":5915},{"id":256},[5916,5917,5933,5934,5951,5952,5963,5964,5983,5984,5995,5996,6015,6016,6027,6028,6047,6048,6069,6070,6087,6088,6107,6108,6119,6120,6139,6140,6157,6158,6177,6178,6189,6190,6206,6207,6229,6230,6249,6250,6261,6262,6273,6274,6313],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":5918,"children":5919},{"id":259},[5920,5921,5927,5932],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":5922,"children":5924},{"href":5923,"class":580},"#section-appendix.e",[5925],{"type":315,"textContent":5926},"Appendix E. ",{"type":324,"nodeName":337,"attributes":5928,"children":5930},{"href":5929,"class":393},"#name-string-subtype-handling",[5931],{"type":315,"textContent":260},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5935,"children":5937},{"id":5936},"section-appendix.e-1",[5938,5940,5944,5946],{"type":315,"textContent":5939},"\n        Due to the limited set of data types featured in JSON, the JSON string\n        type is commonly used for holding subtypes.  This can, depending on\n        JSON parsing method, lead to interoperability problems, which\n        ",{"type":324,"nodeName":430,"attributes":5941,"children":5942},{"class":968},[5943],{"type":315,"textContent":971},{"type":315,"textContent":5945}," be dealt with by JCS-compliant applications\n        targeting a wider audience.",{"type":324,"nodeName":337,"attributes":5947,"children":5949},{"href":5948,"class":355},"#section-appendix.e-1",[5950],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5953,"children":5955},{"id":5954},"section-appendix.e-2",[5956,5958],{"type":315,"textContent":5957},"\n        Assume you want to parse a JSON object where the schema\n        designer assigned the property \"big\" for holding a \"BigInt\" subtype\n and\n        \"time\" for holding a \"DateTime\" subtype, while \"val\" is supposed to be\n a JSON number\n        compliant with JCS. The following example shows such an object:",{"type":324,"nodeName":337,"attributes":5959,"children":5961},{"href":5960,"class":355},"#section-appendix.e-2",[5962],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5965,"children":5967},{"id":5966},"section-appendix.e-3",[5968,5969,5977,5982],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5970,"children":5971},{"data-component":1547,"data-copy-mode":1548},[5972],{"type":324,"nodeName":1551,"attributes":5973,"children":5974},{"class":1553},[5975],{"type":315,"textContent":5976},"  {\n    \"time\": \"2019-01-28T07:45:10Z\",\n    \"big\": \"055\",\n    \"val\": 3.5\n  }\n",{"type":324,"nodeName":337,"attributes":5978,"children":5980},{"href":5979,"class":355},"#section-appendix.e-3",[5981],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":5985,"children":5987},{"id":5986},"section-appendix.e-4",[5988,5990],{"type":315,"textContent":5989},"Parsing of this object can be accomplished by the following\n      ECMAScript statement:",{"type":324,"nodeName":337,"attributes":5991,"children":5993},{"href":5992,"class":355},"#section-appendix.e-4",[5994],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":5997,"children":5999},{"id":5998},"section-appendix.e-5",[6000,6001,6009,6014],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6002,"children":6003},{"data-component":1547,"data-copy-mode":1548},[6004],{"type":324,"nodeName":1551,"attributes":6005,"children":6006},{"class":5871},[6007],{"type":315,"textContent":6008},"  var object = JSON.parse(JSON_object_featured_as_a_string);\n",{"type":324,"nodeName":337,"attributes":6010,"children":6012},{"href":6011,"class":355},"#section-appendix.e-5",[6013],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6017,"children":6019},{"id":6018},"section-appendix.e-6",[6020,6022],{"type":315,"textContent":6021},"After parsing, the actual data can be extracted, which for subtypes,\n      also involves a conversion step using the result of the parsing process\n      (an ECMAScript object) as input:",{"type":324,"nodeName":337,"attributes":6023,"children":6025},{"href":6024,"class":355},"#section-appendix.e-6",[6026],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6029,"children":6031},{"id":6030},"section-appendix.e-7",[6032,6033,6041,6046],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6034,"children":6035},{"data-component":1547,"data-copy-mode":1548},[6036],{"type":324,"nodeName":1551,"attributes":6037,"children":6038},{"class":5871},[6039],{"type":315,"textContent":6040},"  ... = new Date(object.time); \u002F\u002F Date object\n  ... = BigInt(object.big);    \u002F\u002F Big integer\n  ... = object.val;            \u002F\u002F JSON\u002FJS number\n",{"type":324,"nodeName":337,"attributes":6042,"children":6044},{"href":6043,"class":355},"#section-appendix.e-7",[6045],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6049,"children":6051},{"id":6050},"section-appendix.e-8",[6052,6054,6063,6064],{"type":315,"textContent":6053},"\n        Note that the \"BigInt\" data type is currently only natively supported\n by V8 ",{"type":324,"nodeName":430,"attributes":6055,"children":6056},{"class":1928},[6057,6058,6062],{"type":315,"textContent":602},{"type":324,"nodeName":337,"attributes":6059,"children":6060},{"href":1933,"class":606},[6061],{"type":315,"textContent":1936},{"type":315,"textContent":611},{"type":315,"textContent":472},{"type":324,"nodeName":337,"attributes":6065,"children":6067},{"href":6066,"class":355},"#section-appendix.e-8",[6068],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6071,"children":6073},{"id":6072},"section-appendix.e-9",[6074,6076,6080,6082],{"type":315,"textContent":6075},"\n        Canonicalization of \"object\" using the sample code in ",{"type":324,"nodeName":337,"attributes":6077,"children":6078},{"href":1439,"class":606},[6079],{"type":315,"textContent":225},{"type":315,"textContent":6081}," would return the\n        following string:",{"type":324,"nodeName":337,"attributes":6083,"children":6085},{"href":6084,"class":355},"#section-appendix.e-9",[6086],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6089,"children":6091},{"id":6090},"section-appendix.e-10",[6092,6093,6101,6106],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6094,"children":6095},{"data-component":1547,"data-copy-mode":1548},[6096],{"type":324,"nodeName":1551,"attributes":6097,"children":6098},{"class":1553},[6099],{"type":315,"textContent":6100},"  {\"big\":\"055\",\"time\":\"2019-01-28T07:45:10Z\",\"val\":3.5}\n",{"type":324,"nodeName":337,"attributes":6102,"children":6104},{"href":6103,"class":355},"#section-appendix.e-10",[6105],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6109,"children":6111},{"id":6110},"section-appendix.e-11",[6112,6114],{"type":315,"textContent":6113},"\n        Although this is (with respect to JCS) technically correct, there is\n        another way of parsing JSON data, which also can be used with\n        ECMAScript as shown below:",{"type":324,"nodeName":337,"attributes":6115,"children":6117},{"href":6116,"class":355},"#section-appendix.e-11",[6118],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6121,"children":6123},{"id":6122},"section-appendix.e-12",[6124,6125,6133,6138],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6126,"children":6127},{"data-component":1547,"data-copy-mode":1548},[6128],{"type":324,"nodeName":1551,"attributes":6129,"children":6130},{"class":5871},[6131],{"type":315,"textContent":6132},"  \u002F\u002F \"BigInt\" requires the following code to become JSON serializable\n  BigInt.prototype.toJSON = function() {\n      return this.toString();\n  };\n\n  \u002F\u002F JSON parsing using a \"stream\"-based method\n  var object = JSON.parse(JSON_object_featured_as_a_string,\n      (k,v) => k == 'time' ? new Date(v) : k == 'big' ? BigInt(v) : v\n  );\n",{"type":324,"nodeName":337,"attributes":6134,"children":6136},{"href":6135,"class":355},"#section-appendix.e-12",[6137],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6141,"children":6143},{"id":6142},"section-appendix.e-13",[6144,6146,6150,6152],{"type":315,"textContent":6145},"\n        If you now apply the canonicalizer in ",{"type":324,"nodeName":337,"attributes":6147,"children":6148},{"href":1439,"class":606},[6149],{"type":315,"textContent":225},{"type":315,"textContent":6151}," to \"object\", the following string would be\n        generated:",{"type":324,"nodeName":337,"attributes":6153,"children":6155},{"href":6154,"class":355},"#section-appendix.e-13",[6156],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6159,"children":6161},{"id":6160},"section-appendix.e-14",[6162,6163,6171,6176],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6164,"children":6165},{"data-component":1547,"data-copy-mode":1548},[6166],{"type":324,"nodeName":1551,"attributes":6167,"children":6168},{"class":1553},[6169],{"type":315,"textContent":6170},"  {\"big\":\"55\",\"time\":\"2019-01-28T07:45:10.000Z\",\"val\":3.5}\n",{"type":324,"nodeName":337,"attributes":6172,"children":6174},{"href":6173,"class":355},"#section-appendix.e-14",[6175],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6179,"children":6181},{"id":6180},"section-appendix.e-15",[6182,6184],{"type":315,"textContent":6183},"\n        In this case, the string arguments for \"big\" and \"time\" have changed\n with respect to the original,\n        presumably making an application depending on JCS fail.",{"type":324,"nodeName":337,"attributes":6185,"children":6187},{"href":6186,"class":355},"#section-appendix.e-15",[6188],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6191,"children":6193},{"id":6192},"section-appendix.e-16",[6194,6196,6199,6201],{"type":315,"textContent":6195},"\n        The reason for the deviation is that in stream- and schema-based JSON\n parsers,\n        the original string argument is typically replaced on the fly\n        by the native subtype that, when serialized, may exhibit a different\n        and platform-",{"type":324,"nodeName":440,"attributes":6197,"children":6198},{"class":2396},[],{"type":315,"textContent":6200},"dependent pattern.",{"type":324,"nodeName":337,"attributes":6202,"children":6204},{"href":6203,"class":355},"#section-appendix.e-16",[6205],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6208,"children":6210},{"id":6209},"section-appendix.e-17",[6211,6213,6217,6219,6222,6224],{"type":315,"textContent":6212},"\n        That is, stream- and schema-based parsing ",{"type":324,"nodeName":430,"attributes":6214,"children":6215},{"class":968},[6216],{"type":315,"textContent":971},{"type":315,"textContent":6218}," treat\n        subtypes as \"pure\" (immutable) JSON string types and perform the\n        actual conversion to the designated native type in a subsequent step.\n        In modern programming platforms like Go, Java, and C#, this can be\n        achieved with moderate efforts by combining annotations, getters, and\n        setters.  Below is an example in C#\u002FJson",{"type":324,"nodeName":440,"attributes":6220,"children":6221},{"class":3428},[],{"type":315,"textContent":6223},".NET showing a part of a class\n        that is serializable as a JSON object:",{"type":324,"nodeName":337,"attributes":6225,"children":6227},{"href":6226,"class":355},"#section-appendix.e-17",[6228],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6231,"children":6233},{"id":6232},"section-appendix.e-18",[6234,6235,6243,6248],{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6236,"children":6237},{"data-component":1547,"data-copy-mode":1548},[6238],{"type":324,"nodeName":1551,"attributes":6239,"children":6240},{"class":5871},[6241],{"type":315,"textContent":6242},"  \u002F\u002F The \"pure\" string solution uses a local\n  \u002F\u002F string variable for JSON serialization while\n  \u002F\u002F exposing another type to the application\n  [JsonProperty(\"amount\")]\n  private string _amount;\n\n  [JsonIgnore]\n  public decimal Amount {\n      get { return decimal.Parse(_amount); }\n      set { _amount = value.ToString(); }\n  }\n",{"type":324,"nodeName":337,"attributes":6244,"children":6246},{"href":6245,"class":355},"#section-appendix.e-18",[6247],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6251,"children":6253},{"id":6252},"section-appendix.e-19",[6254,6256],{"type":315,"textContent":6255},"\n        In an application, \"Amount\" can be accessed as any other property\n        while it is actually represented by a quoted string in JSON contexts.",{"type":324,"nodeName":337,"attributes":6257,"children":6259},{"href":6258,"class":355},"#section-appendix.e-19",[6260],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6263,"children":6265},{"id":6264},"section-appendix.e-20",[6266,6268],{"type":315,"textContent":6267},"\n        Note: The example above also addresses the constraints on numeric data\n        implied by I-JSON (the C# \"decimal\" data type has quite different\n        characteristics compared to IEEE 754 double precision).",{"type":324,"nodeName":337,"attributes":6269,"children":6271},{"href":6270,"class":355},"#section-appendix.e-20",[6272],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6275,"children":6277},{"id":6276},"string.subtypes.arrays",[6278,6279,6312],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":6280,"children":6281},{"id":265},[6282,6283,6299,6300,6311],{"type":315,"textContent":384},{"type":324,"nodeName":332,"attributes":6284,"children":6285},{"id":268},[6286,6287,6293,6298],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":6288,"children":6290},{"href":6289,"class":580},"#section-e.1",[6291],{"type":315,"textContent":6292},"E.1. ",{"type":324,"nodeName":337,"attributes":6294,"children":6296},{"href":6295,"class":393},"#name-subtypes-in-arrays",[6297],{"type":315,"textContent":269},{"type":315,"textContent":384},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6301,"children":6303},{"id":6302},"section-e.1-1",[6304,6306],{"type":315,"textContent":6305},"\n          Since the JSON array construct permits mixing arbitrary JSON data\n   types,\n          custom parsing and serialization code may be required\n          to cope with subtypes anyway.",{"type":324,"nodeName":337,"attributes":6307,"children":6309},{"href":6308,"class":355},"#section-e.1-1",[6310],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6317,"children":6319},{"id":6318},"impl.guidelines",[6320,6321,6569],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":6322,"children":6323},{"id":273},[6324,6325,6341,6342,6353,6354,6365,6366,6449,6450,6461,6462,6544,6545,6556,6557,6568],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":6326,"children":6327},{"id":276},[6328,6329,6335,6340],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":6330,"children":6332},{"href":6331,"class":580},"#section-appendix.f",[6333],{"type":315,"textContent":6334},"Appendix F. ",{"type":324,"nodeName":337,"attributes":6336,"children":6338},{"href":6337,"class":393},"#name-implementation-guidelines",[6339],{"type":315,"textContent":277},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6343,"children":6345},{"id":6344},"section-appendix.f-1",[6346,6348],{"type":315,"textContent":6347},"\n        The optimal solution is integrating support for JCS directly\n        in JSON serializers (parsers need no changes).\n        That is, canonicalization would just be an additional \"mode\"\n        for a JSON serializer. However, this is currently not the case.\n        Fortunately, JCS support can be introduced through externally supplied\n        canonicalizer software acting as a post processor to existing\n        JSON serializers. This arrangement also relieves the JCS implementer\n from\n        having to deal with how underlying data is to be represented in JSON.",{"type":324,"nodeName":337,"attributes":6349,"children":6351},{"href":6350,"class":355},"#section-appendix.f-1",[6352],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6355,"children":6357},{"id":6356},"section-appendix.f-2",[6358,6360],{"type":315,"textContent":6359},"\n        The post processor concept enables signature creation schemes like the\n following:",{"type":324,"nodeName":337,"attributes":6361,"children":6363},{"href":6362,"class":355},"#section-appendix.f-2",[6364],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":2572,"attributes":6367,"children":6369},{"start":85,"type":85,"class":2574,"id":6368},"section-appendix.f-3",[6370,6371,6383,6384,6396,6397,6409,6410,6422,6423,6435,6436,6448],{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6372,"children":6374},{"id":6373},"section-appendix.f-3.1",[6375,6377,6382],{"type":315,"textContent":6376},"\n            Create the data to be signed.",{"type":324,"nodeName":337,"attributes":6378,"children":6380},{"href":6379,"class":355},"#section-appendix.f-3.1",[6381],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6385,"children":6387},{"id":6386},"section-appendix.f-3.2",[6388,6390,6395],{"type":315,"textContent":6389},"\n            Serialize the data using existing JSON tools.",{"type":324,"nodeName":337,"attributes":6391,"children":6393},{"href":6392,"class":355},"#section-appendix.f-3.2",[6394],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6398,"children":6400},{"id":6399},"section-appendix.f-3.3",[6401,6403,6408],{"type":315,"textContent":6402},"\n            Let the external canonicalizer process the serialized data and\n     return canonicalized result data.",{"type":324,"nodeName":337,"attributes":6404,"children":6406},{"href":6405,"class":355},"#section-appendix.f-3.3",[6407],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6411,"children":6413},{"id":6412},"section-appendix.f-3.4",[6414,6416,6421],{"type":315,"textContent":6415},"\n            Sign the canonicalized data.",{"type":324,"nodeName":337,"attributes":6417,"children":6419},{"href":6418,"class":355},"#section-appendix.f-3.4",[6420],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6424,"children":6426},{"id":6425},"section-appendix.f-3.5",[6427,6429,6434],{"type":315,"textContent":6428},"\n            Add the resulting signature value to the original JSON data\n     through a designated signature property.",{"type":324,"nodeName":337,"attributes":6430,"children":6432},{"href":6431,"class":355},"#section-appendix.f-3.5",[6433],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6437,"children":6439},{"id":6438},"section-appendix.f-3.6",[6440,6442,6447],{"type":315,"textContent":6441},"\n            Serialize the completed (now signed) JSON object using existing\n     JSON tools.",{"type":324,"nodeName":337,"attributes":6443,"children":6445},{"href":6444,"class":355},"#section-appendix.f-3.6",[6446],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6451,"children":6453},{"id":6452},"section-appendix.f-4",[6454,6456],{"type":315,"textContent":6455},"\n        A compatible signature verification scheme would then be as follows:",{"type":324,"nodeName":337,"attributes":6457,"children":6459},{"href":6458,"class":355},"#section-appendix.f-4",[6460],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":2572,"attributes":6463,"children":6465},{"start":85,"type":85,"class":2574,"id":6464},"section-appendix.f-5",[6466,6467,6479,6480,6492,6493,6505,6506,6518,6519,6530,6531,6543],{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6468,"children":6470},{"id":6469},"section-appendix.f-5.1",[6471,6473,6478],{"type":315,"textContent":6472},"\n            Parse the signed JSON data using existing JSON tools.",{"type":324,"nodeName":337,"attributes":6474,"children":6476},{"href":6475,"class":355},"#section-appendix.f-5.1",[6477],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6481,"children":6483},{"id":6482},"section-appendix.f-5.2",[6484,6486,6491],{"type":315,"textContent":6485},"\n            Read and save the signature value from the designated signature\n     property.",{"type":324,"nodeName":337,"attributes":6487,"children":6489},{"href":6488,"class":355},"#section-appendix.f-5.2",[6490],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6494,"children":6496},{"id":6495},"section-appendix.f-5.3",[6497,6499,6504],{"type":315,"textContent":6498},"\n            Remove the signature property from the parsed JSON object.",{"type":324,"nodeName":337,"attributes":6500,"children":6502},{"href":6501,"class":355},"#section-appendix.f-5.3",[6503],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6507,"children":6509},{"id":6508},"section-appendix.f-5.4",[6510,6512,6517],{"type":315,"textContent":6511},"\n            Serialize the remaining JSON data using existing JSON tools.",{"type":324,"nodeName":337,"attributes":6513,"children":6515},{"href":6514,"class":355},"#section-appendix.f-5.4",[6516],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6520,"children":6522},{"id":6521},"section-appendix.f-5.5",[6523,6524,6529],{"type":315,"textContent":6402},{"type":324,"nodeName":337,"attributes":6525,"children":6527},{"href":6526,"class":355},"#section-appendix.f-5.5",[6528],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":384},{"type":324,"nodeName":752,"attributes":6532,"children":6534},{"id":6533},"section-appendix.f-5.6",[6535,6537,6542],{"type":315,"textContent":6536},"\n            Verify that the canonicalized data matches the saved signature\n     value\n            using the algorithm and key used for creating the signature.",{"type":324,"nodeName":337,"attributes":6538,"children":6540},{"href":6539,"class":355},"#section-appendix.f-5.6",[6541],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6546,"children":6548},{"id":6547},"section-appendix.f-6",[6549,6551],{"type":315,"textContent":6550},"\n        A canonicalizer like above is effectively only a \"filter\", potentially\n usable with\n        a multitude of quite different cryptographic schemes.",{"type":324,"nodeName":337,"attributes":6552,"children":6554},{"href":6553,"class":355},"#section-appendix.f-6",[6555],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6558,"children":6560},{"id":6559},"section-appendix.f-7",[6561,6563],{"type":315,"textContent":6562},"\n        Using a JSON serializer with integrated JCS support, the serialization\n performed\n        before the canonicalization step could be eliminated for both\n processes.",{"type":324,"nodeName":337,"attributes":6564,"children":6566},{"href":6565,"class":355},"#section-appendix.f-7",[6567],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":315,"textContent":318},{"type":324,"nodeName":374,"attributes":6572,"children":6574},{"id":6573},"open.source",[6575,6576,6883],{"type":315,"textContent":318},{"type":324,"nodeName":325,"attributes":6577,"children":6578},{"id":281},[6579,6580,6596,6597,6608,6609,6882],{"type":315,"textContent":330},{"type":324,"nodeName":332,"attributes":6581,"children":6582},{"id":284},[6583,6584,6590,6595],{"type":315,"textContent":318},{"type":324,"nodeName":337,"attributes":6585,"children":6587},{"href":6586,"class":580},"#section-appendix.g",[6588],{"type":315,"textContent":6589},"Appendix G. ",{"type":324,"nodeName":337,"attributes":6591,"children":6593},{"href":6592,"class":393},"#name-open-source-implementations",[6594],{"type":315,"textContent":285},{"type":315,"textContent":330},{"type":315,"textContent":318},{"type":324,"nodeName":346,"attributes":6598,"children":6600},{"id":6599},"section-appendix.g-1",[6601,6603],{"type":315,"textContent":6602},"\n        The following open-source implementations have been verified to be\n        compatible with JCS:",{"type":324,"nodeName":337,"attributes":6604,"children":6606},{"href":6605,"class":355},"#section-appendix.g-1",[6607],{"type":315,"textContent":358},{"type":315,"textContent":318},{"type":324,"nodeName":746,"attributes":6610,"children":6611},{"class":748},[6612,6613,6658,6659,6709,6710,6769,6770,6825,6826,6881],{"type":315,"textContent":318},{"type":324,"nodeName":752,"attributes":6614,"children":6616},{"class":748,"id":6615},"section-appendix.g-2.1",[6617,6619,6652,6657],{"type":315,"textContent":6618},"\n          JavaScript: ",{"type"