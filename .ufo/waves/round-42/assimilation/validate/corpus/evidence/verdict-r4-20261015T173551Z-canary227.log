---- canary script (verbatim; recreate at /tmp/mori-receipts-r4/canary227.sh) ----
#!/usr/bin/env bash
# canary227.sh — differential canary for the r4 `:227` state_n hardening.
# Builds ONE /tmp fixture root with an unreadable .ufo/state and runs the
# round-3 census snapshot vs the current census under identical env:
#   before (fe22a14f): expected rc 1, header only, 0 verdict lines (canary B)
#   after  (r4):       expected full verdict with state_rounds=unavailable
#                      state_unreadable=1 and every other surface reporting
# Also runs the after census with a readable state dir as control.
set -uo pipefail
LANE=/home/vgpnk/Projects/shokunin/mori-shokunin
BEFORE_CENSUS=/tmp/mori-receipts-r4/before/mori-census.r3.sh
AFTER_CENSUS=$LANE/tools/mori-census.sh
T=/tmp/mori-receipts-r4/canary227
rm -rf "$T"; mkdir -p "$T"

CASE_DIR=$T/fixture; ROOT=$CASE_DIR/root; UFO=$CASE_DIR/ufo
STUB=$CASE_DIR/stub; HOME_D=$CASE_DIR/home; BIN=$CASE_DIR/bin
mkdir -p "$ROOT" "$UFO/state" "$UFO/waves" "$CASE_DIR/cgroup" "$STUB" "$HOME_D" "$BIN"
T0=1700000000
printf '%s tick=1\n' "$(date -u -d "@$T0" +%Y-%m-%dT%H:%M:%S+00:00)" > "$UFO/watchdog.log"
touch -d "@$T0" "$UFO/watchdog.log"
printf '1\n' > "$UFO/state/kagi.round"
printf '{"wave":"wave-settled"}\n' > "$UFO/waves/wave-settled.json"
touch -d "@$T0" "$UFO/waves/wave-settled.json"
printf 'low 0\nhigh 0\nmax 0\noom 0\noom_kill 0\noom_group_kill 0\n' > "$CASE_DIR/cgroup/memory.events"
printf '123456\n' > "$CASE_DIR/cgroup/memory.current"
printf 'MemAvailable: 20000000 kB\n' > "$CASE_DIR/meminfo"
cat > "$BIN/.dispatch" <<'STUB'
#!/usr/bin/env bash
set -uo pipefail
name=${0##*/}
fx=${MORI_STUB_DIR:-}
[ -n "$fx" ] || { printf 'stub dispatcher: MORI_STUB_DIR unset\n' >&2; exit 97; }
rc_of() { local f="$fx/$1.rc"; if [ -f "$f" ]; then cat "$f"; else printf 0; fi; }
out_of() { local f="$fx/$1"; if [ -f "$fx/$1" ]; then cat "$fx/$1"; fi; }
case "$name" in
  pgrep)     out_of pgrep;     exit "$(rc_of pgrep)" ;;
  journalctl) out_of journal;  exit "$(rc_of journal)" ;;
  df)        out_of df;        exit "$(rc_of df)" ;;
  tmux)      out_of tmux;      exit "$(rc_of tmux)" ;;
esac
printf 'stub dispatcher: unknown %s\n' "$name" >&2
exit 96
STUB
chmod 700 "$BIN/.dispatch"
for c in pgrep journalctl df tmux; do ln -sf .dispatch "$BIN/$c"; done
printf '1234 bash /path/scripts/shokunin-watchdog.sh\n' > "$STUB/pgrep"; printf 0 > "$STUB/pgrep.rc"
: > "$STUB/journal"; printf 0 > "$STUB/journal.rc"
printf 'Filesystem 1024-blocks Used Available Capacity Mounted on\n/dev/fx 1000000 10000 990000 2%% /fx\n' > "$STUB/df"; printf 0 > "$STUB/df.rc"
printf 'fx_session: 1 windows\n' > "$STUB/tmux"; printf 0 > "$STUB/tmux.rc"

run_one() { # <label> <census> ; prints rc + verdict + watchdog row
  local label=$1 cen=$2 out rc
  out=$(env -i \
    PATH="$BIN:/usr/bin:/bin" HOME="$HOME_D" TZ=UTC LC_ALL=C \
    MORI_STUB_DIR="$STUB" MORI_SHOKUNIN_ROOT="$ROOT" MORI_UFO_DIR="$UFO" \
    MORI_WATCHDOG_LOG="$UFO/watchdog.log" MORI_STATE_DIR="$UFO/state" \
    MORI_WAVES_DIR="$UFO/waves" MORI_TIMELINE_FILE="$UFO/watchdog.log" \
    MORI_CGROUP_EVENTS="$CASE_DIR/cgroup/memory.events" \
    MORI_CGROUP_SERVICE_EVENTS="$CASE_DIR/cgroup/memory.events" \
    MORI_CGROUP_LOCAL_EVENTS="$CASE_DIR/cgroup/memory.events" \
    MORI_CGROUP_CURRENT="$CASE_DIR/cgroup/memory.current" \
    MORI_MEMINFO="$CASE_DIR/meminfo" \
    MORI_DF_BIN="$BIN/df" MORI_PGREP_BIN="$BIN/pgrep" \
    MORI_JOURNALCTL_BIN="$BIN/journalctl" MORI_TMUX_BIN="$BIN/tmux" \
    MORI_DISK_TARGETS="$ROOT" MORI_ROSTER_LANES=kagi \
    MORI_NOW_EPOCH=$T0 MORI_WATCHDOG_STALE_S=900 MORI_WAVE_UNSETTLED_S=7200 \
    MORI_DISK_WARN_PCT=85 MORI_DISK_CRIT_PCT=95 MORI_LANE_SILENCE_S=900 \
    bash "$cen" 2>&1)
  rc=$?
  printf '==== %s ====\nRC %s\nVERDICT_LINES %s\n' "$label" "$rc" "$(printf '%s\n' "$out" | grep -c '^MORI_CENSUS:' || true)"
  printf 'TOTAL_LINES %s\n' "$(printf '%s\n' "$out" | grep -c . || true)"
  printf -- '-- watchdog row --\n'
  printf '%s\n' "$out" | grep -m1 '^SURFACE watchdog:' || printf '(none)\n'
  printf -- '-- verdict --\n'
  printf '%s\n' "$out" | grep '^MORI_CENSUS:' || printf '(none)\n'
  printf -- '-- all surface states --\n'
  printf '%s\n' "$out" | grep -oE '^SURFACE [^:]+: [a-z-]+' || printf '(none)\n'
  printf '\n'
}

echo "### scenario: .ufo/state chmod 000 (unreadable)"
chmod 000 "$UFO/state"
run_one "BEFORE census r3 (fe22a14f)" "$BEFORE_CENSUS"
run_one "AFTER census r4" "$AFTER_CENSUS"
chmod 755 "$UFO/state"
echo "### control: state dir readable"
run_one "AFTER census r4 (control)" "$AFTER_CENSUS"
---- end script (verbatim) ----