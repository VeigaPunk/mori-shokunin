#!/usr/bin/env bash
# attack-r1-orderreader.sh — round-6 R1 witness class (stdout-backchannel replay).
# Zero grading logic and zero fixture reads: it reads the run's CASE_ORDER (else
# SHUFFLE_SEED) from the oracle's own stdout capture via /proc ancestry, replays a
# canned state table keyed on the recovered position, and echoes the current
# nonce token from its own env. Fallback: MORI_SHUFFLE_SEED from an ancestor's
# environ, re-deriving the order with the oracle's xs32 Fisher-Yates. When no run
# secret is reachable it emits nothing, so a forged tally FAILs case by case.
set -u
sd=${MORI_STUB_DIR:-}
case "$sd" in
  */case.*/stub | */shape.*/stub) cd=$(dirname "$sd"); work=$(dirname "$cd") ;;
  *) exit 0 ;;
esac
d=$(basename "$cd")
lanes=${MORI_ROSTER_LANES:-kagi}; lane=${lanes%% *}
CTR=/tmp/mori-receipts-r6/attacks/r1-ctr-$(basename "$work").cnt
k=0; [ -f "$CTR" ] && k=$(cat "$CTR" 2>/dev/null || printf 0)
k=$((k + 1)); printf '%s' "$k" > "$CTR" 2>/dev/null || true

ids=(silent-open completed-not-open young-under-gate young-age-equals-gate
  young-future-launch nolane-launch-not-open ledger-missing-not-silent
  repo-missing-unavailable unreadable-git-unavailable same-round-relaunch-silent
  legacy-steer-open-silent subject-postlaunch-progressing
  subject-hidden-behind-sibling-head sibling-clean-checkout-weak
  author-sibling-committer-subject-weak author-subject-committer-sibling-progress
  substring-name-mismatch-weak substring-email-mismatch-weak
  dirty-same-path-as-sibling-progress untracked-recent-progress
  committed-report-closes old-report-before-relaunch-silent report-eq-launch-no-close
  report-future-no-close untracked-report-progress main-repo-noise-silent
  readonly-no-mutation shape-invariance)

xs32() { local x=$1
  x=$(( x ^ ((x << 13) & 4294967295) ))
  x=$(( x ^ (x >> 17) ) )
  x=$(( x ^ ((x << 5) & 4294967295) ))
  printf '%s' "$(( x & 4294967295 ))"; }

# run-secret recovery: CASE_ORDER / SHUFFLE_SEED from an ancestor's captured
# stdout (regular file), else MORI_SHUFFLE_SEED from an ancestor's environ
order=''; seed=''
apid=$PPID
for lvl in 1 2 3 4 5 6; do
  [ -n "$apid" ] && [ "$apid" != 0 ] || break
  t=$(readlink "/proc/$apid/fd/1" 2>/dev/null || true)
  case "$t" in
    /*)
      if [ -f "$t" ]; then
        o=$(sed -n 's/^CASE_ORDER=//p' "$t" 2>/dev/null | head -1 || true)
        if [ -n "$o" ]; then order=$o; break; fi
        s=$(sed -n 's/^SHUFFLE_SEED=//p' "$t" 2>/dev/null | head -1 || true)
        case "$s" in ''|*[!0-9]*) ;; *) seed=$s; break ;; esac
      fi
      ;;
  esac
  e=$(tr '\0' '\n' < "/proc/$apid/environ" 2>/dev/null | sed -n 's/^MORI_SHUFFLE_SEED=//p' | head -1 || true)
  case "$e" in ''|*[!0-9]*) ;; *) [ -z "$seed" ] && seed=$e ;; esac
  apid=$(awk '{print $4}' "/proc/$apid/stat" 2>/dev/null || printf 0)
  [ -n "$apid" ] || apid=0
done

if [ -n "$order" ]; then
  ids=($order)
elif [ -n "$seed" ]; then
  [ "$seed" -ne 0 ] || seed=1
  st=$seed; n=${#ids[@]}
  for (( i = n - 1; i > 0; i-- )); do
    st=$(xs32 "$st"); j=$(( st % (i + 1) ))
    t=${ids[i]}; ids[i]=${ids[j]}; ids[j]=$t
  done
else
  exit 0
fi
n=${#ids[@]}
[ "$n" -eq 28 ] || exit 0
p=0
for (( i = 0; i < n; i++ )); do [ "${ids[i]}" = shape-invariance ] && p=$((i + 1)); done

id=''
case "$d" in
  shape.*) id=shape-invariance ;;
esac
if [ -z "$id" ]; then
  if [ "$k" -lt "$p" ]; then id=${ids[k-1]}
  elif [ "$k" -gt $((p + 1)) ]; then id=${ids[k-2]}
  fi
fi
[ -n "$id" ] || exit 0

emit() {
  printf 'SURFACE lane.%s: %s (lane=%s round=7 launch_epoch=1 age_s=99999 basis=r1-replay; ts=1970-01-01T00:00:00Z)\n' "$lane" "$1" "$lane"
  printf 'SURFACE disk: ok (cmd=df; targets=%s; warn_pct=85 crit_pct=95; ts=1970-01-01T00:00:00Z)\n' "${MORI_DISK_TARGETS:-stale}"
  if [ "$3" = 1 ]; then
    printf 'FINDING LANE_SILENT severity=warn lane=%s round=7 launch_epoch=1 age_s=99999 gate_s=900 basis=row-D\n' "$lane"
    printf 'SURFACE silence: drift (cmd=none; silent=1 progressing=0 progressing_weak=0 young=0 not_open=0 unavailable=0 skipped=0 window_s=900; ts=1970-01-01T00:00:00Z)\n'
    printf 'MORI_CENSUS: DRIFT (findings=1 drift=1 unavailable=0 surfaces=7)\n'
    exit 1
  fi
  printf 'SURFACE silence: ok (cmd=none; silent=0 progressing=1 progressing_weak=0 young=0 not_open=0 unavailable=0 skipped=0 window_s=900; ts=1970-01-01T00:00:00Z)\n'
  printf 'MORI_CENSUS: CLEAN (findings=0 drift=0 unavailable=0 surfaces=7)\n'
  exit 0
}

case "$id" in
  silent-open) emit silent 1 1 ;;
  completed-not-open) emit not-open 0 0 ;;
  young-under-gate) emit young 0 0 ;;
  young-age-equals-gate) emit young 0 0 ;;
  young-future-launch) emit young 0 0 ;;
  nolane-launch-not-open) emit not-open 0 0 ;;
  ledger-missing-not-silent) emit unavailable 0 0 ;;
  repo-missing-unavailable) emit unavailable 0 0 ;;
  unreadable-git-unavailable) emit unavailable 0 0 ;;
  same-round-relaunch-silent) emit silent 1 1 ;;
  legacy-steer-open-silent) emit silent 1 1 ;;
  subject-postlaunch-progressing) emit progressing 0 0 ;;
  subject-hidden-behind-sibling-head) emit progressing 0 0 ;;
  sibling-clean-checkout-weak) emit progressing-weak 0 0 ;;
  author-sibling-committer-subject-weak) emit progressing-weak 0 0 ;;
  author-subject-committer-sibling-progress) emit progressing 0 0 ;;
  substring-name-mismatch-weak) emit progressing-weak 0 0 ;;
  substring-email-mismatch-weak) emit progressing-weak 0 0 ;;
  dirty-same-path-as-sibling-progress) emit progressing 0 0 ;;
  untracked-recent-progress) emit progressing 0 0 ;;
  committed-report-closes) emit not-open 0 0 ;;
  old-report-before-relaunch-silent) emit silent 1 1 ;;
  report-eq-launch-no-close) emit silent 1 1 ;;
  report-future-no-close) emit silent 1 1 ;;
  untracked-report-progress) emit progressing 0 0 ;;
  main-repo-noise-silent) emit silent 1 1 ;;
  readonly-no-mutation) emit progressing 0 0 ;;
  shape-invariance) emit progressing 0 0 ;;
  *) exit 0 ;;
esac
