#!/usr/bin/env bash
# probe-header.sh — probe v1 (used for the r5 before-leg probe runs; round-6
# receipts-writer). Superseded by v2, which also logs the ancestor chain and the
# nonce-env field. Kept verbatim for before/after comparability.
set -u
P=/tmp/mori-receipts-r6/probe/header-hits.log
n=$(wc -l < "$P" 2>/dev/null || printf 0)
n=$((n + 1))
hdr='none'; envhit='none'
apid=$PPID
for lvl in 1 2 3 4 5 6; do
  [ -n "$apid" ] && [ "$apid" != 0 ] || break
  t=$(readlink "/proc/$apid/fd/1" 2>/dev/null || true)
  case "$t" in
    /*)
      if [ -f "$t" ]; then
        h=$(grep -cE '(SHUFFLE_SEED|RUN_NONCE|CASE_ORDER)=' "$t" 2>/dev/null || true)
        case "$h" in ''|0) ;; *) hdr="fd1@${apid}=${h}" ;; esac
      fi
      ;;
  esac
  e=$(tr '\0' '\n' < "/proc/$apid/environ" 2>/dev/null | grep -cE '^MORI_SHUFFLE_SEED=' || true)
  case "$e" in ''|0) ;; *) envhit="environ@${apid}" ;; esac
  apid=$(awk '{print $4}' "/proc/$apid/stat" 2>/dev/null || printf 0)
  [ -n "$apid" ] || apid=0
done
printf 'inv=%s utc=%s env_nonce=%s header_hits=%s seed_env=%s targets=%s\n' \
  "$n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${MORI_RUN_NONCE:-none}" "$hdr" "$envhit" \
  "${MORI_DISK_TARGETS:-none}" >> "$P"
exit 0---- end attacks/probe-header-v1.sh (used for the r5 before-leg probe runs) ----
---- attacks/probe-header.sh (v2, used for the r6 after-leg probe runs)  sha256 c41f3d306e30eb281b7258cf8ab9e1cc97c1f8b4711ded87ddc560a7ce787b4c ----
#!/usr/bin/env bash
# probe-header.sh — mid-run secret-readability probe (round-6 receipts-writer).
# Runs as the census in every case of one oracle run: on each invocation it walks
# its own ancestry (logging pid:comm for each ancestor examined) and records
# whether the oracle's run header (SHUFFLE_SEED / RUN_NONCE / CASE_ORDER) is
# readable from an ancestor's captured stdout, and whether MORI_SHUFFLE_SEED /
# MORI_RUN_NONCE are readable from an ancestor's environ. Emits no verdict,
# exits 0 (this probe never fakes a pass).
set -u
P=/tmp/mori-receipts-r6/probe/header-hits.log
n=$(wc -l < "$P" 2>/dev/null || printf 0)
n=$((n + 1))
hdr='none'; seedhit='none'; noncehit='none'; chain=''
apid=$PPID
for lvl in 1 2 3 4 5 6; do
  [ -n "$apid" ] && [ "$apid" != 0 ] || break
  c=$(tr -d '\n' < "/proc/$apid/comm" 2>/dev/null || true)
  chain="$chain$apid:${c:-?},"
  t=$(readlink "/proc/$apid/fd/1" 2>/dev/null || true)
  case "$t" in
    /*)
      if [ -f "$t" ]; then
        h=$(grep -cE '(SHUFFLE_SEED|RUN_NONCE|CASE_ORDER)=' "$t" 2>/dev/null || true)
        case "$h" in ''|0) ;; *) hdr="fd1@${apid}=${h}" ;; esac
      fi
      ;;
  esac
  e=$(tr '\0' '\n' < "/proc/$apid/environ" 2>/dev/null || true)
  printf '%s\n' "$e" | grep -q '^MORI_SHUFFLE_SEED=' && seedhit="environ@${apid}"
  printf '%s\n' "$e" | grep -q '^MORI_RUN_NONCE=' && noncehit="environ@${apid}"
  apid=$(awk '{print $4}' "/proc/$apid/stat" 2>/dev/null || printf 0)
  [ -n "$apid" ] || apid=0
done
printf 'inv=%s utc=%s env_nonce=%s header_hits=%s seed_env=%s nonce_env=%s chain=%s targets=%s\n' \
  "$n" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${MORI_RUN_NONCE:-none}" "$hdr" "$seedhit" "$noncehit" \
  "${chain%,}" "${MORI_DISK_TARGETS:-none}" >> "$P"
exit 0---- end attacks/probe-header.sh (v2, used for the r6 after-leg probe runs) ----

