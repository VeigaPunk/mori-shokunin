    {
      "id": "P01",
      "topic": "four normal low pressure files (cpu, memory, io, irq) parse clean; every avg10, avg60, avg300 and total is pairwise distinct so a field swap cannot survive, and no value reaches the local avg10 threshold",
      "args": [],
      "snapshots": [
        {
          "files": {
            "cpu": "some avg10=1.23 avg60=0.45 avg300=0.12 total=98765\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n",
            "memory": "some avg10=2.34 avg60=1.56 avg300=0.78 total=456789\nfull avg10=1.11 avg60=0.66 avg300=0.22 total=334455\n",
            "io": "some avg10=3.21 avg60=2.43 avg300=1.09 total=654321\nfull avg10=0.98 avg60=0.87 avg300=0.54 total=223344\n",
            "irq": "full avg10=0.31 avg60=0.29 avg300=0.27 total=111222\n"
          },
          "errors": {}
        }
      ],
      "expect": {
        "exit": 0,
        "verdict": "PRESSURE_OK",
        "resources": {
          "cpu": {
            "state": "ok",
            "full_system_undefined": true,
            "some": {"avg10": 1.23, "avg60": 0.45, "avg300": 0.12, "total": 98765},
            "full": {"avg10": 0.0, "avg60": 0.0, "avg300": 0.0, "total": 0}
          },
          "memory": {
            "state": "ok",
            "some": {"avg10": 2.34, "avg60": 1.56, "avg300": 0.78, "total": 456789},
            "full": {"avg10": 1.11, "avg60": 0.66, "avg300": 0.22, "total": 334455}
          },
          "io": {
            "state": "ok",
            "some": {"avg10": 3.21, "avg60": 2.43, "avg300": 1.09, "total": 654321},
            "full": {"avg10": 0.98, "avg60": 0.87, "avg300": 0.54, "total": 223344}
          },
          "irq": {
            "state": "ok",
            "full": {"avg10": 0.31, "avg60": 0.29, "avg300": 0.27, "total": 111222}
          }
        },
        "findings_include": []
      }
    },
