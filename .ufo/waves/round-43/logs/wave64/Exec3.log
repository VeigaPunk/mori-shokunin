  #!/usr/bin/env python3
  """Exec3 scratch attacks on frozen round-43 counter count-c1s.py."""
  import ast
  import hashlib
  import os
  import re
  import subprocess
  import sys

  SCRATCH = "/tmp/exec3-attack"
  C1S = os.path.join(SCRATCH, "count-c1s.py")
  LANE = "/home/vgpnk/Projects/shokunin/mori-shokunin"
  SELF_REL = ".ufo/waves/round-43/count-c1s.py"
  FROZEN_REL = ".ufo/waves/round-42/count-c1.py"
  V5_REL = ".ufo/waves/round-42/conform.py"

  fail = []


  def lane_show(path):
      p = subprocess.run(["git", "-C", LANE, "show", "HEAD:%s" % path],
                         capture_output=True)
      return p.stdout if p.returncode == 0 else None


  def make_repo(name, files, commit=True):
      path = os.path.join(SCRATCH, name)
      subprocess.run(["rm", "-rf", path])
      os.makedirs(path)

      def g(*a):
          r = subprocess.run(["git", "-C", path] + list(a), capture_output=True)
          assert r.returncode == 0, (a, r.stderr)

      g("init", "-q")
      g("config", "user.name", "exec3")
      g("config", "user.email", "exec3@scratch.invalid")
      for rel, data in files.items():
          full = os.path.join(path, rel)
          os.makedirs(os.path.dirname(full), exist_ok=True)
          with open(full, "wb") as fh:
              fh.write(data)
          g("add", rel)
      if commit:
          g("commit", "-q", "-m", "fixture")
      return path


  def run_c1s(argv):
      p = subprocess.run([sys.executable, C1S] + argv, capture_output=True,
                         text=True)
      return p.returncode, p.stdout, p.stderr


  def expect(name, ok, detail):
      print("%-26s %s  %s" % (name, "EXP-HIT" if ok else "no-hit", detail))
      if not ok:
          fail.append(name)


  src = open(C1S, "rb").read()
  frozen = lane_show(FROZEN_REL)

  # G1: `--repo` missing value -> usage contract (exit 2), not IndexError.
  rc, out, err = run_c1s(["HEAD", "--repo"])
  expect("G1 repo-missing-value", rc == 2,
         "rc=%d err=%r" % (rc, err.strip().splitlines()[-1] if err.strip() else ""))

  # G2: non-UTF-8 v5 at rev -> UnicodeDecodeError, no C1S= verdict line.
  frozen_sha = hashlib.sha256(frozen).hexdigest()
  pin = re.search(r'FROZEN_SHA = "([0-9a-f]{64})"', src.decode()).group(1)
  if frozen_sha == pin:
      g2 = make_repo("c1s-g2-bad-utf8-v5", {
          SELF_REL: src,
          FROZEN_REL: frozen,
          V5_REL: b"\xff\xfe\x00 not utf8",
      })
      rc, out, err = run_c1s(["HEAD", "--repo", g2])
      expect("G2 v5-decode-crash", rc == 1 and "UnicodeDecodeError" in err
             and "C1S=" not in out,
             "rc=%d unicode=%s c1sline=%s checks=%d"
             % (rc, "UnicodeDecodeError" in err, "C1S=" in out,
                len([l for l in out.splitlines() if l.startswith("check")])))
  else:
      print("G2 skipped: lane frozen bytes sha %s != pinned %s"
            % (frozen_sha[:12], pin[:12]))

  # G3: rev lacking the counter itself -> documented early stop.
  g3 = make_repo("c1s-g3-empty", {".gitkeep": b""})
  rc, out, err = run_c1s(["HEAD", "--repo", g3])
  expect("G3 self-absent-early-stop", rc == 1 and "C1S=unmet" in out
         and "FAIL self_at_rev" in out,
         "rc=%d lines=%d" % (rc, len(out.strip().splitlines())))

  print("ATTACK-C1S summary: %d/3 expectations hit" % (3 - len(fail)))
  sys.exit(0)
  ```

