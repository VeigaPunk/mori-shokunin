  ```python
  #!/usr/bin/env python3
  """Exec3 scratch attacks on frozen round-43 counter count-c2.py.

  Runs only against /tmp fixture repos; the lane repo is read via `git show`
  only. Frozen counter is a byte copy; never edited here.
  """
  import hashlib
  import os
  import re
  import subprocess
  import sys

  SCRATCH = "/tmp/exec3-attack"
  C2 = os.path.join(SCRATCH, "count-c2.py")
  LANE = "/home/vgpnk/Projects/shokunin/mori-shokunin"
  PDF_REL = "corpus/evidence/sources-r42/S235.pdf"

  fail = []


  def sh(data):
      return hashlib.sha256(data).hexdigest()


  def lane_show(path):
      p = subprocess.run(["git", "-C", LANE, "show", "HEAD:%s" % path],
                         capture_output=True)
      return p.stdout if p.returncode == 0 else None


  def make_repo(name, files):
      path = os.path.join(SCRATCH, name)
      subprocess.run(["rm", "-rf", path])
      os.makedirs(path)

      def g(*a):
          r = subprocess.run(["git", "-C", path] + list(a),
                             capture_output=True)
          assert r.returncode == 0, (a, r.stderr)

      g("init", "-q")
      g("config", "user.name", "exec3")
      g("config", "user.email", "exec3@scratch.invalid")
      for rel, data in files.items():
          full = os.path.join(path, rel)
          os.makedirs(os.path.dirname(full), exist_ok=True)
          with open(full, "wb") as fh:
              fh.write(data if isinstance(data, bytes) else data.encode())
          g("add", rel)
      g("commit", "-q", "-m", "fixture")
      return path


  def run_counter(argv):
      p = subprocess.run([sys.executable, C2] + argv, capture_output=True,
                         text=True)
      return p.returncode, p.stdout, p.stderr


  def expect(name, ok, detail):
      print("%-28s %s  %s" % (name, "EXP-HIT" if ok else "no-hit", detail))
      if not ok:
          fail.append(name)


  counter_src = open(C2).read()
  S235_SHA = re.search(r'S235_SHA = "([0-9a-f]{64})"', counter_src).group(1)

  sources = lane_show("corpus/SOURCES.md")
  scorecard = lane_show("SCORECARD.md")
  pdf = lane_show(PDF_REL)
  assert sources and scorecard and pdf
  s235_line = next(l for l in sources.decode().splitlines()
                   if sh(l.encode()) == S235_SHA)

  corr_line = ("| S900 | https://example.invalid/z | docs | A | scope z | "
               "anchor z | corrects S235 (pdf %s) | open | 2026-10-24 | "
               "on-release | c2 |" % sh(pdf))

  # F1 forged-met: no registry header anywhere; both rows live in a fence.
  f1 = make_repo("c2-f1-forged-met", {
      "corpus/SOURCES.md":
          "# forged fixture: no registry\n\n```markdown\n"
          + s235_line + "\n" + corr_line + "\n```\n",
      "SCORECARD.md":
          "# forged scorecard\n\nprose note: declared %s; correction: %s\n"
          % ("`C1=met` exit 0 (`evidence/c1-after.txt`)",
             "Round-43 calibration correction: r42-declaration-C1=met superseded; "
             "frozen counter printed no C1= line"),
      PDF_REL: pdf,
  })
  rc, out, err = run_counter(["HEAD", "--repo", f1])
  expect("F1 forged-met", rc == 0 and "C2=met mismatches=0" in out,
         "rc=%d tail=%r" % (rc, out.strip().splitlines()[-1] if out.strip() else err[-160:]))

  # F2 false unmet: real content + one doc example quoting the S235 line.
  f2 = make_repo("c2-f2-prose-unmet", {
      "corpus/SOURCES.md":
          sources.decode() + "\nDocs example (fence):\n\n```markdown\n"
          + s235_line + "\n```\n",
      "SCORECARD.md": scorecard,
      PDF_REL: pdf,
  })
  rc, out, err = run_counter(["HEAD", "--repo", f2])
  expect("F2 prose-false-unmet", rc == 1 and "C2=unmet mismatches=1" in out
         and "FAIL s235_unrewritten" in out,
         "rc=%d s235_line=%r" % (rc, "FAIL s235_unrewritten" in out))

  # F3 usage contract: `--repo` with no value must be usage exit 2, not IndexError.
  rc, out, err = run_counter(["HEAD", "--repo"])
  expect("F3 repo-missing-value", rc == 2,
         "rc=%d err=%r" % (rc, err.strip().splitlines()[-1] if err.strip() else ""))

  # F4 non-UTF-8 SOURCES.md: crash instead of a verdict line.
  f4 = make_repo("c2-f4-bad-utf8", {
      "corpus/SOURCES.md": sources + b"\n\xff\xfe corrupt\n",
      "SCORECARD.md": scorecard,
      PDF_REL: pdf,
  })
  rc, out, err = run_counter(["HEAD", "--repo", f4])
  expect("F4 bad-utf8-crash", rc == 1 and "UnicodeDecodeError" in err
         and "C2=" not in out,
         "rc=%d unicode=%s c2line=%s" % (rc, "UnicodeDecodeError" in err,
                                         "C2=" in out))

  print("ATTACK-C2 done hits=%d miss=%d" % (
      4 - len(fail) if not fail else 4 - len(fail), len(fail)))
  sys.exit(0)
  ```

