  #!/usr/bin/env python3
  """Exec3 micro-attack on frozen round-42 count-c1.py (scratch copy)."""
  import ast
  import importlib.util
  import os
  import subprocess
  import sys

  SCRATCH = "/tmp/exec3-attack/c1run"
  C1 = os.path.join(SCRATCH, "count-c1.py")
  LANE = "/home/vgpnk/Projects/shokunin/mori-shokunin"

  src = open(C1, "rb").read()

  # 1. AST: the frozen run() signature.
  tree = ast.parse(src.decode())
  sigs = [ [a.arg for a in n.args.args] for n in ast.walk(tree)
           if isinstance(n, ast.FunctionDef) and n.name == "run" ]
  print("run signatures at module top level: %s" % sigs)

  # 2. call sites passing cwd=
  lines = src.decode().splitlines()
  cwd_calls = [(i + 1, l.strip()) for i, l in enumerate(lines) if "cwd=" in l]
  for no, l in cwd_calls:
      print("cwd= at line %d: %s" % (no, l))

  # 3. dynamic: the exact call the frozen counter makes at its section 7.
  spec = importlib.util.spec_from_file_location("frozen_c1", C1)
  mod = importlib.util.module_from_spec(spec)
  spec.loader.exec_module(mod)
  try:
      mod.run(["/bin/true"], cwd="/tmp")
      print("dynamic: run(argv, cwd=...) ACCEPTED (unexpected)")
  except TypeError as exc:
      print("dynamic: TypeError: %s" % exc)

  # 4. usage contract: `--repo` with no value.
  p = subprocess.run([sys.executable, C1, "HEAD", "--repo"],
                     capture_output=True, text=True)
  last = p.stderr.strip().splitlines()[-1] if p.stderr.strip() else ""
  print("argv-repo-missing-value: rc=%d last_err=%r" % (p.returncode, last))
  ```

