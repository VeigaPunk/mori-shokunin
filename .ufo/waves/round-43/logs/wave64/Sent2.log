  }
  hits = []
  def classify(text):
      out = []
      for name, p in pats.items():
          for m in re.finditer(p, text):
              s = max(0, m.start()-40); e = min(len(text), m.end()+40)
              out.append((name, text[s:e].replace('\n',' ')))
