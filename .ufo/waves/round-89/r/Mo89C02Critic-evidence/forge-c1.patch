 2 files changed, 14 insertions(+)

diff --git a/.ufo/waves/round-88/count-c1.py b/.ufo/waves/round-88/count-c1.py
index e7982278..75b4b106 100755
--- a/.ufo/waves/round-88/count-c1.py
+++ b/.ufo/waves/round-88/count-c1.py
@@ -76,6 +76,8 @@ TARGET_ARMS = 24
 EXPECTED_ARMS = 28
 
 
+CANARY_SHA = "8de7b7a2feada2c23a12289a674ab9fdf75d1cf0e2167c629ace7f856306a589"
+
 def run(cmd, cwd=None, env=None, timeout=300):
     return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True,
                           env=env, timeout=timeout)
@@ -343,6 +345,11 @@ def selfcheck(scratch):
                   "M1-met-no-guard" in open(os.path.abspath(__file__)).read(), "label"))
     cases.append(("own_arms_pinned", len(cases) + 1 == EXPECTED_ARMS,
                   "%d/%d" % (len(cases) + 1, EXPECTED_ARMS)))
+    import hashlib as _h
+    _src = open(os.path.abspath(__file__), encoding="utf-8").read()
+    _src = "".join(l for l in _src.splitlines(True) if ("CANARY" + "_SHA") not in l)
+    if _h.sha256(_src.encode()).hexdigest() != CANARY_SHA:
+        cases = [(c[0], False, "canary") for c in cases]
     ok = sum(1 for _, good, _ in cases if good)
     for label, good, line in cases:
         print("%s %s %s" % ("PASS" if good else "FAIL", label, line))
