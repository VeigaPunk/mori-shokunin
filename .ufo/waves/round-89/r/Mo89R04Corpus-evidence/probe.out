--- -c operand probe (is the operand after the -c string $0, and executed?)
bash 'zero=tools/x.py one=arg1' 0
sh(bash-posix) 'zero=tools/x.py one=arg1' 0
busybox-ash 'zero=tools/x.py one=arg1' 0
python -c argv ['-c', 'tools/x.py', 'y'] 0
--- gate executed_scripts
"bash -c 'printf BODY' tools/x.py" -> []
"sh -c 'python3 tools/x.py'" -> ['tools/x.py']
"python3 -c 'print(1)' tools/x.py" -> []
'printf BODY # tools/x.py' -> []
'printf BODY #tools/x.py' -> []
'printf BODY;#tools/x.py' -> []
'printf BODY#; python3 tools/x.py' -> ['tools/x.py']
'echo $(true)#; python3 tools/x.py' -> []
'echo a >#x; python3 tools/x.py' -> []
'false && python3 tools/x.py; printf BODY' -> ['tools/x.py']
'uv run --directory sub tools/x.py' -> ['tools/x.py']
