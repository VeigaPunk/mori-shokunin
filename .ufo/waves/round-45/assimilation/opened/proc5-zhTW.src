<div class="Bd-indent">
<dl class="Bl-tag">
  <dt id="scsi~2"><a class="permalink" href="#scsi~2"><i>scsi</i></a></dt>
  <dd>&#x8A72;&#x6A94;&#x6848;&#x5217;&#x51FA;&#x4E86;&#x6838;&#x5FC3;&#x638C;&#x63E1;&#x7684;&#x6240;&#x6709;
      SCSI &#x88DD;&#x7F6E;, &#x5176;&#x5167;&#x5BB9;&#x5C31;
      &#x548C;&#x7CFB;&#x7D71;&#x555F;&#x52D5;&#x6642;&#x6240;&#x770B;&#x5230;&#x7684;&#x985E;&#x4F3C;.
      &#x76EE;&#x524D; scsi &#x53EA;&#x652F;&#x63F4;
      <i>singledevice</i>&#x547D;&#x4EE4;,
      &#x8A72;&#x547D;&#x4EE4;&#x5141;&#x8A31; root
      &#x65B0;&#x589E;&#x4E00;&#x500B;&#x71B1;&#x63D2;
      &#x62D4;(hotplugged)&#x88DD;&#x7F6E;&#x5230;&#x4E00;&#x500B;&#x5DF2;&#x77E5;&#x88DD;&#x7F6E;&#x5217;&#x8868;&#x4E2D;.
    <p class="Pp">&#x547D;&#x4EE4; <b>echo 'scsi singledevice 1 0 5 0' &amp;gt;
        /proc/scsi/scsi</b> &#x4EE4; host scsi1 &#x6383;&#x63CF; SCSI
        &#x901A;&#x9053; 0, &#x770B;&#x5728; ID 5 LUN 0
        &#x662F;&#x5426;&#x5B58;&#x5728;&#x88DD;&#x7F6E;,
        &#x5982;&#x679C;&#x5728;&#x8A72;&#x5730;&#x5740;
